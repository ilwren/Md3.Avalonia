<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.TimelineGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Timeline" />
        <TextBlock x:Name="TimelineDescription" Classes="body" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock x:Name="VerticalTitle" Classes="h2" />
        <eco:MdTimeline x:Name="VerticalTimeline" MinWidth="300" HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Horizontal" />
        <TextBlock x:Name="HorizontalDescription" Classes="body" TextWrapping="Wrap" />
        <md:MdScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <eco:MdTimeline x:Name="HorizontalTimeline" Orientation="Horizontal" HorizontalAlignment="Left" />
        </md:MdScrollViewer>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdTimeline Orientation=&quot;Horizontal&quot; /&gt;"
                             CSharpCode="timeline.ItemsSource = new[]&#10;{&#10;    new MdTimelineItem(&quot;Created&quot;, &quot;Draft created&quot;, timestamp, MdTimelineItemState.Completed),&#10;    // Active + Auto displays the progress ring. Use None to opt out.&#10;    new MdTimelineItem(&quot;Review&quot;, &quot;Running checks&quot;, timestamp, MdTimelineItemState.Active),&#10;    new MdTimelineItem(&quot;Publish&quot;, &quot;Waiting&quot;, null, MdTimelineItemState.Neutral)&#10;};" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
