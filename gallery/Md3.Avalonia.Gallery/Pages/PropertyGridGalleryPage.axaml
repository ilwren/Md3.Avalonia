<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:pg="using:Avalonia.PropertyGrid.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             xmlns:themes="using:Md3.Avalonia.Themes"
             x:Class="Md3.Avalonia.Gallery.Pages.PropertyGridGalleryPage">
  <!-- The theme is loaded inside this page only. Every control theme it carries is handed to a
       control by a style that requires a PropertyGrid ancestor, so nothing outside this page - and
       nothing inside it that is not inside a grid - is affected. -->
  <UserControl.Styles>
    <themes:MaterialPropertyGridTheme />
  </UserControl.Styles>
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Property grid" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A property grid wearing the opt-in Md3.Avalonia.PropertyGrid theme. The grid sets no colours of its own, so the theme hands each native control it hosts a Material control theme - fields, checkboxes, combo boxes, date and time pickers, expanders, menus and tooltips - without replacing any native control theme elsewhere in the application." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Themed grid" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Filter with the field at the top, narrow to a category with the chips below it, and open the options menu from the button beside the field. Categories are Material expanders, the name/value divider is an OutlineVariant rule that turns Primary while it is dragged, and the list scrolls on the core Material scrollbar." />
        <Border CornerRadius="12" Padding="4"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
          <Border CornerRadius="8" Padding="8" ClipToBounds="True"
                  Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
            <pg:PropertyGrid x:Name="DemoGrid" Height="560"
                             IsCategoryVisible="True"
                             AllCategoriesExpanded="True" />
          </Border>
        </Border>
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Every cell editor is a plain Avalonia control the grid built itself: string and numeric cells are Material filled fields, booleans Material checkboxes, enums Material combo boxes, collections Material list editors, and the date and time cells open the control's own wheel flyout inside a Material surface card." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="How it stays local" />
        <gallery:ApiNotes Control="MaterialPropertyGridTheme"
                        Members="Styles include, Md.Comp.PropertyGrid.*, Md.Sys.Color.*, Md.Sys.TypeScale">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="The theme reaches the cells the way it reaches the chrome: one style per native type, each selector requiring a PropertyGrid ancestor, each handing that type one of the Md.Comp.PropertyGrid.* control themes. That is what keeps the package opt-in - a TextBox anywhere else still has no control theme of its own, and the grid needs no FluentTheme. Two hairlines stay upstream's (the 0.5 DIP Gray border its templates draw, and the one its expandable-object factory sets from C#): both are local values no style can reach, and colour cells keep Avalonia's own ColorPicker." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;themes:MaterialTheme /&gt;&#10;&lt;themes:MaterialPropertyGridTheme /&gt;   &lt;!-- opt-in package, after MaterialTheme --&gt;&#10;&#10;&lt;pg:PropertyGrid DataContext=&quot;{Binding Options}&quot;&#10;                IsCategoryVisible=&quot;True&quot;&#10;                AllCategoriesExpanded=&quot;True&quot; /&gt;"
                            CSharpCode="var grid = new PropertyGrid&#10;{&#10;    DataContext = options,          // the grid reads the object it is given&#10;    IsCategoryVisible = true,&#10;    AllCategoriesExpanded = true&#10;};&#10;&#10;// The theme is a style collection: register it once next to MaterialTheme,&#10;// or in the Styles of the window that owns the grid. It styles native&#10;// controls only inside a PropertyGrid, so nothing else in the app changes." />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
