<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Md3.Avalonia.Themes</RootNamespace>
    <AssemblyName>Md3.Avalonia.Mapsui</AssemblyName>
    <Description>Material Design 3 appearance (canvas, layer palette, vector and label styles, type scale) for Mapsui maps in Avalonia. Opt-in package: it carries the Mapsui Avalonia dependency so the core Material packages do not have to.</Description>
    <PackageId>Md3.Avalonia.Mapsui</PackageId>
    <Version>0.5.6-preview.1</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;maps;mapsui;gis;cartography;theme;material-design-3</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- The Avalonia control and the drawing model. Mapsui has no style collection to register in
         either, and MapControl draws its own surface from the map's own colours, so this package is
         an entry point that styles a Map (or the MapControl that draws it) rather than a Styles
         subclass. See README.md. -->
    <PackageReference Include="Mapsui.Avalonia12" />
    <ProjectReference Include="../Md3.Avalonia/Md3.Avalonia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../assets/logo-128.png" Pack="true" PackagePath="/" Link="logo-128.png" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
