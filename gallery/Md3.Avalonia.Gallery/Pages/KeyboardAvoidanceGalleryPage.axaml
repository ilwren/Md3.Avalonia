<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.KeyboardAvoidanceGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Soft keyboard avoidance" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="The host pads its viewport by the virtual keyboard inset and scrolls the focused text control into the space that is left." />
      </StackPanel>

      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="12">
        <TextBlock Classes="body" Text="Simulate a virtual keyboard inset to verify that the host automatically adjusts viewport bottom padding and scrolls focused text controls into view." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <md:MdButton Content="Toggle virtual keyboard" Variant="Outlined" Click="ToggleVirtualKeyboard" />
          <md:MdButton Content="Focus bottom input" Variant="Text" Click="FocusBottomInput" />
        </StackPanel>
        <Border Height="260" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" CornerRadius="16" ClipToBounds="True">
          <md:MdKeyboardAvoidingHost x:Name="DemoKeyboardHost" AutoScrollToFocused="True" ExtraBottomOffset="16">
            <md:MdScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16" Spacing="12">
                <TextBlock FontWeight="Medium" Text="Scrollable form area" />
                <md:MdTextBox Label="Top input" Text="First item" />
                <Border Height="80" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" CornerRadius="12" />
                <md:MdTextBox x:Name="BottomInput" Label="Bottom input" Text="Second item" />
                <Border Height="120" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" CornerRadius="12" />
              </StackPanel>
            </md:MdScrollViewer>
          </md:MdKeyboardAvoidingHost>
        </Border>
        <TextBlock x:Name="KeyboardStatus" Classes="body" Text="Virtual keyboard inactive (height: 0dp)." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdKeyboardAvoidingHost AutoScrollToFocused=&quot;True&quot; ExtraBottomOffset=&quot;16&quot;&gt;&#10;  &lt;md:MdScrollViewer&gt;&#10;    &lt;StackPanel&gt;...&lt;/StackPanel&gt;&#10;  &lt;/md:MdScrollViewer&gt;&#10;&lt;/md:MdKeyboardAvoidingHost&gt;"
                            CSharpCode="DemoKeyboardHost.KeyboardHeight = 150;   // normally driven by the platform inset" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
