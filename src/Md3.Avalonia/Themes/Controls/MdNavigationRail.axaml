<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdNavigationRailItem}" TargetType="md:MdNavigationRailItem">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdNavigationRailItem">
        <Border x:Name="PART_Root" Margin="4" Background="Transparent" CornerRadius="16" ClipToBounds="True">
          <StackPanel x:Name="PART_ItemLayout" Margin="8,6" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
            <Grid Width="56" Height="32" ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="Transparent" CornerRadius="16"
                      Opacity="0" RenderTransform="scale(0.6)" RenderTransformOrigin="50%,50%" />
              <!-- The hover/press layer is intentionally constrained to the M3 pill rather than
                   painting a circular/rectangular overlay across the whole destination. -->
              <Border x:Name="PART_State" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                      CornerRadius="16" IsHitTestVisible="False" Opacity="0" />
              <md:MdRipplePresenter RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsCentered="True" />
              <md:MdSymbolPresenter x:Name="PART_Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                FontSize="24" Foreground="{TemplateBinding Foreground}" />
              <md:MdSymbolPresenter x:Name="PART_SelectedIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectedIcon}"
                                FontSize="24" Foreground="{TemplateBinding Foreground}" IsVisible="False" Opacity="0" />
              <ContentPresenter x:Name="PART_Badge" Margin="30,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Content="{TemplateBinding Badge}" IsVisible="False" />
            </Grid>
            <ContentPresenter x:Name="PART_Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Label}" FontSize="12" Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:has-selected-icon /template/ md|MdSymbolPresenter#PART_SelectedIcon"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ md|MdSymbolPresenter#PART_Icon"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ md|MdSymbolPresenter#PART_SelectedIcon"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Indicator"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:has-badge /template/ ContentPresenter#PART_Badge"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_State"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:expanded"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="^:expanded /template/ StackPanel#PART_ItemLayout"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Spacing" Value="12" /><Setter Property="Margin" Value="8,6,16,6" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdNavigationRail}" TargetType="md:MdNavigationRail">
    <Setter Property="Width" Value="96" />
    <Setter Property="Padding" Value="12,20" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdNavigationRail">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <Grid RowDefinitions="Auto,*,Auto">
            <ContentPresenter Content="{TemplateBinding Header}" />
            <ItemsPresenter Grid.Row="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
            <ContentPresenter Grid.Row="2" Content="{TemplateBinding Footer}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:expanded"><Setter Property="Width" Value="220" /></Style>
  </ControlTheme>
</ResourceDictionary>
