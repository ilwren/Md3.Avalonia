<!--
  Material Design 3 chrome for AvaloniaEdit.

  Derived from Avalonia.AvaloniaEdit 12.0.0 Themes/Base.xaml, Themes/Fluent/AvaloniaEdit.xaml and
  the search/completion dictionaries of the same package (MIT, see THIRD-PARTY-NOTICES.md). The
  templates, the bindings and every PART_ name AvaloniaEdit looks up by name
  (PART_ScrollViewer, PART_searchTextBox, PART_replaceTextBox, PART_MessageView, PART_MessageContent,
  PART_Border, PART_CP, PART_Watermark, PART_ListBox, PART_UP, PART_DOWN, PART_ContentPresenter) are
  kept as upstream wrote them; a hand-written template would drift from the parts the control finds.

  What changed:
    * Fluent resources and the System* colour keys became M3 tokens.
    * The editor and completion scrollers are MdScrollViewer, so the app needs no native
      ScrollBar/ScrollViewer theme (the core package deliberately does not install one).
    * The inner controls AvaloniaEdit creates itself - the compact search fields, the search
      action buttons, the search option toggles, the expander and the completion list - are
      styled by the keyed Md.Comp.AvaloniaEdit.* control themes below. Those keys are referenced
      only from the templates in this file, so registering this theme never replaces Avalonia's
      native Button/ToggleButton/TextBox/ListBox themes for the rest of the application.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:Md3.Avalonia.Controls"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:editing="using:AvaloniaEdit.Editing"
        xmlns:search="using:AvaloniaEdit.Search"
        xmlns:cc="using:AvaloniaEdit.CodeCompletion"
        x:Class="Md3.Avalonia.Themes.MaterialAvaloniaEditTheme">

  <!-- TextView only ever appears inside an AvaloniaEdit editor, so a selector for it stays local
       to the editor even though it lives at styles scope. -->
  <Style Selector="editing|TextView">
    <Setter Property="LinkTextForegroundBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
  </Style>

  <Styles.Resources>
    <ResourceDictionary>

      <!-- =====================================================================================
           Search panel icon geometry (from AvaloniaEdit SearchPanel.xaml).
           ===================================================================================== -->
