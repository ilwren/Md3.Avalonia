<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:pages="using:Md3.Avalonia.Gallery.Pages"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.BannerGalleryPage">
  <md:MdBannerHost x:Name="ServiceBannerHost">
    <md:MdBannerHost.DataTemplates>
      <!-- The View owns the visual. The ViewModel supplies only SyncBannerModel. -->
      <DataTemplate DataType="{x:Type pages:SyncBannerModel}" x:DataType="pages:SyncBannerModel">
        <md:MdBanner IsDismissible="True">
          <md:MdBanner.LeadingContent>
            <md:MdIcon Glyph="{x:Static md:MdSymbols.SyncProblem}" Size="28" />
          </md:MdBanner.LeadingContent>
          <md:MdBanner.Actions>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <md:MdButton Content="Keep offline" Variant="Text" Command="{Binding KeepOfflineCommand}" />
              <md:MdButton Content="Retry" Variant="Text" Command="{Binding RetryCommand}" />
            </StackPanel>
          </md:MdBanner.Actions>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </md:MdBanner>
      </DataTemplate>
    </md:MdBannerHost.DataTemplates>

    <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="28" Margin="0,0,12,24">
        <StackPanel Spacing="8">
          <TextBlock Classes="h1" Text="Banner" />
          <TextBlock Classes="body" TextWrapping="Wrap" Text="A Material banner carries a persistent message with up to two actions. It stays until an action is taken rather than timing out like a snackbar." />
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Direct control" />
          <TextBlock Classes="body" TextWrapping="Wrap" Text="Use Show and Dismiss when the view already owns the banner control." />
          <md:MdButton Width="140" HorizontalAlignment="Left" Content="Show banner" Variant="Outlined" Click="ShowBanner" />
          <md:MdBanner x:Name="DemoBanner" IsDismissible="True" Dismissed="BannerDismissed">
            <md:MdBanner.LeadingContent><md:MdIcon Glyph="{x:Static md:MdSymbols.Warning}" Size="28" /></md:MdBanner.LeadingContent>
            <md:MdBanner.Actions>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <md:MdButton Content="Learn more" Variant="Text" Click="BannerAction" />
                <md:MdButton Content="Retry" Variant="Text" Click="BannerAction" />
              </StackPanel>
            </md:MdBanner.Actions>
            <TextBlock TextWrapping="Wrap" Text="Your changes could not be synchronized. The banner remains visible until an action is taken." />
          </md:MdBanner>
          <TextBlock x:Name="BannerStatus" Classes="body" Text="Banner ready." />
        </StackPanel>

        <StackPanel x:Name="ServiceDemoRoot" x:DataType="pages:BannerServiceDemoViewModel" Spacing="12">
          <TextBlock Classes="h2" Text="Dependency injection + MVVM" />
          <TextBlock Classes="body" TextWrapping="Wrap" Text="The View declares a model-specific DataTemplate. The ViewModel receives only IMdBannerService and never references this host or an MdBanner control." />
          <md:MdButton Width="188" HorizontalAlignment="Left" Content="Show from ViewModel" Variant="Filled" Command="{Binding ShowBannerCommand}" />
          <TextBlock Classes="body" Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Usage" />
          <gallery:CodeExample XamlCode="&lt;md:MdBannerHost Service=&quot;{Binding BannerService}&quot;&gt;&#10;  &lt;md:MdBannerHost.DataTemplates&gt;&#10;    &lt;DataTemplate DataType=&quot;{x:Type vm:SyncBannerModel}&quot;&gt;&#10;      &lt;md:MdBanner IsDismissible=&quot;True&quot;&gt;&#10;        &lt;TextBlock Text=&quot;{Binding Message}&quot; /&gt;&#10;      &lt;/md:MdBanner&gt;&#10;    &lt;/DataTemplate&gt;&#10;  &lt;/md:MdBannerHost.DataTemplates&gt;&#10;  &lt;views:PageContent /&gt;&#10;&lt;/md:MdBannerHost&gt;"
                               CSharpCode="public sealed class PageViewModel(IMdBannerService banners)&#10;{&#10;    public async Task SyncAsync()&#10;    {&#10;        var result = await banners.ShowAsync&lt;string&gt;(&#10;            new SyncBannerModel(&quot;Could not synchronize.&quot;));&#10;    }&#10;}" />
        </StackPanel>
      </StackPanel>
    </md:MdScrollViewer>
  </md:MdBannerHost>
</UserControl>
