<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="using:Md3.Avalonia.Controls" xmlns:gallery="using:Md3.Avalonia.Gallery.Components" x:Class="Md3.Avalonia.Gallery.Pages.AdvancedSelectionGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MinHeight="1100" Spacing="32">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Segmented &amp; range" /><TextBlock Classes="body" Text="Complete selection patterns with single or multiple segments, two-handle ranges, and localized date ranges." /></StackPanel>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="Single selection" /><md:MdSegmentedButtonGroup Width="480" HorizontalAlignment="Left" SelectedIndex="0"><md:MdSegmentedButton Content="Day" Value="day" /><md:MdSegmentedButton Content="Week" Value="week" /><md:MdSegmentedButton Content="Month" Value="month" /></md:MdSegmentedButtonGroup></StackPanel>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="Multiple selection" /><md:MdSegmentedButtonGroup Width="560" HorizontalAlignment="Left" AllowMultiple="True"><md:MdSegmentedButton Content="Bold"><md:MdSegmentedButton.Icon><TextBlock FontWeight="Bold" Text="B" /></md:MdSegmentedButton.Icon></md:MdSegmentedButton><md:MdSegmentedButton Content="Italic"><md:MdSegmentedButton.Icon><TextBlock FontStyle="Italic" Text="I" /></md:MdSegmentedButton.Icon></md:MdSegmentedButton><md:MdSegmentedButton Content="Underline"><md:MdSegmentedButton.Icon><TextBlock TextDecorations="Underline" Text="U" /></md:MdSegmentedButton.Icon></md:MdSegmentedButton></md:MdSegmentedButtonGroup></StackPanel>
      <StackPanel Width="720" HorizontalAlignment="Left" Spacing="12"><TextBlock Classes="h2" Text="Range slider" /><TextBlock x:Name="RangeValueText" Classes="body" Text="20 — 80" /><md:MdRangeSlider LowerValue="20" UpperValue="80" Step="5" ShowValueIndicators="True" PropertyChanged="RangePropertyChanged" /></StackPanel>
      <StackPanel Width="720" HorizontalAlignment="Left" Spacing="12"><TextBlock Classes="h2" Text="Date range picker" /><md:MdDateRangePicker StartLabel="Start date" EndLabel="End date" /></StackPanel>
      <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage" /><gallery:CodeExample XamlCode="&lt;md:MdSegmentedButtonGroup SelectedItem=&quot;{Binding Period}&quot;&gt;&#10;  &lt;md:MdSegmentedButton Content=&quot;Day&quot; Value=&quot;day&quot; /&gt;&#10;  &lt;md:MdSegmentedButton Content=&quot;Week&quot; Value=&quot;week&quot; /&gt;&#10;&lt;/md:MdSegmentedButtonGroup&gt;&#10;&#10;&lt;md:MdRangeSlider LowerValue=&quot;{Binding Min}&quot; UpperValue=&quot;{Binding Max}&quot; /&gt;&#10;&lt;md:MdDateRangePicker StartDate=&quot;{Binding Start}&quot; EndDate=&quot;{Binding End}&quot; /&gt;" CSharpCode="var range = new MdRangeSlider { LowerValue = 20, UpperValue = 80 };&#10;var dates = new MdDateRangePicker { StartDate = DateTimeOffset.Now, EndDate = DateTimeOffset.Now.AddDays(7) };" /></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
