<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.IconButtonGalleryPage">
  <md:MdScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="26" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Icon buttons" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Standard, filled, tonal, and outlined variants across five expressive sizes." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Default icon buttons" />
        <WrapPanel Orientation="Horizontal">
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Star}" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Filled" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Edit}" Variant="Tonal" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.MoreVert}" Variant="Outlined" Margin="0,0,12,12"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Toggle icon buttons" />
        <WrapPanel Orientation="Horizontal">
          <md:MdToggleIconButton Icon="{x:Static md:MdSymbols.Favorite}" SelectedIcon="{x:Static md:MdSymbols.Check}" Margin="0,0,12,12"/>
          <md:MdToggleIconButton Icon="{x:Static md:MdSymbols.Notifications}" SelectedIcon="{x:Static md:MdSymbols.Check}" Variant="Filled" IsChecked="True" Margin="0,0,12,12"/>
          <md:MdToggleIconButton Icon="{x:Static md:MdSymbols.Star}" SelectedIcon="{x:Static md:MdSymbols.Check}" Variant="Tonal" Margin="0,0,12,12"/>
          <md:MdToggleIconButton Icon="{x:Static md:MdSymbols.Info}" SelectedIcon="{x:Static md:MdSymbols.Check}" Variant="Outlined" IsChecked="True" Margin="0,0,12,12"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Width and shape" />
        <WrapPanel Orientation="Horizontal">
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Remove}" Variant="Filled" WidthMode="Narrow" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Menu}" Variant="Filled" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Filled" WidthMode="Wide" Margin="0,0,12,12"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Settings}" Variant="Tonal" Shape="Square" Margin="0,0,12,12"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Expressive sizes" />
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Tonal" Size="ExtraSmall" Margin="0,0,10,10"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Tonal" Size="Small" Margin="0,0,10,10"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Tonal" Size="Medium" Margin="0,0,10,10"/>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Add}" Variant="Tonal" Size="Large" Margin="0,0,10,10"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdIconButton Icon=&quot;{x:Static md:MdSymbols.Edit}&quot;&#10;                 Variant=&quot;Filled&quot;&#10;                 Command=&quot;{Binding EditCommand}&quot; /&gt;" CSharpCode="var button = new MdIconButton&#10;{&#10;    Icon = MdSymbols.Edit,&#10;    Variant = MdIconButtonVariant.Filled&#10;};" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
