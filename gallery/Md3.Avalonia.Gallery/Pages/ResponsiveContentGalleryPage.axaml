<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.ResponsiveContentGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Responsive content" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="MdAdaptiveLayout picks compact, medium, or expanded content from its own measured width, not from the window. Resize the gallery to cross the breakpoints below." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="body" Text="Resize the Gallery. The control chooses compact, medium, or expanded content from its own width." />
        <md:MdAdaptiveLayout Height="150" MediumBreakpoint="560" ExpandedBreakpoint="760">
          <md:MdAdaptiveLayout.CompactContent><md:MdSurface Padding="24" Variant="Container"><md:MdText StyleRole="TitleLarge" Text="Compact layout" /></md:MdSurface></md:MdAdaptiveLayout.CompactContent>
          <md:MdAdaptiveLayout.MediumContent><md:MdSurface Padding="24" Variant="ContainerLow"><md:MdText StyleRole="HeadlineSmall" Text="Medium layout · two-pane ready" /></md:MdSurface></md:MdAdaptiveLayout.MediumContent>
          <md:MdAdaptiveLayout.ExpandedContent><md:MdSurface Padding="24" Variant="ContainerHigh"><md:MdText StyleRole="HeadlineMedium" Text="Expanded layout · navigation + body + supporting pane" /></md:MdSurface></md:MdAdaptiveLayout.ExpandedContent>
        </md:MdAdaptiveLayout>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdAdaptiveLayout MediumBreakpoint=&quot;560&quot; ExpandedBreakpoint=&quot;760&quot;&gt;&#10;  &lt;md:MdAdaptiveLayout.CompactContent&gt;...&lt;/md:MdAdaptiveLayout.CompactContent&gt;&#10;  &lt;md:MdAdaptiveLayout.MediumContent&gt;...&lt;/md:MdAdaptiveLayout.MediumContent&gt;&#10;  &lt;md:MdAdaptiveLayout.ExpandedContent&gt;...&lt;/md:MdAdaptiveLayout.ExpandedContent&gt;&#10;&lt;/md:MdAdaptiveLayout&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
