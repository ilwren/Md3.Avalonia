<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdCard}" TargetType="md:MdCard">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Md.Comp.Card.Container.Shape}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdCard">
        <Border x:Name="PART_Container"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BoxShadow="{TemplateBinding Elevation}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_StateLayer"
                    Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                    IsHitTestVisible="False"
                    Opacity="0" />
            <md:MdRipplePresenter IsHitTestVisible="False"
                                  RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:elevated">
      <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" />
      <Setter Property="Elevation" Value="{DynamicResource Md.Sys.Elevation.Level1}" />
    </Style>
    <Style Selector="^:filled">
      <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}" />
      <Setter Property="Elevation" Value="{DynamicResource Md.Sys.Elevation.Level0}" />
    </Style>
    <Style Selector="^:outlined">
      <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Elevation" Value="{DynamicResource Md.Sys.Elevation.Level0}" />
    </Style>
    <Style Selector="^:elevated:interactive:pointerover">
      <Setter Property="Elevation" Value="{DynamicResource Md.Sys.Elevation.Level2}" />
    </Style>
    <Style Selector="^:interactive:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:interactive:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^:interactive:focus-visible /template/ Border#PART_Container">
      <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:not(:interactive) /template/ md|MdRipplePresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
