<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Md3.Avalonia.Ecosystem.Themes.EcosystemTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Md3.Avalonia.Ecosystem/Themes/EcosystemControls.axaml" />
        <ResourceInclude Source="avares://Md3.Avalonia.Ecosystem/Themes/AdvancedControls.axaml" />
        <ResourceInclude Source="avares://Md3.Avalonia.Ecosystem/Themes/WaveFControls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
