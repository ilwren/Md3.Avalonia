<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             xmlns:themes="using:Md3.Avalonia.Themes"
             xmlns:mdm="using:Markdown.Avalonia"
             x:Class="Md3.Avalonia.Gallery.Pages.MarkdownGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Markdown" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Markdown.Avalonia documents rendered with the opt-in Md3.Avalonia.Markdown style collection." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Rendered document" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="The collection is built on this page and assigned to this one viewer, so a viewer that is left alone keeps Markdown.Avalonia's own look." />
        <Border CornerRadius="12" Padding="4"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
          <Border CornerRadius="8" ClipToBounds="True"
                  Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
            <mdm:MarkdownScrollViewer x:Name="DocumentViewer" Height="440">
              <mdm:MarkdownScrollViewer.MarkdownStyle>
                <themes:MaterialMarkdownTheme />
              </mdm:MarkdownScrollViewer.MarkdownStyle>
            </mdm:MarkdownScrollViewer>
          </Border>
        </Border>
      </StackPanel>

      <gallery:ApiNotes Control="MaterialMarkdownTheme" Members="MarkdownScrollViewer.MarkdownStyle, MaterialTheme, Md.Sys.TypeScale, Md.Sys.Color.PrimarySelection">
        <gallery:ApiNotes.Notes>
          <TextBlock Classes="body" TextWrapping="Wrap" Text="The collection maps Markdown.Avalonia's selectors onto Md.Sys tokens, so the tokens still come from MaterialTheme and follow its light/dark variant. A viewer is themed by assigning one instance to its MarkdownStyle." />
        </gallery:ApiNotes.Notes>
      </gallery:ApiNotes>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Markdown.Avalonia keeps its style collections closed, so this one is assigned to the viewer's MarkdownStyle property instead of being registered in Application.Styles." />
        <gallery:CodeExample XamlCode="&lt;md:MarkdownScrollViewer Markdown=&quot;{Binding Document}&quot;&gt;&#10;  &lt;md:MarkdownScrollViewer.MarkdownStyle&gt;&#10;    &lt;themes:MaterialMarkdownTheme /&gt;&#10;  &lt;/md:MarkdownScrollViewer.MarkdownStyle&gt;&#10;&lt;/md:MarkdownScrollViewer&gt;"
                            CSharpCode="var viewer = new MarkdownScrollViewer&#10;{&#10;    Markdown = &quot;# Heading&quot;,&#10;    MarkdownStyle = new MaterialMarkdownTheme()&#10;};&#10;&#10;// MaterialTheme still supplies the tokens being read; the collection only maps&#10;// Markdown.Avalonia's own selector set onto them." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Mapping" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Every selector of the pinned FluentTheme collection is re-tokenized: prose is OnSurfaceVariant on Surface, headings and code OnSurface, links Primary, rules OutlineVariant, and code blocks a SurfaceContainerLow card. Sizes come from Md.Sys.TypeScale." />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
