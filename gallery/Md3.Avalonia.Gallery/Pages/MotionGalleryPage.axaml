<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:motion="using:Md3.Avalonia.Motion"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.MotionGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
    <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Motion"/><TextBlock Classes="body" Text="Material 3 expressive and standard spring schemes, reduced motion, reversible menus, and pointer-origin ripples."/></StackPanel>
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="h2" Text="Spring comparison"/><md:MdButton Grid.Column="1" Content="Play motion" Variant="Filled" Click="PlayMotion"/></Grid>
      <Grid Width="520" HorizontalAlignment="Left" ColumnDefinitions="140,*,56" ColumnSpacing="12">
        <TextBlock VerticalAlignment="Center" Text="Playback speed" />
        <md:MdSlider x:Name="MotionSpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="2" Value="1"
                     SmallChange="0.1" TickFrequency="0.25" IsSnapToTickEnabled="True"
                     ShowValueIndicator="True" ValueFormat="0.00×" PropertyChanged="MotionSpeedChanged" />
        <TextBlock x:Name="MotionSpeedText" Grid.Column="2" VerticalAlignment="Center" Text="1.00×" />
      </Grid>
      <TextBlock Classes="body" Text="This slider changes the playback speed of all three comparison tracks below." />
      <Border Padding="20" CornerRadius="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="100,*"><TextBlock VerticalAlignment="Center" Text="Expressive"/><Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"><Border x:Name="ExpressiveDot" Width="28" Height="28" Margin="0,-10,0,0" HorizontalAlignment="Left" Background="{DynamicResource Md.Sys.Color.Primary.Brush}" CornerRadius="14"/></Border></Grid>
          <Grid ColumnDefinitions="100,*"><TextBlock VerticalAlignment="Center" Text="Standard"/><Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"><Border x:Name="StandardDot" Width="28" Height="28" Margin="0,-10,0,0" HorizontalAlignment="Left" Background="{DynamicResource Md.Sys.Color.Secondary.Brush}" CornerRadius="14"/></Border></Grid>
          <Grid ColumnDefinitions="100,*"><TextBlock VerticalAlignment="Center" Text="Reduced"/><Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"><Border x:Name="ReducedDot" Width="28" Height="28" Margin="0,-10,0,0" HorizontalAlignment="Left" Background="{DynamicResource Md.Sys.Color.Tertiary.Brush}" CornerRadius="14"/></Border></Grid>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Spacing="12" motion:MdMotion.Scheme="Expressive">
      <TextBlock Classes="h2" Text="Ripple and component motion" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <md:MdButton Content="Pointer ripple" Variant="Filled" />
        <md:MdToggleButton Content="Shape morph" Variant="Tonal" />
        <md:MdSplitButton Content="Animated menu"><md:MdSplitButton.DropDownContent><StackPanel Width="180"><md:MdButton Content="First action" Variant="Text"/><md:MdButton Content="Second action" Variant="Text"/></StackPanel></md:MdSplitButton.DropDownContent></md:MdSplitButton>
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="motion:MdMotion.Scheme=&quot;Expressive&quot;" CSharpCode="MdMotion.SetScheme(panel, MdMotionScheme.Expressive);&#10;double position = MdMotionTokens.ExpressiveDefaultSpatial.Sample(seconds);" /></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
