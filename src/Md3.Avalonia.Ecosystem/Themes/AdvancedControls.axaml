<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:eco="using:Md3.Avalonia.Ecosystem.Controls"
                    xmlns:infra="using:Md3.Avalonia.Ecosystem.Infrastructure"
                    xmlns:md="using:Md3.Avalonia.Controls">

  <!-- Ecosystem controls are self-contained: these scoped collection templates avoid any
       dependency on Avalonia's global FluentTheme. -->
  <ControlTheme x:Key="EcoItemsHostTheme" TargetType="ItemsControl">
    <Setter Property="Template"><ControlTemplate TargetType="ItemsControl"><ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="EcoListItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="48" /><Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="12" /><Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Grid><ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /><Border x:Name="PART_State" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Opacity="0" /></Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_State"><Setter Property="Opacity" Value="0.12" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_State"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="EcoCalendarListItemTheme" TargetType="ListBoxItem" BasedOn="{StaticResource EcoListItemTheme}">
    <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="EcoCommandPaletteItemTheme" TargetType="ListBoxItem" BasedOn="{StaticResource EcoListItemTheme}">
    <Setter Property="MinHeight" Value="60" /><Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="16" />
  </ControlTheme>
  <!-- Chat selection belongs to the bubble, never the full-width row. -->
  <ControlTheme x:Key="EcoChatListItemTheme" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template"><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="EcoListTheme" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource EcoListItemTheme}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBox">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <md:MdScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></md:MdScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="EcoAnchorButtonTheme" TargetType="Button">
    <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Outline.Brush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" /><Border x:Name="PART_State" Background="{DynamicResource Md.Sys.Color.Primary.Brush}" CornerRadius="20" Opacity="0" /></Grid></Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_State"><Setter Property="Opacity" Value="0.12" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdPopover}" TargetType="eco:MdPopover">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Button Name="PART_AnchorButton" Theme="{StaticResource EcoAnchorButtonTheme}" Content="{TemplateBinding Anchor}" />
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsPopupOpen}" IsLightDismissEnabled="{TemplateBinding DismissOnOutsideClick}" Placement="{TemplateBinding Placement}" PlacementTarget="{Binding #PART_AnchorButton}" ShouldUseOverlayLayer="False" WindowManagerAddShadowHint="False">
            <Popup.Styles><Style Selector="PopupRoot"><Setter Property="Background" Value="Transparent" /><Setter Property="TransparencyLevelHint" Value="Transparent" /><Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" /></Style></Popup.Styles>
            <Border x:Name="PART_Surface" Classes="eco-popover-surface" Margin="0,4,0,0" Padding="16,12" MinWidth="160" MaxWidth="400"
                    Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="12"
                    BoxShadow="0 4 16 0 #33000000" Opacity="0"
                    RenderTransform="scale(0.8) translate(0px,-8px)" RenderTransformOrigin="0%,0%">
              <ContentPresenter Content="{TemplateBinding PopoverContent}" />
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open /template/ Border#PART_Surface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Surface"><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type eco:MdHoverCard}" TargetType="eco:MdHoverCard" BasedOn="{StaticResource {x:Type eco:MdPopover}}" />

  <ControlTheme x:Key="{x:Type eco:MdCommandPalette}" TargetType="eco:MdCommandPalette">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_Backdrop" IsVisible="False" IsHitTestVisible="False" Opacity="0" Background="#66000000">
          <Border x:Name="PART_Surface" Width="600" MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="480" VerticalAlignment="Top" Margin="24,72,24,24" Padding="8"
                  Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" CornerRadius="28" BoxShadow="0 8 32 0 #55000000"
                  Opacity="0" RenderTransform="scale(0.96) translate(0px,-16px)" RenderTransformOrigin="50%,0%">
            <Grid RowDefinitions="Auto,*">
              <md:MdTextBox Name="PART_QueryBox" Margin="8" PlaceholderText="Search commands"
                            ShowClearButton="True" Variant="Outlined" Text="{TemplateBinding Query, Mode=TwoWay}" />
              <ListBox Name="PART_ItemsHost" Grid.Row="1" Theme="{StaticResource EcoListTheme}"
                       ItemContainerTheme="{StaticResource EcoCommandPaletteItemTheme}"
                       ItemsSource="{TemplateBinding FilteredItems}" SelectedIndex="{TemplateBinding SelectedIndex, Mode=TwoWay}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="eco:MdCommandItem">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity=".72" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Gesture}" VerticalAlignment="Center" Opacity=".68" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="1" Classes="eco-empty" IsVisible="False" Margin="24" Text="No matching commands" HorizontalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:present /template/ Grid#PART_Backdrop"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:open /template/ Grid#PART_Backdrop"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:open /template/ Border#PART_Surface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Surface"><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:empty /template/ TextBlock.eco-empty"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdSlidableItem}" TargetType="eco:MdSlidableItem">
    <Setter Property="ClipToBounds" Value="True" /><Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ClipToBounds="True">
          <Border HorizontalAlignment="Left" Width="{TemplateBinding ActionExtent}" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}"><ContentPresenter x:Name="PART_StartActions" Content="{TemplateBinding StartActions}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{TemplateBinding RevealProgress}" RenderTransform="scale(0.8)" RenderTransformOrigin="50%,50%" /></Border>
          <Border HorizontalAlignment="Right" Width="{TemplateBinding ActionExtent}" Background="{DynamicResource Md.Sys.Color.ErrorContainer.Brush}"><ContentPresenter x:Name="PART_EndActions" Content="{TemplateBinding EndActions}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{TemplateBinding RevealProgress}" RenderTransform="scale(0.8)" RenderTransformOrigin="50%,50%" /></Border>
          <Border x:Name="PART_Foreground" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" CornerRadius="12">
            <Border.RenderTransform><TranslateTransform X="{TemplateBinding Offset}" /></Border.RenderTransform>
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:start-open /template/ ContentPresenter#PART_StartActions"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:end-open /template/ ContentPresenter#PART_EndActions"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:reduced-motion /template/ ContentPresenter#PART_StartActions"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:reduced-motion /template/ ContentPresenter#PART_EndActions"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdPagedItemsView}" TargetType="eco:MdPagedItemsView">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="*,Auto">
          <ItemsControl Theme="{StaticResource EcoItemsHostTheme}" ItemsSource="{TemplateBinding Items}" />
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="8">
            <md:MdLinearProgressIndicator Classes="eco-loading" IsVisible="False" IsIndeterminate="True" Width="120" />
            <StackPanel Classes="eco-error" IsVisible="False" HorizontalAlignment="Center"><ContentPresenter Content="{TemplateBinding ErrorContent}" /><md:MdButton Name="PART_RetryButton" Content="Retry" Variant="Text" HorizontalAlignment="Center" Margin="0,8,0,0" /></StackPanel>
            <ContentPresenter Classes="eco-empty" IsVisible="False" Content="{TemplateBinding EmptyContent}" />
            <md:MdButton Name="PART_LoadMoreButton" Content="Load more" Variant="Outlined" IsVisible="False" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:loading /template/ md|MdLinearProgressIndicator.eco-loading"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:error /template/ StackPanel.eco-error"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:empty /template/ ContentPresenter.eco-empty"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:data /template/ md|MdButton#PART_LoadMoreButton"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdDataGrid}" TargetType="eco:MdDataGrid">
    <Setter Property="ItemContainerTheme" Value="{StaticResource EcoListItemTheme}" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}">
              <eco:MdDataGridHeaderPresenter Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
            <md:MdScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" />
            </md:MdScrollViewer>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type eco:MdAsyncSelect}" TargetType="eco:MdAsyncSelect">
    <Setter Property="Focusable" Value="True" /><Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <md:MdTextBox Name="PART_Query" Text="{TemplateBinding Query, Mode=TwoWay}" Label="Search" ShowClearButton="True" Variant="Outlined" />
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsPopupOpen}" Placement="BottomEdgeAlignedLeft" PlacementTarget="{Binding #PART_Query}" IsLightDismissEnabled="True" ShouldUseOverlayLayer="False" WindowManagerAddShadowHint="False">
            <Popup.Styles><Style Selector="PopupRoot"><Setter Property="Background" Value="Transparent" /><Setter Property="TransparencyLevelHint" Value="Transparent" /><Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" /></Style></Popup.Styles>
            <Border Name="PART_Surface" MinWidth="260" MaxHeight="320" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="0,0,12,12" Padding="4" Opacity="0" RenderTransform="scale(0.96) translate(0px,-8px)" RenderTransformOrigin="50%,0%">
              <Grid>
                <ListBox Name="PART_Results" Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoListItemTheme}" ItemsSource="{TemplateBinding Results}" Background="Transparent" />
                <md:MdLinearProgressIndicator Classes="eco-loading" IsVisible="False" IsIndeterminate="True" VerticalAlignment="Top" />
                <TextBlock Classes="eco-empty" IsVisible="False" Text="No results" HorizontalAlignment="Center" Margin="16" />
                <TextBlock Classes="eco-error" IsVisible="False" Text="Search failed. Try again." HorizontalAlignment="Center" Margin="16" />
              </Grid>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open /template/ Border#PART_Surface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Surface"><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:loading /template/ md|MdLinearProgressIndicator.eco-loading"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:empty /template/ TextBlock.eco-empty"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:error /template/ TextBlock.eco-error"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdCalendar}" TargetType="eco:MdCalendar">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="MinWidth" Value="336" />
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdCalendar">
        <Border Padding="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" CornerRadius="20">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="48,*,48">
              <md:MdIconButton Name="PART_PreviousMonth" Grid.Column="0" Icon="{DynamicResource Md.Icon.ChevronLeft}" AutomationProperties.Name="Previous month" />
              <TextBlock Grid.Column="1" Text="{TemplateBinding DisplayMonthText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
              <md:MdIconButton Name="PART_NextMonth" Grid.Column="2" Icon="{DynamicResource Md.Icon.ChevronRight}" AutomationProperties.Name="Next month" />
            </Grid>
            <ItemsControl Theme="{StaticResource EcoItemsHostTheme}" ItemsSource="{TemplateBinding WeekdayLabels}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox Name="PART_Days" Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoCalendarListItemTheme}"
                     ItemsSource="{TemplateBinding VisibleDays}" Background="Transparent" SelectionMode="Single">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="eco:MdCalendarDay"><eco:MdCalendarDayPresenter Day="{Binding}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdCalendarDayPresenter}" TargetType="eco:MdCalendarDayPresenter">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
    <Setter Property="Template"><ControlTemplate><Border Name="PART_DaySurface" CornerRadius="20" Background="Transparent"><Grid><TextBlock Text="{Binding Day.Date.Day, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Center" /><ContentPresenter Content="{Binding Day.Badge, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="9" Margin="0,0,0,1" /></Grid></Border></ControlTemplate></Setter>
    <Style Selector="^:outside"><Setter Property="Opacity" Value=".55" /></Style>
    <Style Selector="^:today /template/ Border#PART_DaySurface"><Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="^:selected /template/ Border#PART_DaySurface"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" /></Style>
    <Style Selector="^:range-start"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnPrimary.Brush}" /></Style>
    <Style Selector="^:range-start /template/ Border#PART_DaySurface"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:range-end"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnPrimary.Brush}" /></Style>
    <Style Selector="^:range-end /template/ Border#PART_DaySurface"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdResultView}" TargetType="eco:MdResultView">
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Spacing="12" Margin="24">
          <ContentPresenter Content="{TemplateBinding Illustration}" HorizontalAlignment="Center" />
          <ContentPresenter Content="{TemplateBinding Title}" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
          <md:MdButton Variant="Filled" Content="{TemplateBinding ActionContent}" Command="{TemplateBinding ActionCommand}" CommandParameter="{TemplateBinding ActionCommandParameter}" HorizontalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="EcoCascaderAnchorTheme" TargetType="Button">
    <Setter Property="MinHeight" Value="56" /><Setter Property="Padding" Value="16,0,12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Outline.Brush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border x:Name="PART_Root" MinHeight="56" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" ClipToBounds="True">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_State" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsHitTestVisible="False" Opacity="0" />
            <Border x:Name="PART_Focus" Margin="2" BorderBrush="{DynamicResource Md.Sys.Color.Primary.Brush}"
                    BorderThickness="2" CornerRadius="2" IsHitTestVisible="False" IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_State"><Setter Property="Opacity" Value="0.12" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdCascader}" TargetType="eco:MdCascader">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdCascader">
        <StackPanel Spacing="6">
          <Grid>
            <Button Name="PART_Anchor" Theme="{StaticResource EcoCascaderAnchorTheme}">
              <Grid ColumnDefinitions="*,48">
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{TemplateBinding DisplayText}" />
                <Viewbox Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Path x:Name="PART_Arrow" Width="12" Height="8" Data="M1,1 L6,6 L11,1" Stroke="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" RenderTransform="rotate(0deg)" RenderTransformOrigin="50%,50%" />
                </Viewbox>
              </Grid>
            </Button>
            <Border Margin="12,-7,0,0" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource Md.Sys.Color.Surface.Brush}" IsHitTestVisible="False">
              <TextBlock FontSize="12" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" Text="{TemplateBinding Label}" />
            </Border>
          </Grid>
          <Border Name="PART_Surface" IsVisible="False" Padding="4"
                  Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}"
                  BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1"
                  CornerRadius="0,0,12,12" BoxShadow="0 4 16 0 #33000000" ClipToBounds="True"
                  Opacity="0" RenderTransform="scale(0.96) translate(0px,-8px)" RenderTransformOrigin="50%,0%">
            <ItemsControl Name="PART_Columns" Theme="{StaticResource EcoItemsHostTheme}" ItemsSource="{TemplateBinding Columns}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ListBox Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoListItemTheme}" ItemsSource="{Binding}" MinWidth="160" MaxHeight="240">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="eco:MdCascaderItem"><Grid Margin="4" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" /><TextBlock Grid.Column="1" Text="›" Opacity=".65" IsVisible="{Binding HasChildren}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:present /template/ Border#PART_Surface"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:open /template/ Border#PART_Surface"><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
    <Style Selector="^:open /template/ Path#PART_Arrow"><Setter Property="RenderTransform" Value="rotate(180deg)" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Surface"><Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdTransfer}" TargetType="eco:MdTransfer">
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdTransfer">
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
          <Border Name="PART_SourceSurface" Padding="8" BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="16">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <md:MdTextBox Label="Filter available" ShowClearButton="True" Variant="Outlined" Text="{TemplateBinding SourceFilter, Mode=TwoWay}" />
              <ListBox Name="PART_Available" Grid.Row="1" Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoListItemTheme}" ItemsSource="{TemplateBinding AvailableItems}" SelectionMode="Multiple" MinHeight="180" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
            <md:MdIconButton Name="PART_MoveTarget" Icon="{DynamicResource Md.Icon.ChevronRight}" ToolTip.Tip="Move selected to target" />
            <md:MdButton Name="PART_MoveAllTarget" Content="All →" Size="ExtraSmall" Variant="Text" />
            <md:MdIconButton Name="PART_MoveSource" Icon="{DynamicResource Md.Icon.ChevronLeft}" ToolTip.Tip="Move selected to available" />
            <md:MdButton Name="PART_MoveAllSource" Content="← All" Size="ExtraSmall" Variant="Text" />
          </StackPanel>
          <Border Name="PART_TargetSurface" Grid.Column="2" Padding="8" BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="16">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <md:MdTextBox Label="Filter selected" ShowClearButton="True" Variant="Outlined" Text="{TemplateBinding TargetFilter, Mode=TwoWay}" />
              <ListBox Name="PART_Target" Grid.Row="1" Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoListItemTheme}" ItemsSource="{TemplateBinding TargetItems}" SelectionMode="Multiple" MinHeight="180" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:dragging"><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="^:drag-to-source /template/ Border#PART_SourceSurface"><Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /><Setter Property="BorderThickness" Value="3" /></Style>
    <Style Selector="^:drag-to-target /template/ Border#PART_TargetSurface"><Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /><Setter Property="BorderThickness" Value="3" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdTimelineItemPresenter}" TargetType="eco:MdTimelineItemPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdTimelineItemPresenter">
        <Grid>
          <Grid x:Name="PART_Vertical" MinHeight="72" ColumnDefinitions="28,*" RowDefinitions="*,14,*" Margin="0,2">
            <Border x:Name="PART_VBefore" Grid.Row="0" Width="2" HorizontalAlignment="Center" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
            <Border x:Name="PART_VAfter" Grid.Row="2" Width="2" HorizontalAlignment="Center" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
            <Border x:Name="PART_Indicator" Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Md.Sys.Color.Outline.Brush}" BorderBrush="{DynamicResource Md.Sys.Color.Surface.Brush}" BorderThickness="2" CornerRadius="7" ZIndex="1" />
            <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="8,5,0,8" Spacing="2">
              <ContentPresenter Content="{Binding Item.Icon, RelativeSource={RelativeSource TemplatedParent}}" IsVisible="False" />
              <TextBlock Text="{Binding Item.Title, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Item.Description, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" Opacity=".72" />
              <TextBlock Text="{Binding Item.Time, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:g}'}" FontSize="11" Opacity=".6" />
            </StackPanel>
          </Grid>
          <Grid x:Name="PART_Horizontal" MinWidth="176" RowDefinitions="28,*" ColumnDefinitions="*,14,*" Margin="4" IsVisible="False">
            <Border x:Name="PART_HBefore" Grid.Column="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
            <Border x:Name="PART_HAfter" Grid.Column="2" Height="2" VerticalAlignment="Center" Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
            <Border x:Name="PART_HIndicator" Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Md.Sys.Color.Outline.Brush}" BorderBrush="{DynamicResource Md.Sys.Color.Surface.Brush}" BorderThickness="2" CornerRadius="7" ZIndex="1" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="8,6" Spacing="2">
              <TextBlock HorizontalAlignment="Center" Text="{Binding Item.Title, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" />
              <TextBlock HorizontalAlignment="Center" Text="{Binding Item.Description, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" Opacity=".72" />
              <TextBlock HorizontalAlignment="Center" Text="{Binding Item.Time, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:g}'}" FontSize="11" Opacity=".6" />
            </StackPanel>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:horizontal /template/ Grid#PART_Vertical"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:horizontal /template/ Grid#PART_Horizontal"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:first /template/ Border#PART_VBefore"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:first /template/ Border#PART_HBefore"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:last /template/ Border#PART_VAfter"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:last /template/ Border#PART_HAfter"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:active /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:active /template/ Border#PART_HIndicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:completed /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Tertiary.Brush}" /></Style>
    <Style Selector="^:completed /template/ Border#PART_HIndicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Tertiary.Brush}" /></Style>
    <Style Selector="^:error /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Error.Brush}" /></Style>
    <Style Selector="^:error /template/ Border#PART_HIndicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Error.Brush}" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdTimeline}" TargetType="eco:MdTimeline">
    <Setter Property="Template"><ControlTemplate TargetType="eco:MdTimeline"><ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate></Setter>
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="ItemTemplate"><DataTemplate x:DataType="eco:MdTimelineItem"><eco:MdTimelineItemPresenter Item="{Binding}" /></DataTemplate></Setter>
    <Style Selector="^:horizontal"><Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdChart}" TargetType="eco:MdChart"><Setter Property="MinHeight" Value="220" /><Setter Property="AxisBrush" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" /><Setter Property="GridBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" /></ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdRichEditor}" TargetType="eco:MdRichEditor">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" Padding="6,4" BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="0,0,0,1">
              <ItemsControl Name="PART_Toolbar" Theme="{StaticResource EcoItemsHostTheme}" ItemsSource="{TemplateBinding ToolbarCommands}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="34" Height="34" Margin="2" Padding="0" CornerRadius="8"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="{Binding Converter={x:Static eco:MdRichEditorCommandConverters.TooltipConverter}}">
                      <md:MdIcon Glyph="{Binding Converter={x:Static eco:MdRichEditorCommandConverters.GlyphConverter}}" Size="18" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="12" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdChatMessagePresenter}" TargetType="eco:MdChatMessagePresenter">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdChatMessagePresenter">
        <Grid x:Name="PART_Layout" MaxWidth="580" HorizontalAlignment="Left" Margin="0,2">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border x:Name="PART_AvatarHost" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                    CornerRadius="999" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}"
                    ClipToBounds="True">
              <Grid>
                <md:MdIcon x:Name="PART_AvatarIcon" Glyph="{Binding AvatarGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" Size="18" />
                <TextBlock x:Name="PART_AvatarInitials" Text="{Binding SenderInitials, RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock x:Name="PART_Sender" Margin="4,0" FontSize="11" FontWeight="Medium" Opacity=".72"
                         Text="{Binding Message.Sender, RelativeSource={RelativeSource TemplatedParent}}" />
              <Border x:Name="PART_Bubble" Padding="14,10" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="2" CornerRadius="18,18,18,4" ClipToBounds="True">
                <Grid>
                  <StackPanel Spacing="6">
                    <Border x:Name="PART_Reply" Padding="8,6" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"
                            CornerRadius="8" IsVisible="False">
                      <Grid ColumnDefinitions="3,*">
                        <Border Background="{DynamicResource Md.Sys.Color.Primary.Brush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                          <TextBlock FontSize="10" FontWeight="SemiBold" Opacity=".75" Text="Replying to message" />
                          <ContentPresenter Content="{Binding Message.ReplyPreview, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Opacity=".85" MaxHeight="36" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <ContentPresenter Content="{Binding Message.Content, RelativeSource={RelativeSource TemplatedParent}}"
                                      Foreground="{TemplateBinding Foreground}" />
                  </StackPanel>
                  <Border x:Name="PART_State" Background="{TemplateBinding Foreground}" CornerRadius="16" IsHitTestVisible="False" Opacity="0" />
                </Grid>
              </Border>
              <Grid x:Name="PART_Footer" ColumnDefinitions="Auto,Auto" Margin="4,0" HorizontalAlignment="Left">
                <TextBlock x:Name="PART_Time" FontSize="10" Opacity=".56" VerticalAlignment="Center"
                           Text="{Binding Message.Timestamp, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:t}'}" />
                <StackPanel x:Name="PART_DeliveryStatus" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="False">
                  <md:MdIcon Glyph="&#xe877;" Size="14" Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                </StackPanel>
                <StackPanel x:Name="PART_Failure" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" IsVisible="False">
                  <md:MdIcon Glyph="&#xe000;" Size="12" Foreground="{DynamicResource Md.Sys.Color.Error.Brush}" VerticalAlignment="Center" />
                  <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Md.Sys.Color.Error.Brush}"
                             Text="{Binding Message.ErrorText, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='Send failed'}" />
                  <md:MdButton Classes="retry" Content="Retry" Size="ExtraSmall" Variant="Text" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.06" /></Style>
    <Style Selector="^:selected /template/ Border#PART_Bubble"><Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /><Setter Property="BorderThickness" Value="2.5" /></Style>
    <Style Selector="^:reply /template/ Border#PART_Reply"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:failed /template/ StackPanel#PART_Failure"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:failed /template/ StackPanel#PART_DeliveryStatus"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:user"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="^:user /template/ Grid#PART_Layout"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="^:user /template/ Border#PART_AvatarHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:user /template/ TextBlock#PART_Sender"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:user /template/ Border#PART_Bubble">
      <Setter Property="CornerRadius" Value="18,18,4,18" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:user /template/ Grid#PART_Footer"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="^:user /template/ StackPanel#PART_DeliveryStatus"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:user"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnPrimaryContainer.Brush}" /></Style>
    <Style Selector="^:system"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style Selector="^:system /template/ Grid#PART_Layout"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style Selector="^:system /template/ Border#PART_AvatarHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:system /template/ TextBlock#PART_Sender"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:system /template/ Border#PART_Bubble">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="^:system /template/ Grid#PART_Footer"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style Selector="^:system"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdChatView}" TargetType="eco:MdChatView">
    <Setter Property="Template">
      <ControlTemplate TargetType="eco:MdChatView">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
          <Border x:Name="PART_SelectionToolbar" Margin="8,4" Padding="12,6" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" CornerRadius="16" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <md:MdButton Name="PART_CancelSelectionButton" Content="Cancel" Size="Small" Variant="Text" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium"
                         Text="{Binding SelectionCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} selected'}" />
              <md:MdButton Name="PART_QuoteButton" Grid.Column="2" Content="Quote" Size="Small" Variant="Tonal" />
              <md:MdButton Name="PART_DeleteButton" Grid.Column="3" Content="Delete" Size="Small" Variant="Outlined" />
            </Grid>
          </Border>
          <ListBox Name="PART_MessagesHost" Grid.Row="1" Theme="{StaticResource EcoListTheme}" ItemContainerTheme="{StaticResource EcoChatListItemTheme}"
                   ItemsSource="{TemplateBinding MessagesSource}" SelectionMode="Multiple" Background="Transparent" Padding="8,4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="eco:MdChatMessage">
                <eco:MdChatMessagePresenter Message="{Binding}"
                    IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ItemsControl Name="PART_SuggestionsHost" Grid.Row="2" Theme="{StaticResource EcoItemsHostTheme}" ItemsSource="{TemplateBinding SuggestionsSource}" Margin="8,4">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><md:MdAssistChip Content="{Binding}" Margin="3" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="PART_QuotePreview" Grid.Row="3" Margin="8,2" Padding="12,8"
                  Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}" CornerRadius="12" IsVisible="False">
            <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="8">
              <Border Background="{DynamicResource Md.Sys.Color.Primary.Brush}" CornerRadius="2" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding QuotedMessage.Sender, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Replying to {0}'}" />
                <ContentPresenter Content="{Binding QuotedMessage.Content, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="32" Opacity=".75" />
              </StackPanel>
              <md:MdButton Name="PART_CancelQuoteButton" Grid.Column="2" Content="Cancel" Size="ExtraSmall" Variant="Text" />
            </Grid>
          </Border>
          <Border Grid.Row="4" Margin="8,6,8,8" Padding="6,4,6,4"
                  Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}"
                  BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1"
                  CornerRadius="28">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
              <Button Name="PART_AttachmentButton" Width="36" Height="36" CornerRadius="999"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="Attach file">
                <md:MdIcon Glyph="&#xe226;" Size="20" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
              </Button>
              <TextBox Name="PART_Composer" Grid.Column="1"
                       Text="{TemplateBinding ComposerText, Mode=TwoWay}"
                       AcceptsReturn="True" MaxHeight="120" MinHeight="36"
                       VerticalContentAlignment="Center" Padding="8,6"
                       Background="Transparent" BorderThickness="0"
                       Watermark="Type a message..." TextWrapping="Wrap" />
              <Button Name="PART_SendButton" Grid.Column="2" Width="36" Height="36" CornerRadius="999"
                      Background="{DynamicResource Md.Sys.Color.Primary.Brush}"
                      Foreground="{DynamicResource Md.Sys.Color.OnPrimary.Brush}"
                      BorderThickness="0" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="Send message">
                <md:MdIcon Glyph="&#xe163;" Size="18" Foreground="{DynamicResource Md.Sys.Color.OnPrimary.Brush}" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selection /template/ Border#PART_SelectionToolbar"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:quoted /template/ Border#PART_QuotePreview"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type eco:MdSkeleton}" TargetType="eco:MdSkeleton">
    <Setter Property="MinHeight" Value="20" /><Setter Property="BaseBrush" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}" /><Setter Property="HighlightBrush" Value="{DynamicResource Md.Sys.Color.SurfaceVariant.Brush}" />
    <Setter Property="Template"><ControlTemplate><Grid><ContentPresenter Classes="eco-content" Content="{TemplateBinding Content}" /><Grid Classes="eco-placeholder" IsVisible="False"><Border Classes="eco-base" Background="{TemplateBinding BaseBrush}" CornerRadius="8" /><Border Classes="eco-highlight" Opacity="{TemplateBinding PulseOpacity}" Background="{TemplateBinding HighlightBrush}" CornerRadius="8" /></Grid></Grid></ControlTemplate></Setter>
    <Style Selector="^:loading /template/ Grid.eco-placeholder"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:loading /template/ ContentPresenter.eco-content"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:circle /template/ Border.eco-base"><Setter Property="CornerRadius" Value="999" /></Style>
    <Style Selector="^:circle /template/ Border.eco-highlight"><Setter Property="CornerRadius" Value="999" /></Style>
    <Style Selector="^:text /template/ Grid.eco-placeholder"><Setter Property="MaxHeight" Value="14" /></Style>
    <Style Selector="^:text /template/ Border.eco-base"><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="^:text /template/ Border.eco-highlight"><Setter Property="CornerRadius" Value="4" /></Style>
  </ControlTheme>
</ResourceDictionary>
