<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.BorderlessWindowGalleryPage">
  <StackPanel MinHeight="1200" Spacing="28">
    <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Borderless windows" /><TextBlock Classes="body" TextWrapping="Wrap" Text="Extended client-area chrome keeps the platform resize frame, shadow and corner treatment while Material owns the caption content. This follows FluentAvalonia's AppWindow separation instead of removing all native decorations." /></StackPanel>
    <Border BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <md:MdWindowTitleBar Content="Material application" LeadingContent="M3" />
        <Border Grid.Row="1" Height="220" Padding="24" Background="{DynamicResource Md.Sys.Color.Surface.Brush}"><StackPanel Spacing="12"><TextBlock Classes="h2" Text="Chrome preview" /><TextBlock Text="Open the real secondary window to validate dragging, double-click maximize/restore, caption actions, resize grips, and theme behavior." TextWrapping="Wrap" /><md:MdButton Content="Open borderless demo window" Variant="Filled" HorizontalAlignment="Left" Click="OpenDemoWindow" /></StackPanel></Border>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Padding="20" CornerRadius="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}"><StackPanel Spacing="8"><TextBlock Classes="h3" Text="Platform adapter" /><TextBlock x:Name="AdapterStatus" TextWrapping="Wrap" /><TextBlock Text="Applications may inject IMdWindowPlatformAdapter for native system menus or specialized hit testing without changing view models." TextWrapping="Wrap" /></StackPanel></Border>
      <Border Grid.Column="1" Padding="20" CornerRadius="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}"><StackPanel Spacing="8"><TextBlock Classes="h3" Text="Safety contract" /><TextBlock Text="Android resolves to a no-op adapter. Desktop keeps WindowDecorations.BorderOnly, extends the client area, and uses Avalonia move/resize APIs. Interactive title-bar children never start a drag." TextWrapping="Wrap" /></StackPanel></Border>
    </Grid>
    <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage" /><gallery:CodeExample XamlCode="&lt;md:MdBorderlessWindow Title=&quot;My app&quot;&gt;&#10;  &lt;views:Shell /&gt;&#10;&lt;/md:MdBorderlessWindow&gt;" CSharpCode="var window = new MdBorderlessWindow { Title = &quot;My app&quot; };&#10;window.PlatformAdapter = myOptionalNativeAdapter;&#10;window.SystemMenuRequested += (_, point) =&gt; ShowFallbackMenu(point);&#10;window.Show();" /></StackPanel>
  </StackPanel>
</UserControl>
