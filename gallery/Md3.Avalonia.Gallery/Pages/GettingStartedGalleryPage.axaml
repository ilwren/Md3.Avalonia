<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls" xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.GettingStartedGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Get started"/><TextBlock Classes="body" TextWrapping="Wrap" Text="Install the library, merge its opt-in Material theme, and add your first independent Md control."/></StackPanel>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="1 · Reference"/><gallery:CodeExample XamlCode="&lt;PackageReference Include=&quot;Md3.Avalonia&quot; Version=&quot;0.3.0-preview.1&quot; /&gt;&#10;&lt;PackageReference Include=&quot;Md3.Avalonia.Icons&quot; Version=&quot;0.3.0-preview.1&quot; /&gt;&#10;&lt;PackageReference Include=&quot;Md3.Avalonia.Extra&quot; Version=&quot;0.3.0-preview.1&quot; /&gt;" CSharpCode="// Md3.Avalonia.Icons automatically registers its embedded offline-supplied font.&#10;// No ConfigureFonts call is required."/></StackPanel>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="2 · Install the opt-in resources"/><gallery:CodeExample XamlCode="&lt;Application.Styles&gt;&#10;  &lt;themes:MaterialTheme /&gt;&#10;  &lt;extraThemes:ExtraTheme /&gt;&#10;&lt;/Application.Styles&gt;" CSharpCode="// Native Avalonia controls keep their own themes. Only Md* controls opt in."/></StackPanel>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="3 · Build a screen"/><WrapPanel><md:MdButton Content="Continue" Margin="0,0,12,12"/><md:MdTextBox Width="280" Label="Project name" Text="My Material app"/></WrapPanel><gallery:CodeExample XamlCode="&lt;md:MdButton Content=&quot;Continue&quot; Command=&quot;{Binding ContinueCommand}&quot; /&gt;&#10;&lt;md:MdTextBox Label=&quot;Project name&quot; Text=&quot;{Binding Name}&quot; /&gt;" CSharpCode="var button = new MdButton { Content = &quot;Continue&quot; };&#10;button.Click += (_, _) =&gt; Continue();"/></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
