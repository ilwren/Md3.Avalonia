<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same reasoning as Md3.Avalonia.DataGrid and Md3.Avalonia.AvaloniaEdit: a RootNamespace that
         names the themed control's own namespace would shadow its types for every file under
         Md3.Avalonia.*, this repository included. -->
    <RootNamespace>Md3.Avalonia.Themes</RootNamespace>
    <AssemblyName>Md3.Avalonia.PropertyGrid</AssemblyName>
    <Description>Material Design 3 theme for the Avalonia.PropertyGrid control. Opt-in package: it carries the bodong.Avalonia.PropertyGrid dependency so the core Material packages do not have to.</Description>
    <PackageId>Md3.Avalonia.PropertyGrid</PackageId>
    <Version>0.5.0-preview.1</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;propertygrid;property;grid;editor;inspector;settings;controls;theme;material-design-3</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- bodong.Avalonia.PropertyGrid brings bodong.PropertyModels and
         Avalonia.Controls.ColorPicker with it; the theme needs the picker for nothing of its own
         (the grid's own styles include the picker's sheets), but the control types the theme names
         - PropertyGrid, CheckedListEdit, ListEdit, ListElementEdit, TrackableEdit, ButtonEdit,
         PreviewableSlider, PreviewableColorPicker, RadioButtonListEdit, ToggleButtonGroupListEdit,
         CheckedMask, ListElementPlaceholderEdit - all live in that one assembly. -->
    <PackageReference Include="bodong.Avalonia.PropertyGrid" />
    <ProjectReference Include="../Md3.Avalonia/Md3.Avalonia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
