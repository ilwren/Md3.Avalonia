<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.TextBoxGalleryPage"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="760">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Text fields" />
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="Click an empty label to inspect the stable 150 ms animation, or right-click any editable field for the localized Material editing menu." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Variants" />
        <WrapPanel Orientation="Horizontal">
          <md:MdTextBox Width="300" MaxWidth="320" Label="Filled label" PlaceholderText="Type a value"
                        SupportingText="Supporting text" Margin="0,0,16,16" />
          <md:MdTextBox Width="300" MaxWidth="320" Label="Outlined label" Variant="Outlined"
                        PlaceholderText="Type a value" SupportingText="Supporting text" Margin="0,0,16,16" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Populated and disabled" />
        <WrapPanel Orientation="Horizontal">
          <md:MdTextBox Width="300" MaxWidth="320" Label="Project name" Text="Md3.Avalonia"
                        ShowCharacterCounter="True" MaxLength="40" Margin="0,0,16,16" />
          <md:MdTextBox Width="300" MaxWidth="320" Label="Read only value" Text="Material 3"
                        Variant="Outlined" IsReadOnly="True" Margin="0,0,16,16" />
          <md:MdTextBox Width="220" MaxWidth="320" Label="Disabled" Text="Unavailable" IsEnabled="False" Margin="0,0,16,16" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Clear and password actions" />
        <WrapPanel Orientation="Horizontal">
          <md:MdTextBox Width="300" MaxWidth="320" Label="Search" Text="Material components" ShowClearButton="True" Margin="0,0,16,16" />
          <md:MdTextBox Width="300" MaxWidth="320" Label="Password" Text="expressive-motion" IsPassword="True" Variant="Outlined" Margin="0,0,16,16" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Slots, prefix/suffix and error" />
        <WrapPanel Orientation="Horizontal">
          <md:MdTextBox Width="300" MaxWidth="320" Label="Amount" PrefixText="$" SuffixText="USD" Text="120" Margin="0,0,16,16">
            <md:MdTextBox.LeadingIcon><TextBlock Text="#" FontWeight="Medium" /></md:MdTextBox.LeadingIcon>
          </md:MdTextBox>
          <md:MdTextBox Width="300" MaxWidth="340" Label="Email" Text="name@" Variant="Outlined"
                        IsError="True" ErrorText="Enter a valid email address" Margin="0,0,16,16">
            <md:MdTextBox.TrailingIcon><TextBlock Text="!" FontWeight="Bold" /></md:MdTextBox.TrailingIcon>
          </md:MdTextBox>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdTextBox Label=&quot;Email&quot; Text=&quot;{Binding Email}&quot;&#10;              ShowClearButton=&quot;True&quot; Variant=&quot;Outlined&quot; /&gt;" CSharpCode="var email = new MdTextBox&#10;{&#10;    Label = &quot;Email&quot;,&#10;    Variant = MdTextBoxVariant.Outlined,&#10;    ShowClearButton = true&#10;};" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
