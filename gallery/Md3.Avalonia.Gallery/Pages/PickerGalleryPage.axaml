<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.PickerGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Date &amp; time pickers" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Independent Material pickers with two-way values, keyboard dismissal, and scoped popup surfaces." />
      </StackPanel>

      <Border Padding="20" CornerRadius="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h3" Text="When a selection is committed" />
          <TextBlock Classes="body" TextWrapping="Wrap"
                     Text="The docked date picker commits as you pick: its bound value changes the moment you choose a day. Everything that opens as a dialog — the modal date picker and both time pickers — is provisional: the value changes only when you confirm with OK, or Enter in input mode. Dismissing with Escape, the scrim, or Cancel restores the value the picker held when it opened. Each picker below prints its live bound value, so you can see which rule applied." />
        </StackPanel>
      </Border>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Date picker" />
        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="6" Margin="0,0,16,16">
            <md:MdDatePicker x:Name="DockedDate" Label="Docked date" SelectedDate="2026-09-22" />
            <TextBlock x:Name="DockedDateValue" Classes="body" Opacity="0.78" />
          </StackPanel>
          <StackPanel Spacing="6" Margin="0,0,16,16">
            <md:MdDatePicker x:Name="ModalDate" Label="Modal date" Mode="Modal" SelectedDate="2026-10-05" />
            <TextBlock x:Name="ModalDateValue" Classes="body" Opacity="0.78" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Time picker" />
        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="6" Margin="0,0,16,16">
            <md:MdTimePicker x:Name="DialTime" Label="Dial time" SelectedTime="14:30:00" />
            <TextBlock x:Name="DialTimeValue" Classes="body" Opacity="0.78" />
          </StackPanel>
          <StackPanel Spacing="6" Margin="0,0,16,16">
            <md:MdTimePicker x:Name="InputTime" Label="Input time" Mode="Input" SelectedTime="09:15:00" />
            <TextBlock x:Name="InputTimeValue" Classes="body" Opacity="0.78" />
          </StackPanel>
          <StackPanel Spacing="6" Margin="0,0,16,16">
            <md:MdTimePicker x:Name="TwentyFourHourTime" Label="24-hour time" Mode="Input" Is24Hour="True" SelectedTime="21:45:00" />
            <TextBlock x:Name="TwentyFourHourTimeValue" Classes="body" Opacity="0.78" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <Border Padding="20" CornerRadius="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Press Escape to cancel, Enter to confirm input-mode time, and Tab to move between picker actions. Popup state and selected values support two-way MVVM binding." />
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdDatePicker SelectedDate=&quot;{Binding DueDate}&quot; Mode=&quot;Modal&quot; /&gt;&#10;&lt;md:MdTimePicker SelectedTime=&quot;{Binding StartTime}&quot;&#10;                 Mode=&quot;Input&quot; Is24Hour=&quot;True&quot; /&gt;" CSharpCode="var date = new MdDatePicker { Mode = MdDatePickerMode.Modal };&#10;var time = new MdTimePicker { Mode = MdTimePickerMode.Input, Is24Hour = true };&#10;&#10;// Modal pickers are provisional until confirmed; docked and dial pickers&#10;// write straight through, so this fires as the user picks.&#10;date.GetObservable(MdDatePicker.SelectedDateProperty).Subscribe(value =&gt; Report(value));" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
