<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SnackbarGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Snackbar"/><TextBlock Classes="body" Text="Snackbars briefly report an app process and may offer one action or a close affordance."/></StackPanel>
      <md:MdButton Width="180" HorizontalAlignment="Left" Content="Queue from service" Variant="Filled" Click="ShowSnackbar"/>
      <Border Width="760" Height="300" HorizontalAlignment="Left" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="24">
        <md:MdSnackbarHost x:Name="DemoSnackbarHost">
          <TextBlock x:Name="SnackbarResult" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Text="Draft moved to archive"/>
        </md:MdSnackbarHost>
      </Border>
      <StackPanel Spacing="12"><TextBlock Classes="h2" Text="Configurations"/><md:MdSnackbar Content="Connection restored" Duration="0:0:0" IsOpen="True"/><md:MdSnackbar Content="Message deleted" ActionContent="Undo" ActionInvoked="UndoArchive" Duration="0:0:0" IsOpen="True"/></StackPanel>
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="MVVM service usage"/>
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Create one MdSnackbarService at the composition root, assign it to the visual MdSnackbarHost, and inject the same instance as IMdSnackbarService into view models. Creating an unattached MdSnackbar control cannot render."/>
        <gallery:CodeExample
          XamlCode="&lt;md:MdSnackbarHost Service=&quot;{StaticResource SnackbarService}&quot;&gt;&#10;  &lt;views:CurrentPage /&gt;&#10;&lt;/md:MdSnackbarHost&gt;"
          CSharpCode="public MainViewModel(IMdSnackbarService snackbars) =&gt; _snackbars = snackbars;&#10;&#10;await _snackbars.ShowAsync(new MdSnackbarMessage(&quot;Draft archived&quot;)&#10;{&#10;    ActionContent = &quot;Undo&quot;,&#10;    ActionCommand = UndoCommand,&#10;    IsDismissible = true&#10;});"/>
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
