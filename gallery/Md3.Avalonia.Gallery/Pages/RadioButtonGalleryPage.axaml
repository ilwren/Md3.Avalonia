<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.RadioButtonGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
    <StackPanel Spacing="8">
      <TextBlock Classes="h1" Text="Radio buttons" />
      <TextBlock Classes="body" Text="Radio buttons select one option from a mutually exclusive set." />
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Selection group" />
      <StackPanel Spacing="2">
        <md:MdRadioButton GroupName="framework" Content="Avalonia" IsChecked="True" />
        <md:MdRadioButton GroupName="framework" Content="Flutter" />
        <md:MdRadioButton GroupName="framework" Content="Compose" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="States" />
      <StackPanel Orientation="Horizontal" Spacing="32">
        <md:MdRadioButton Content="Unselected" />
        <md:MdRadioButton Content="Selected" IsChecked="True" />
        <md:MdRadioButton Content="Error" IsError="True" />
        <md:MdRadioButton Content="Disabled" IsEnabled="False" />
        <md:MdRadioButton Content="Selected disabled" IsChecked="True" IsEnabled="False" />
      </StackPanel>
    </StackPanel>
    <Border Padding="20" CornerRadius="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
      <TextBlock Classes="body" TextWrapping="Wrap" Text="The full 48-DIP target responds to mouse, touch, pen and keyboard input. Native Avalonia GroupName, command and automation semantics remain available." />
    </Border>
    <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="&lt;md:MdRadioButton Content=&quot;Standard&quot; GroupName=&quot;Plan&quot;&#10;                  IsChecked=&quot;{Binding IsStandardPlan}&quot; /&gt;" CSharpCode="var standard = new MdRadioButton&#10;{&#10;    Content = &quot;Standard&quot;,&#10;    GroupName = &quot;Plan&quot;,&#10;    IsChecked = true&#10;};" /></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
