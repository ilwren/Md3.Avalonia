<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SpinKitGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Spin kit" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A set of indeterminate loading figures for when a progress indicator would overstate how much is known." />
      </StackPanel>

      <StackPanel Spacing="12">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="6" Margin="0,0,24,12"><eco:MdSpinKit Kind="Wave" Size="48" /><TextBlock Classes="body" HorizontalAlignment="Center" Text="Wave" /></StackPanel>
          <StackPanel Spacing="6" Margin="0,0,24,12"><eco:MdSpinKit Kind="ThreeBounce" Size="48" /><TextBlock Classes="body" HorizontalAlignment="Center" Text="ThreeBounce" /></StackPanel>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdSpinKit Kind=&quot;Wave&quot; Size=&quot;48&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
