<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Md3.Avalonia.Icons</RootNamespace>
    <AssemblyName>Md3.Avalonia.Icons</AssemblyName>
    <Description>Full Material Symbols font and glyph catalog with embedded font for Md3.Avalonia.</Description>
    <PackageId>Md3.Avalonia.Icons</PackageId>
    <Version>0.3.5-preview.1</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;icons;fonts;material-symbols;material-design</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="../Md3.Avalonia/Md3.Avalonia.csproj" />
    <AvaloniaResource Include="Assets/Fonts/MaterialSymbolsRounded.ttf" />
    <AvaloniaResource Include="Assets/Fonts/MaterialSymbolsRounded.codepoints" />
    <None Update="Assets/Fonts/MaterialSymbolsRounded-LICENSE.txt" Pack="true" PackagePath="licenses/MaterialSymbolsRounded-LICENSE.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
