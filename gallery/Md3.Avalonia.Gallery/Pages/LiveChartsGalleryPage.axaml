<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.LiveChartsGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="LiveCharts2 charts" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="LiveCharts2 charts drawn with Material roles: series take the palette, axes and grids the theme's inks and type scale, and tooltips and legends the inverse-surface card. Light and dark follow the core MaterialTheme variant." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Themed charts" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Both charts are stock LiveCharts2 views: nothing on the controls was set, so every fill, stroke, marker and corner arrives from the one theme the process configured." />
        <Border CornerRadius="12" Padding="4"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
          <Border CornerRadius="8" Padding="12" ClipToBounds="True"
                  Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
            <StackPanel Spacing="12">
              <lvc:CartesianChart x:Name="Cartesian" Height="300" />
              <lvc:PieChart x:Name="Pie" Height="300" />
            </StackPanel>
          </Border>
        </Border>
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Hover a point: the tooltip is the inverse-surface card with a drop shadow, and the legends are the same card." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Series palette" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Eight roles, in the order the theme walks them: four hues the way LiveCharts' own palette has, then four deeper tones of the same hues, so a chart with more than four series still reads as Material." />
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Primary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Primary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Tertiary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Tertiary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Secondary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Secondary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Error.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Error" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="PrimaryContainer" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="TertiaryContainer" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.InversePrimary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="InversePrimary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Outline.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Outline" />
          </StackPanel>
        </WrapPanel>

      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:ApiNotes Control="MaterialLiveChartsTheme" Members="AddMaterialTheme(LiveChartsSettings), ApplyMaterialRules(Theme), SeriesPalette(bool), SeriesPaletteRoles, Md.Sys.Color.*">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="Configure the theme once, at startup, before the first chart view exists: LiveCharts resolves every chart from the settings held by LiveCharts.DefaultSettings. Adding it on top of LiveCharts' own default theme keeps its tooltip and legend factories and its animations; a chart view's own ChartTheme, and a paint a series sets itself, still win." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <gallery:CodeExample XamlCode="&lt;lvc:CartesianChart Series=&quot;{Binding Series}&quot; XAxes=&quot;{Binding XAxes}&quot; YAxes=&quot;{Binding YAxes}&quot; /&gt;"
                            CSharpCode="// Once, before the first chart is created.&#10;LiveCharts.Configure(settings =&gt; settings.AddMaterialTheme());&#10;&#10;// An application that already builds its own theme appends the rules instead:&#10;settings.HasTheme(theme =&gt; theme&#10;    .HasDefaultTooltip(() =&gt; new SKDefaultTooltip())&#10;    .HasDefaultLegend(() =&gt; new SKDefaultLegend())&#10;    .ApplyMaterialRules());" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Mapping" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Axes take LabelMedium and the OnSurfaceVariant ink, grid lines are OutlineVariant, and the horizontal-only rule LiveCharts draws stays as it is. A line is a 3 DIP stroke with 8 DIP markers over the surface, upstream's area fill cleared; columns grow with a 4 DIP rounded end 6 DIP apart, while a stacked bar keeps square corners so its segments read as one bar. A donut is separated by the surface showing through, a gauge is a SurfaceContainerHighest track with a Primary indicator, and candlesticks take the third accent for rising and the error role for falling. Tooltips and legends are the inverse-surface card, and a chart's canvas is cleared to the card's surface." />
      </StackPanel>

    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
