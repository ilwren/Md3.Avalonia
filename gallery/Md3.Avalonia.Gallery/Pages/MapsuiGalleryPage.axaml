<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:mapsui="using:Mapsui.UI.Avalonia"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.MapsuiGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Map" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A Mapsui map drawn with Material roles: the canvas, the style an unstyled layer falls back to, the label chips and the eight-role palette all come from Md.Sys.* tokens." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h3" Text="Themed map" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A stock MapControl, themed once by the page and kept in step with the light/dark switch. Its four points live in memory, so it renders the same offline as online." />
        <Border CornerRadius="12" Padding="4" ClipToBounds="True"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
          <Border CornerRadius="8" ClipToBounds="True"
                  Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
            <mapsui:MapControl x:Name="DemoMap" Height="420" />
          </Border>
        </Border>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Layer palette" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="The eight roles a thematic layer takes its classes from, in the order ScottPlot and LiveCharts2 walk them: four hues, then four deeper tones of the same hues, so more than four classes still read as Material." />
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Primary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Primary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Tertiary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Tertiary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Secondary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Secondary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Error.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Error" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="PrimaryContainer" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="TertiaryContainer" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.InversePrimary.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="InversePrimary" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,10">
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Md.Sys.Color.Outline.Brush}" />
            <TextBlock Classes="body" VerticalAlignment="Center" Text="Outline" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:ApiNotes Control="MaterialMapsuiTheme" Members="Follow(MapControl), Apply(Map), VectorStyle(), LabelStyle(), SeriesPalette(bool), Md.Sys.Color.*">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="Follow() themes the map a control draws and keeps it in step with the variant; the vector and label styles are handed to a layer, and a layer whose style somebody chose keeps it. Nothing is registered in Application.Styles, so no map this package was not asked to style is touched." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <gallery:CodeExample XamlCode="&lt;mapsui:MapControl x:Name=&quot;DemoMap&quot; Height=&quot;420&quot; /&gt;"
                            CSharpCode="var theme = new MaterialMapsuiTheme(dark: false);&#10;&#10;// A layer takes the styles it is drawn with; a label reads its text off the feature.&#10;DemoMap.Map.Layers.Add(new MemoryLayer&#10;{&#10;    Name = &quot;Places&quot;,&#10;    Features = features,&#10;    Style = new StyleCollection { Styles = { theme.VectorStyle(), theme.LabelStyle() } },&#10;});&#10;&#10;// Once, in the page or window that owns the control.&#10;MaterialMapsuiTheme.Follow(DemoMap);" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Mapping" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Canvas Surface, so a map inside a card blends with it. A polygon boundary is a hairline in Outline, a line feature a heavier OnSurfaceVariant stroke, a region Primary at twelve percent, and a label a SurfaceContainer chip with an OutlineVariant border and the ExtraSmall corner. Mapsui's vector defaults - grey outline, white fill - are what an unstyled layer gives way from." />
      </StackPanel>

    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
