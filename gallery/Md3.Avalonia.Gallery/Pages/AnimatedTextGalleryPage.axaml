<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.AnimatedTextGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Animated text" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Text that reveals itself. Each effect runs over a fixed duration rather than a per-character tick, so the total time is predictable." />
      </StackPanel>

      <StackPanel Spacing="12">
        <StackPanel Spacing="12" HorizontalAlignment="Left">
          <eco:MdAnimatedText Text="Material motion, one character at a time" Effect="Typewriter" Duration="0:0:1.4" />
          <eco:MdAnimatedText Text="Fade and reveal" Effect="Fade" Duration="0:0:0.8" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Auto-size text" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="The text shrinks within a bounded area without changing the requested font size." />
        <md:MdCard Padding="20" HorizontalAlignment="Left">
          <Border Width="220" Height="64" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}" ClipToBounds="True">
            <eco:MdAutoSizeText Classes="verbatim" Text="MdAutoSizeText 123456789" FontSize="30" MinFontSize="10" MaxLines="1" />
          </Border>
        </md:MdCard>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Scrolling text" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Overflowing text scrolls continuously; reduced motion shows a static, trimmed label." />
        <md:MdCard Padding="20" HorizontalAlignment="Left">
          <Border Width="260" Height="48" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}">
            <eco:MdMarquee Padding="8,0" Speed="40" Gap="30" PauseAfterRound="0:0:1"
                Text="A long announcement scrolls across this small space while the full text remains accessible." />
          </Border>
        </md:MdCard>
        <gallery:CodeExample XamlCode="&lt;eco:MdMarquee Text=&quot;{Binding Announcement}&quot; Width=&quot;260&quot; Speed=&quot;40&quot; /&gt;" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Expandable text" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Long text can be collapsed by line or character count, then expanded with a separate button." />
        <md:MdCard Padding="20" HorizontalAlignment="Left">
          <eco:MdExpandableText Width="300" CollapsedLines="2"
              Text="Material components help organize information and actions. Expand this paragraph to read the rest of the example, and collapse it when you are done." />
        </md:MdCard>
        <gallery:CodeExample XamlCode="&lt;eco:MdExpandableText Text=&quot;{Binding Description}&quot; CollapsedLines=&quot;2&quot; /&gt;" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Celebration particles" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Trigger a finite burst; reduced motion skips the decorative particles." />
        <md:MdCard Padding="20" HorizontalAlignment="Left">
          <Grid Width="340" Height="160" ClipToBounds="True" Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}">
            <md:MdButton Content="Celebrate" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCelebrate" />
            <eco:MdConfetti x:Name="ConfettiOverlay" />
          </Grid>
        </md:MdCard>
        <gallery:CodeExample XamlCode="&lt;eco:MdConfetti x:Name=&quot;Celebration&quot; /&gt;" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdAnimatedText Text=&quot;{Binding Headline}&quot; Effect=&quot;Typewriter&quot; Duration=&quot;0:0:1.4&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
