<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <x:Double x:Key="Md.Comp.VideoPlayer.MinHeight">220</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.Media.MinHeight">220</x:Double>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.Container.Shape">20</CornerRadius>

  <!-- A quiet full-frame veil plus one elevated dock keeps controls legible without
       burying the video under the heavy multi-stop gradients common in older players. -->
  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.Controls.Scrim" Color="#3D000000" />
  <Thickness x:Key="Md.Comp.VideoPlayer.Controls.Padding">20</Thickness>
  <Thickness x:Key="Md.Comp.VideoPlayer.Compact.Controls.Padding">12</Thickness>
  <StaticResource x:Key="Md.Comp.VideoPlayer.Overlay.Foreground"
                  ResourceKey="Md.Sys.Color.InverseOnSurface.Brush" />
  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.Overlay.SecondaryForeground" Color="#C7FFFFFF" />

  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.TransportDock.Surface" Color="#D919191D" />
  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.TransportDock.Outline" Color="#26FFFFFF" />
  <CornerRadius x:Key="Md.Comp.VideoPlayer.TransportDock.Shape">20</CornerRadius>
  <Thickness x:Key="Md.Comp.VideoPlayer.TransportDock.Padding">14,8,10,8</Thickness>

  <x:Double x:Key="Md.Comp.VideoPlayer.CenterAction.Size">68</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.PosterIcon.Size">88</x:Double>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.PosterIcon.Shape">44</CornerRadius>
</ResourceDictionary>
