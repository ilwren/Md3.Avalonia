<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.DateRangePickerGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Date range picker" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Two linked date fields that validate against each other, with localized month and weekday names from the active gallery language." />
      </StackPanel>

      <StackPanel Width="720" HorizontalAlignment="Left" Spacing="12">
        <md:MdDateRangePicker x:Name="RangePicker" StartLabel="Start date" EndLabel="End date" />
        <TextBlock x:Name="RangeValue" Classes="body" Opacity="0.78" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdDateRangePicker StartDate=&quot;{Binding Start}&quot; EndDate=&quot;{Binding End}&quot;&#10;                      StartLabel=&quot;Start date&quot; EndLabel=&quot;End date&quot; /&gt;"
                            CSharpCode="var dates = new MdDateRangePicker { StartDate = DateTimeOffset.Now, EndDate = DateTimeOffset.Now.AddDays(7) };" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
