<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SearchGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Search"/><TextBlock Classes="body" Text="Search bars accept a query; search views expand the field into suggestions or results."/></StackPanel>
      <StackPanel Width="680" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Search bar"/>
        <md:MdSearchBar PlaceholderText="Search destinations" Text="Material" SearchSubmitted="OnSearchSubmitted"/>
      </StackPanel>
      <StackPanel Width="680" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Expanded search view"/>
        <md:MdButton Width="190" HorizontalAlignment="Left" Content="Open search · Ctrl+K" Variant="Outlined" Click="OpenExpandedSearch" />
        <md:MdSearchView x:Name="ExpandedSearchView" IsOpen="False">
          <md:MdSearchView.Header>
            <md:MdSearchBar x:Name="ExpandedSearchBar" PlaceholderText="Search files, folders, or types"
                            TextChanged="OnExpandedQueryChanged" SearchSubmitted="OnExpandedSearchSubmitted"/>
          </md:MdSearchView.Header>
          <Grid>
            <md:MdList x:Name="ExpandedSearchResults" SelectionChanged="OnExpandedResultSelected">
              <md:MdList.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" Text="{Binding Category}" />
                  </StackPanel>
                </DataTemplate>
              </md:MdList.ItemTemplate>
            </md:MdList>
            <TextBlock x:Name="NoSearchResults" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="False" Text="No matching files" />
          </Grid>
        </md:MdSearchView>
      </StackPanel>
      <TextBlock x:Name="SearchStatus" Classes="body" Text="Enter submits the focused search. Escape dismisses the expanded search view."/>
      <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="&lt;md:MdSearchBar Text=&quot;{Binding Query}&quot;&#10;                PlaceholderText=&quot;Search&quot;&#10;                SearchCommand=&quot;{Binding SearchCommand}&quot; /&gt;" CSharpCode="var search = new MdSearchBar { PlaceholderText = &quot;Search&quot; };&#10;search.SearchSubmitted += (_, query) =&gt; viewModel.Search(query);"/></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
