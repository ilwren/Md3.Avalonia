<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdMenuItem}" TargetType="md:MdMenuItem">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdMenuItem">
        <Border x:Name="PART_Container" MinHeight="{TemplateBinding MinHeight}" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Md.Comp.Menu.Container.Shape}" ClipToBounds="True">
          <Grid>
            <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <ContentPresenter x:Name="PART_Leading" Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center"
                                Content="{TemplateBinding LeadingContent}" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" IsVisible="False" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" FontSize="14" Foreground="{TemplateBinding Foreground}" />
              <ContentPresenter x:Name="PART_Trailing" Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding TrailingContent}"
                                FontSize="12" Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" IsVisible="False" />
            </Grid>
            <Border x:Name="PART_StateLayer" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsHitTestVisible="False" Opacity="0" />
            <md:MdRipplePresenter RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:has-leading /template/ ContentPresenter#PART_Leading"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:has-trailing /template/ ContentPresenter#PART_Trailing"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.38" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdMenu}" TargetType="md:MdMenu">
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdMenu">
        <Border Padding="{TemplateBinding Padding}" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}"
                BoxShadow="{DynamicResource Md.Sys.Elevation.Level2}" CornerRadius="{DynamicResource Md.Comp.Menu.Container.Shape}" ClipToBounds="True">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
