<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Material system foundations not owned by an individual component. -->
  <FontFamily x:Key="Md.Sys.Typeface.Brand">Arial</FontFamily>
  <FontFamily x:Key="Md.Sys.Typeface.Plain">Arial</FontFamily>

  <x:Double x:Key="Md.Sys.TypeScale.DisplayLarge.Size">57</x:Double><x:Double x:Key="Md.Sys.TypeScale.DisplayLarge.LineHeight">64</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.DisplayMedium.Size">45</x:Double><x:Double x:Key="Md.Sys.TypeScale.DisplayMedium.LineHeight">52</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.DisplaySmall.Size">36</x:Double><x:Double x:Key="Md.Sys.TypeScale.DisplaySmall.LineHeight">44</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.HeadlineLarge.Size">32</x:Double><x:Double x:Key="Md.Sys.TypeScale.HeadlineLarge.LineHeight">40</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.HeadlineMedium.Size">28</x:Double><x:Double x:Key="Md.Sys.TypeScale.HeadlineMedium.LineHeight">36</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.HeadlineSmall.Size">24</x:Double><x:Double x:Key="Md.Sys.TypeScale.HeadlineSmall.LineHeight">32</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.TitleLarge.Size">22</x:Double><x:Double x:Key="Md.Sys.TypeScale.TitleLarge.LineHeight">28</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.TitleMedium.Size">16</x:Double><x:Double x:Key="Md.Sys.TypeScale.TitleMedium.LineHeight">24</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.TitleSmall.Size">14</x:Double><x:Double x:Key="Md.Sys.TypeScale.TitleSmall.LineHeight">20</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.BodyLarge.Size">16</x:Double><x:Double x:Key="Md.Sys.TypeScale.BodyLarge.LineHeight">24</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.BodyMedium.Size">14</x:Double><x:Double x:Key="Md.Sys.TypeScale.BodyMedium.LineHeight">20</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.BodySmall.Size">12</x:Double><x:Double x:Key="Md.Sys.TypeScale.BodySmall.LineHeight">16</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.LabelLarge.Size">14</x:Double><x:Double x:Key="Md.Sys.TypeScale.LabelLarge.LineHeight">20</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.LabelMedium.Size">12</x:Double><x:Double x:Key="Md.Sys.TypeScale.LabelMedium.LineHeight">16</x:Double>
  <x:Double x:Key="Md.Sys.TypeScale.LabelSmall.Size">11</x:Double><x:Double x:Key="Md.Sys.TypeScale.LabelSmall.LineHeight">16</x:Double>

  <CornerRadius x:Key="Md.Sys.Shape.Corner.None">0</CornerRadius><CornerRadius x:Key="Md.Sys.Shape.Corner.ExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="Md.Sys.Shape.Corner.Small">8</CornerRadius><CornerRadius x:Key="Md.Sys.Shape.Corner.Medium">12</CornerRadius>
  <CornerRadius x:Key="Md.Sys.Shape.Corner.Large">16</CornerRadius><CornerRadius x:Key="Md.Sys.Shape.Corner.ExtraLarge">28</CornerRadius>
  <!-- The two steps M3 Expressive added after this scale was first frozen. Purely additive:
       nothing references them yet, and no existing corner value changes. -->
  <CornerRadius x:Key="Md.Sys.Shape.Corner.LargeIncreased">20</CornerRadius><CornerRadius x:Key="Md.Sys.Shape.Corner.ExtraLargeIncreased">32</CornerRadius>
  <CornerRadius x:Key="Md.Sys.Shape.Corner.Full">999</CornerRadius><x:Double x:Key="Md.Sys.Shape.Scale">1</x:Double>

  <x:Double x:Key="Md.Sys.Spacing.0">0</x:Double><x:Double x:Key="Md.Sys.Spacing.1">4</x:Double><x:Double x:Key="Md.Sys.Spacing.2">8</x:Double>
  <x:Double x:Key="Md.Sys.Spacing.3">12</x:Double><x:Double x:Key="Md.Sys.Spacing.4">16</x:Double><x:Double x:Key="Md.Sys.Spacing.5">20</x:Double>
  <x:Double x:Key="Md.Sys.Spacing.6">24</x:Double><x:Double x:Key="Md.Sys.Spacing.7">28</x:Double><x:Double x:Key="Md.Sys.Spacing.8">32</x:Double>
  <x:Double x:Key="Md.Sys.Spacing.9">36</x:Double><x:Double x:Key="Md.Sys.Spacing.10">40</x:Double><x:Double x:Key="Md.Sys.Spacing.11">44</x:Double><x:Double x:Key="Md.Sys.Spacing.12">48</x:Double>

  <x:Double x:Key="Md.Sys.State.Dragged.Opacity">0.16</x:Double><x:Double x:Key="Md.Sys.State.Disabled.ContentOpacity">0.38</x:Double><x:Double x:Key="Md.Sys.State.Disabled.ContainerOpacity">0.12</x:Double>
  <BoxShadows x:Key="Md.Sys.Elevation.Level5">0 8 14 3 #33000000</BoxShadows>
</ResourceDictionary>
