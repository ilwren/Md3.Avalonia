<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.FlutterParityGalleryPage">
  <Grid>
  <md:MdScrollViewer x:Name="StandalonePageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Flutter Material parity" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Flutter patterns that span several controls at once — forms, dialog flows, state restoration, adaptive surfaces, focus and shortcuts. Components that stand on their own have their own pages." />
      </StackPanel>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Form validation" />
        <md:MdForm x:Name="AccountForm" AutovalidateMode="OnUserInteraction" Submitted="FormSubmitted">
          <StackPanel Spacing="12">
            <md:MdFormField x:Name="NameField" IsRequired="True" SupportingText="Required display name">
              <md:MdTextBox Label="Display name" TextChanged="FormNameChanged" />
            </md:MdFormField>
            <md:MdDropdownFormField x:Name="RoleField" Label="Role" IsRequired="True" SupportingText="Choose one role" />
            <md:MdButton Width="120" HorizontalAlignment="Left" Content="Validate" Click="ValidateForm" />
          </StackPanel>
        </md:MdForm>
        <TextBlock x:Name="FormStatus" Classes="body" Text="Validation has not run." />
      </StackPanel>
      </Border>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <Grid Width="820" HorizontalAlignment="Left" ColumnDefinitions="*,*" ColumnSpacing="20">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Simple dialog" />
          <TextBlock Classes="body" Text="A modal account task blocks the page until an option or Cancel is chosen." />
          <md:MdButton Width="150" HorizontalAlignment="Left" Content="Choose account" Variant="Outlined" Click="OpenSimpleDialog" />
          <TextBlock x:Name="DialogStatus" Classes="body" Text="No account selected." />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="12">
          <TextBlock Classes="h2" Text="About and licenses" />
          <TextBlock Classes="body" Text="Open application details, then continue into a searchable license task and return." />
          <md:MdButton Width="140" HorizontalAlignment="Left" Content="About this app" Variant="Outlined" Click="OpenAboutDialog" />
          <TextBlock x:Name="LicenseStatus" Classes="body" Text="About dialog is closed." />
        </StackPanel>
      </Grid>
      </Border>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Restorable picker state" />
        <StackPanel Orientation="Horizontal" Spacing="12"><md:MdDatePicker x:Name="RestorableDate" Width="280" SelectedDate="2026-09-24" /><md:MdTimePicker x:Name="RestorableTime" Width="280" SelectedTime="10:15" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8"><md:MdButton Content="Save state" Variant="Outlined" Click="SavePickerState" /><md:MdButton Content="Clear values" Variant="Text" Click="ClearPickerValues" /><md:MdButton Content="Restore state" Variant="Text" Click="RestorePickerState" /></StackPanel>
        <TextBlock x:Name="RestorationStatus" Classes="body" Text="State is held by a provider-agnostic store." />
      </StackPanel>
      </Border>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Draggable scrollable sheet" />
        <Border Height="420" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" CornerRadius="20" ClipToBounds="True">
          <md:MdDraggableScrollableSheet x:Name="DraggableSheet" MinimumExtent="0.25" InitialExtent="0.5" MaximumExtent="1" Snap="True" ExtentChanged="SheetExtentChanged">
            <md:MdDraggableScrollableSheet.Header><TextBlock FontWeight="Medium" Text="Drag to resize · scroll after expansion" /></md:MdDraggableScrollableSheet.Header>
            <StackPanel Margin="16" Spacing="10"><TextBlock TextWrapping="Wrap" Text="The handle resizes the sheet. Nested wheel input expands/collapses at scroll boundaries." /><Border Height="100" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" CornerRadius="12" /><Border Height="100" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" CornerRadius="12" /><Border Height="100" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" CornerRadius="12" /></StackPanel>
          </md:MdDraggableScrollableSheet>
        </Border>
        <TextBlock x:Name="SheetStatus" Classes="body" Text="Extent 50%" />
      </StackPanel>
      </Border>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Soft keyboard avoidance host" />
        <TextBlock Classes="body" Text="Simulate a virtual keyboard inset to verify that the host automatically adjusts viewport bottom padding and scrolls focused text controls into view." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <md:MdButton Content="Toggle virtual keyboard" Variant="Outlined" Click="ToggleVirtualKeyboard" />
          <md:MdButton Content="Focus bottom input" Variant="Text" Click="FocusBottomInput" />
        </StackPanel>
        <Border Height="260" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" CornerRadius="16" ClipToBounds="True">
          <md:MdKeyboardAvoidingHost x:Name="DemoKeyboardHost" AutoScrollToFocused="True" ExtraBottomOffset="16">
            <md:MdScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16" Spacing="12">
                <TextBlock FontWeight="Medium" Text="Scrollable form area" />
                <md:MdTextBox Label="Top input" Text="First item" />
                <Border Height="80" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" CornerRadius="12" />
                <md:MdTextBox x:Name="BottomInput" Label="Bottom input" Text="Second item" />
                <Border Height="120" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" CornerRadius="12" />
              </StackPanel>
            </md:MdScrollViewer>
          </md:MdKeyboardAvoidingHost>
        </Border>
        <TextBlock x:Name="KeyboardStatus" Classes="body" Text="Virtual keyboard inactive (height: 0dp)." />
      </StackPanel>
      </Border>

      <Border Classes="gallery-section" Padding="24" Margin="0,0,16,16">
      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="h2" Text="Adaptive controls · cross-platform sync settings" />
        <TextBlock Classes="body" Text="The switches choose the platform policy. Run the same upload to compare Material and Cupertino progress metrics." />
        <WrapPanel>
          <md:MdAdaptiveSwitch x:Name="AutomaticAdaptiveSwitch" Content="Follow the current platform" IsChecked="True" Margin="0,0,20,12" Click="AdaptiveControlChanged" />
          <md:MdAdaptiveSwitch x:Name="CupertinoAdaptiveSwitch" Platform="Cupertino" Content="Preview iOS control metrics" Margin="0,0,20,12" Click="AdaptiveControlChanged" />
        </WrapPanel>
        <Border Padding="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="16">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock FontWeight="Medium" Text="Upload design tokens" />
              <TextBlock Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" Text="One task, rendered with two platform policies" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
              <md:MdAdaptiveProgressIndicator x:Name="MaterialAdaptiveProgress" Platform="Material" Value="0" Size="36" />
              <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Material" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
              <md:MdAdaptiveProgressIndicator x:Name="CupertinoAdaptiveProgress" Platform="Cupertino" Value="0" Size="36" />
              <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Cupertino" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdButton Content="Run sync comparison" Variant="Outlined" Click="RunAdaptiveSync" />
          <TextBlock x:Name="AdaptiveStatus" VerticalAlignment="Center" Classes="body" Text="Ready to upload." />
        </StackPanel>

        <TextBlock Classes="h2" Text="Focus, shortcut and Hero workflow" />
        <TextBlock Classes="body" Text="Use the focus controls, press Ctrl+Shift+S while this group is focused, or run the same command directly." />
        <md:MdFocusTraversalGroup x:Name="DemoFocusGroup" Cycle="True">
          <md:MdShortcutScope x:Name="ShortcutScope">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md:MdButton x:Name="FocusAlpha" Content="Alpha" Variant="Outlined" GotFocus="DemoControlFocused" />
                <md:MdButton x:Name="FocusBeta" Content="Beta" Variant="Outlined" GotFocus="DemoControlFocused" />
                <md:MdButton x:Name="FocusGamma" Content="Gamma" Variant="Outlined" GotFocus="DemoControlFocused" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md:MdButton Content="Focus first" Variant="Text" Click="FocusFirstControl" />
                <md:MdButton Content="Run Ctrl+Shift+S action" Variant="Text" Click="RunShortcutAction" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <md:MdHero x:Name="HeroSource" Tag="avatar"><Border Width="56" Height="56" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" CornerRadius="28"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="A" /></Border></md:MdHero>
                <md:MdButton Content="Move avatar" Variant="Outlined" Click="RequestHero" />
                <md:MdHero x:Name="HeroDestination" Tag="avatar" IsVisible="False"><Border Width="120" Height="120" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" CornerRadius="28"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" Text="A" /></Border></md:MdHero>
              </StackPanel>
            </StackPanel>
          </md:MdShortcutScope>
        </md:MdFocusTraversalGroup>
        <TextBlock x:Name="AdvancedStatus" Classes="body" Text="Focus and shortcut workflow is ready." />
      </StackPanel>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdExpansionPanelList AllowMultiple=&quot;False&quot;&gt;&#10;  &lt;md:MdExpansionPanel Header=&quot;Account&quot; IsExpanded=&quot;{Binding IsAccountOpen}&quot;&gt;&#10;    ...&#10;  &lt;/md:MdExpansionPanel&gt;&#10;&lt;/md:MdExpansionPanelList&gt;&#10;&#10;&lt;md:MdRefreshIndicator IsRefreshing=&quot;{Binding IsRefreshing}&quot;&#10;                       RefreshCommand=&quot;{Binding RefreshCommand}&quot;&gt;&#10;  &lt;md:MdScrollViewer&gt;...&lt;/md:MdScrollViewer&gt;&#10;&lt;/md:MdRefreshIndicator&gt;" CSharpCode="var stepper = new MdStepper { ActiveStep = 0, IsLinear = true };&#10;stepper.Items.Add(new MdStep { Header = &quot;Choose&quot;, Content = form });&#10;stepper.ContinueRequested += (_, step) =&gt; SaveStep(step);&#10;&#10;var table = new MdDataTable { ItemsSource = rows };&#10;table.SortRequested += (_, args) =&gt; Sort(args.Column, args.Direction);" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
  <md:MdDialogHost x:Name="ParityDialogHost" ZIndex="20" />
  </Grid>
</UserControl>
