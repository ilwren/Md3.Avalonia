<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SheetGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Sheets"/><TextBlock Classes="body" Text="Bottom and side sheets present supplementary content while preserving the current context."/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8"><md:MdButton Content="Bottom sheet" Variant="Filled" Click="ShowBottom"/><md:MdButton Content="Left side sheet" Variant="Tonal" Click="ShowLeft"/><md:MdButton Content="Right side sheet" Variant="Outlined" Click="ShowRight"/></StackPanel>
      <md:MdSheetHost x:Name="DemoSheet" Width="800" Height="420" HorizontalAlignment="Left">
        <Border Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" CornerRadius="24"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><md:MdIcon Glyph="{x:Static md:MdSymbols.Photo}" Size="48"/><TextBlock FontSize="22" Text="Page content"/></StackPanel></Border>
        <md:MdSheetHost.SheetContent>
          <StackPanel Spacing="16"><TextBlock FontSize="24" Text="Add to collection"/><TextBlock TextWrapping="Wrap" Text="Sheets keep an interaction in context and can be dismissed with Escape or the scrim."/><md:MdButton HorizontalAlignment="Right" Content="Done" Variant="Filled" Click="CloseSheet"/></StackPanel>
        </md:MdSheetHost.SheetContent>
      </md:MdSheetHost>
      <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="&lt;md:MdSheetHost IsOpen=&quot;{Binding IsSheetOpen}&quot; Placement=&quot;Bottom&quot;&gt;&#10;  &lt;md:MdSheetHost.SheetContent&gt;...&lt;/md:MdSheetHost.SheetContent&gt;&#10;  &lt;views:CurrentPage /&gt;&#10;&lt;/md:MdSheetHost&gt;" CSharpCode="sheet.Placement = MdSheetPlacement.Bottom;&#10;sheet.Show();&#10;sheet.Dismiss();"/></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
