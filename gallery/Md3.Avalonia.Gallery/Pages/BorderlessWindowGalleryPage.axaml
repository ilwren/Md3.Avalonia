<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.BorderlessWindowGalleryPage">
  <StackPanel MinHeight="1200" Spacing="28">
    <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Borderless windows" /><TextBlock Classes="body" TextWrapping="Wrap" Text="Extended client-area chrome keeps the platform resize frame, shadow and corner treatment while Material owns the caption content. This is a true chromeless client window: Material owns the surface, title bar, caption buttons and resize affordances without a second native title-bar line." /></StackPanel>
    <Border BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <md:MdWindowTitleBar Content="Material application" ShowIcon="False" />
        <Border Grid.Row="1" Height="220" Padding="24" Background="{DynamicResource Md.Sys.Color.Surface.Brush}"><StackPanel Spacing="12"><TextBlock Classes="h2" Text="Chrome preview" /><TextBlock Text="Open the real secondary window to validate dragging, double-click maximize/restore, caption actions, resize grips, and theme behavior." TextWrapping="Wrap" /><md:MdButton x:Name="OpenDemoButton" Content="Open borderless demo window" Variant="Filled" HorizontalAlignment="Left" Click="OpenDemoWindow" /></StackPanel></Border>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Padding="20" CornerRadius="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}"><StackPanel Spacing="8"><TextBlock Classes="h3" Text="Platform adapter" /><TextBlock x:Name="AdapterStatus" TextWrapping="Wrap" /><TextBlock Text="Applications may inject IMdWindowPlatformAdapter for native system menus or specialized hit testing without changing view models." TextWrapping="Wrap" /></StackPanel></Border>
      <Border Grid.Column="1" Padding="20" CornerRadius="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}"><StackPanel Spacing="8"><TextBlock Classes="h3" Text="Safety contract" /><TextBlock Text="Android resolves to a no-op adapter. Windows keeps WindowDecorations.Full for native DWM state animations; macOS/Linux keep the portable border frame. All desktop adapters extend the client area and use Avalonia move/resize APIs. Interactive title-bar children never start a drag." TextWrapping="Wrap" /></StackPanel></Border>
    </Grid>
        <gallery:ApiNotes Control="MdWindowTitleBar"
                        Members="LeadingContent, TrailingContent, Subtitle, ShowIcon, IconSource, ShowCaptionButtons, ShowMinimizeButton, ShowMaximizeButton, ShowCloseButton, IsMinimizeButtonEnabled, IsMaximizeButtonEnabled, IsCloseButtonEnabled">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="The window keeps the platform's resize frame, shadow and corner treatment; MdWindowTitleBar draws only the caption. LeadingContent and TrailingContent are yours to fill, Subtitle is the second line, and ShowCaptionButtons with the per-button Show*Button and Is*ButtonEnabled properties decide which buttons exist and which of them are live." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
    <StackPanel Spacing="10">
      <TextBlock Classes="h2" Text="Custom window parts" />
      <TextBlock Classes="body" TextWrapping="Wrap" Text="The real secondary window includes a draggable client region, caption actions and a bottom-right resize grip. These actions require a desktop window; Android does not support them." />
      <gallery:ApiNotes Control="MdWindowDragRegion, MdWindowResizeGrip, MdCaptionButton, MdWindowCaptionButton" Members="Edge, Kind" />
      <gallery:CodeExample XamlCode="&lt;!-- Inside an MdBorderlessWindow --&gt;&#10;&lt;Grid RowDefinitions=&quot;Auto,*&quot;&gt;&#10;  &lt;md:MdWindowDragRegion HorizontalContentAlignment=&quot;Stretch&quot;&gt;&#10;    &lt;Border Padding=&quot;12&quot; Background=&quot;{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}&quot;&gt;&#10;      &lt;TextBlock Text=&quot;Drag this client region&quot; /&gt;&#10;    &lt;/Border&gt;&#10;  &lt;/md:MdWindowDragRegion&gt;&#10;  &lt;md:MdCaptionButton Kind=&quot;Close&quot; Content=&quot;×&quot; HorizontalAlignment=&quot;Right&quot; /&gt;&#10;  &lt;md:MdWindowResizeGrip Grid.Row=&quot;1&quot; Edge=&quot;SouthEast&quot; HorizontalAlignment=&quot;Right&quot; VerticalAlignment=&quot;Bottom&quot; /&gt;&#10;&lt;/Grid&gt;" />
    </StackPanel>
    <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage" /><gallery:CodeExample XamlCode="&lt;md:MdBorderlessWindow Title=&quot;My app&quot;&gt;&#10;  &lt;views:Shell /&gt;&#10;&lt;/md:MdBorderlessWindow&gt;" CSharpCode="var window = new MdBorderlessWindow { Title = &quot;My app&quot; };&#10;window.PlatformAdapter = myOptionalNativeAdapter;&#10;window.SystemMenuRequested += (_, point) =&gt; ShowFallbackMenu(point);&#10;window.Show();" /></StackPanel>
  </StackPanel>
</UserControl>
