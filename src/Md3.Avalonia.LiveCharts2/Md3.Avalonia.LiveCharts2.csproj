<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Md3.Avalonia.Themes</RootNamespace>
    <AssemblyName>Md3.Avalonia.LiveCharts2</AssemblyName>
    <Description>Material Design 3 theme (colors, series palette and type scale) for LiveCharts2 charts in Avalonia. Opt-in package: it carries the LiveCharts2 Avalonia dependency so the core Material packages do not have to.</Description>
    <PackageId>Md3.Avalonia.LiveCharts2</PackageId>
    <Version>0.5.0-preview.1</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;charts;livecharts;data-visualization;theme;material-design-3</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- The Avalonia view: it brings LiveChartsCore, LiveChartsCore.SkiaSharpView (the Skia paints
         and geometries this theme writes) and Avalonia.Skia. There is no per-control seam in
         LiveCharts - the theme is configured once through LiveCharts.Configure - so this package is
         a configuration entry point rather than a Styles subclass. See README.md. -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
    <ProjectReference Include="../Md3.Avalonia/Md3.Avalonia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
