<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SideSheetGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Side sheet" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A sheet pinned to the left or right edge and collapsed to a floating button: the button stays put, the sheet grows out from behind it, and the content it was holding fades and slides in. Width, opacity and the chevron's turn all come from the shared motion tokens, so the sheet follows the same scheme and reduced-motion settings as everything else rather than carrying its own timings." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Both edges" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Anchor picks the edge the sheet is pinned to and slides out from, and the chevron points that way until the sheet is open. The sheet overlays the content beside it instead of replacing it, so opening one never re-lays-out the page underneath. Click either button." />
        <Border Height="280" ClipToBounds="True"
                CornerRadius="{DynamicResource Md.Sys.Shape.Corner.Large}"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}">
          <Panel>
            <TextBlock Classes="body" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="110,0"
                       Text="The page underneath. Opening a sheet overlays it and leaves its layout alone." />
            <eco:MdSideSheet x:Name="LeftSheet" Anchor="Left" Width="300" ExpandedWidth="280" HorizontalAlignment="Left">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="Narrow the list without leaving the page. The sheet keeps its own width, so nothing behind it has to move." />
            </eco:MdSideSheet>
            <eco:MdSideSheet x:Name="RightSheet" Anchor="Right" Width="300" ExpandedWidth="280" HorizontalAlignment="Right">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="Details about the current selection, one click away and one click back." />
            </eco:MdSideSheet>
          </Panel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Driven from elsewhere" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="IsOpen is two-way and Open, Close and Toggle are public, so a toolbar or a keyboard shortcut can drive a sheet that has no button of its own. IsToggleVisible=false takes the floating button away and leaves the state to the host." />
        <Border Height="170" ClipToBounds="True"
                CornerRadius="{DynamicResource Md.Sys.Shape.Corner.Large}"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}">
          <Panel>
            <eco:MdSideSheet x:Name="ExternalSheet" Anchor="Right" IsToggleVisible="False" Width="280" ExpandedWidth="256" HorizontalAlignment="Right">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="No floating button on this one. The control beside the panel owns its state." />
            </eco:MdSideSheet>
            <md:MdButton x:Name="ToggleExternal" Variant="Filled" Click="ToggleExternalClick"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Panel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdSideSheet Anchor=&quot;Left&quot;&#10;             IsOpen=&quot;{Binding FiltersOpen, Mode=TwoWay}&quot;&#10;             ExpandedWidth=&quot;320&quot;&#10;             Header=&quot;Filters&quot;&gt;&#10;  &lt;!-- whatever the sheet holds --&gt;&#10;&lt;/eco:MdSideSheet&gt;"
                             CSharpCode="// IsOpen is two-way, and the sheet raises IsOpenChanged.&#10;sheet.Toggle();&#10;sheet.IsOpenChanged += (_, open) =&gt; viewModel.FiltersOpen = open;&#10;&#10;// IsToggleVisible = false leaves the state to the host.&#10;sheet.IsToggleVisible = false;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
