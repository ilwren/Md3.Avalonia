<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.ResultViewGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Result view" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A full-surface outcome: empty, success, or error, with one primary action. Running the action here switches the surface from empty to success." />
      </StackPanel>

      <StackPanel Spacing="12">
        <eco:MdResultView x:Name="ResultView" Kind="Empty" Title="Nothing here yet"
                          Content="Create a record to see it in this result surface." ActionContent="Create record" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdResultView Kind=&quot;Empty&quot; Title=&quot;Nothing here yet&quot;&#10;                  ActionContent=&quot;Create record&quot; ActionCommand=&quot;{Binding CreateCommand}&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
