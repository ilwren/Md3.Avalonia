<!--
  Material Design 3 tokens for Dock.

  Derived from Dock.Avalonia.Themes.Fluent 11.3.12.1 Accents/Fluent.axaml (MIT, see
  THIRD-PARTY-NOTICES.md). The retokenized entries are the colours: Dock's five
  DockApplicationAccent* brushes and the DockTheme*/DockSurface*/DockBorder*/DockTab*/
  DockChrome*/DockTarget*/DockSplitter* aliases now resolve to Md.Sys.Color.* tokens, so light
  and dark both come from the Material theme variant and neither Avalonia's Fluent nor Dock's
  Fluent accents are required at runtime.

  Everything that is not a colour (metrics, geometries, booleans, the tab-strip items panel)
  is carried over verbatim so Dock's templates keep the exact shape they were written against;
  the only metric change is the M3 corner shape (extra-small 4 for tabs and the create button,
  small 8 for DockCornerRadiusSmall).
-->

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard"
                    xmlns:core="using:Dock.Model.Core">

    <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="{DynamicResource Md.Sys.Color.ErrorContainer}" />
    <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnPrimary}" />
    <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="{DynamicResource Md.Sys.Color.Primary}" />

    <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="{DynamicResource Md.Sys.Color.OutlineVariant}" />
    <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="{DynamicResource Md.Sys.Color.Surface}" />
    <SolidColorBrush x:Key="DockThemeAccentBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" />
    <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainerLow}" />
    <sys:Double x:Key="DockFontSizeNormal">12</sys:Double>

    <!-- Semantic token aliases shared across theme variants/presets -->
    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainerLow}" />
    <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainer}" />
    <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainerLowest}" />
    <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainerLow}" />
    <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource Md.Sys.Color.SurfaceContainerHigh}" />
    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="{DynamicResource Md.Sys.Color.SecondaryContainer}" />

    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="{DynamicResource Md.Sys.Color.OutlineVariant}" />
    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="{DynamicResource Md.Sys.Color.Outline}" />
    <SolidColorBrush x:Key="DockSeparatorBrush" Color="{DynamicResource Md.Sys.Color.OutlineVariant}" />
    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="{DynamicResource Md.Sys.Color.OutlineVariant}" />
    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockSplitterDragBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />

    <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" Opacity="0.08" />
    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockTabForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurfaceVariant}" />
    <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />
    <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnPrimary}" />
    <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" Opacity="0.08" />
    <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnPrimary}" />
    <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" />
    <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnPrimary}" />
    <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" />

    <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="{DynamicResource Md.Sys.Color.Primary}" />

    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" Opacity="0.08" />
    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurface}" Opacity="0.12" />
    <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="{DynamicResource Md.Sys.Color.ErrorContainer}" />

    <sys:Double x:Key="DockCornerRadiusSmall">8</sys:Double>
    <sys:Double x:Key="DockHeaderHeight">26</sys:Double>
    <sys:Double x:Key="DockTabHeight">30</sys:Double>
    <sys:Double x:Key="DockTabHorizontalPadding">10</sys:Double>
    <sys:Double x:Key="DockIconSizeSmall">12</sys:Double>
    <sys:Double x:Key="DockIconSizeNormal">14</sys:Double>

    <sys:Double x:Key="DockTabItemMinHeight">24</sys:Double>
    <sys:Double x:Key="DockDocumentTabItemMinHeight">24</sys:Double>
    <sys:Double x:Key="DockDocumentTabItemMinWidth">64</sys:Double>
    <sys:Double x:Key="DockToolTabItemMinHeight">0</sys:Double>
    <sys:Double x:Key="DockDocumentTabStripMinHeight">0</sys:Double>
    <sys:Double x:Key="DockDocumentTabStripLeadingSpacerWidth">0</sys:Double>
    <sys:Double x:Key="DockDocumentTabItemSeparatorOpacity">0</sys:Double>
    <Thickness x:Key="DockDocumentTabItemMargin">0</Thickness>
    <Thickness x:Key="DockDocumentTabItemPadding">4,0,4,0</Thickness>
    <CornerRadius x:Key="DockDocumentTabItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="DockDocumentTabCreateButtonCornerRadius">4</CornerRadius>
    <Thickness x:Key="DockToolTabItemPadding">4,1,4,0</Thickness>
    <Thickness x:Key="DockToolTabItemSelectedPadding">4,2,4,0</Thickness>
    <sys:Double x:Key="DockCreateButtonWidth">26</sys:Double>
    <sys:Double x:Key="DockCreateButtonHeight">24</sys:Double>
    <sys:Double x:Key="DockCloseButtonSize">14</sys:Double>
    <sys:Double x:Key="DockChromeButtonWidth">18</sys:Double>
    <sys:Double x:Key="DockChromeButtonHeight">16</sys:Double>
    <Thickness x:Key="DockChromeButtonPadding">3</Thickness>
    <Thickness x:Key="DockChromeButtonMargin">2,0,0,0</Thickness>
    <sys:Double x:Key="DockMdiTitleIconSize">12</sys:Double>
    <Thickness x:Key="DockMdiHeaderDragPadding">6,4</Thickness>
    <Thickness x:Key="DockHeaderContentPadding">2</Thickness>
    <Thickness x:Key="DockModifiedIndicatorMargin">0,0,2,0</Thickness>
    <sys:Double x:Key="DockTabContentSpacing">2</sys:Double>
    <sys:Double x:Key="DockDocumentTabHeaderContentSpacing">0</sys:Double>
    <Thickness x:Key="DockTabContentMargin">2</Thickness>
    <Thickness x:Key="DockCreateButtonIconMargin">5</Thickness>
    <Thickness x:Key="DockDocumentTabStripHorizontalCreateButtonMargin">0</Thickness>
    <Thickness x:Key="DockDocumentTabStripHorizontalScrollViewerMargin">0</Thickness>
    <Thickness x:Key="DockDocumentTabStripHorizontalScrollViewerPadding">0</Thickness>
    <Thickness x:Key="DockToolChromeHeaderMargin">8,0</Thickness>
    <Thickness x:Key="DockToolChromeTitleMargin">0,4,8,4</Thickness>
    <Thickness x:Key="DockToolChromeMenuIconMargin">2</Thickness>
    <sys:Double x:Key="DockToolChromeDividerThickness">1</sys:Double>
    <sys:Double x:Key="DockChromeGripHeight">5</sys:Double>
    <Thickness x:Key="DockChromeGripMargin">0,0,2,0</Thickness>
    <SolidColorBrush x:Key="DockChromeGripBrush" Color="Transparent" />
    <sys:Double x:Key="DockMdiHeaderColumnSpacing">4</sys:Double>
    <sys:Double x:Key="DockMdiButtonStripSpacing">2</sys:Double>
    <Thickness x:Key="DockMdiButtonStripMargin">2,0</Thickness>
    <sys:Double x:Key="DockMdiResizeEdgeThickness">4</sys:Double>
    <sys:Double x:Key="DockMdiResizeCornerSize">6</sys:Double>
    <sys:Double x:Key="DockTargetSelectorSize">40</sys:Double>
    <sys:Double x:Key="DockTargetSelectorGridMaxSize">125</sys:Double>
    <SolidColorBrush x:Key="DockSelectorOverlayBackdropBrush" Color="{DynamicResource Md.Sys.Color.Scrim.Standard.Brush}" />
    <CornerRadius x:Key="DockSelectorOverlayCornerRadius">6</CornerRadius>
    <Thickness x:Key="DockSelectorOverlayPadding">12</Thickness>
    <sys:Double x:Key="DockSelectorOverlayMinWidth">280</sys:Double>
    <sys:Double x:Key="DockSelectorOverlayMaxWidth">520</sys:Double>
    <sys:Double x:Key="DockSelectorOverlaySpacing">8</sys:Double>
    <sys:Double x:Key="DockSelectorOverlayListMinHeight">120</sys:Double>
    <sys:Double x:Key="DockSelectorOverlayListMaxHeight">320</sys:Double>
    <Thickness x:Key="DockSelectorOverlayItemPadding">6</Thickness>
    <CornerRadius x:Key="DockSelectorOverlayItemCornerRadius">4</CornerRadius>
    <sys:Double x:Key="DockSelectorOverlayBadgeSpacing">4</sys:Double>
    <Thickness x:Key="DockSelectorOverlayBadgeMargin">8,0,0,0</Thickness>
    <CornerRadius x:Key="DockSelectorOverlayBadgeCornerRadius">3</CornerRadius>
    <Thickness x:Key="DockSelectorOverlayBadgePadding">4,1</Thickness>
    <sys:Double x:Key="DockSelectorOverlayBadgeFontSize">10</sys:Double>
    <Thickness x:Key="DockCommandBarPadding">4,2</Thickness>
    <sys:Double x:Key="DockCommandBarSpacing">4</sys:Double>
    <CornerRadius x:Key="DockDragPreviewCornerRadius">4</CornerRadius>
    <Thickness x:Key="DockDragPreviewHeaderPadding">4</Thickness>
    <sys:Double x:Key="DockDragPreviewHeaderSpacing">4</sys:Double>
    <sys:Double x:Key="DockDragPreviewStatusSpacing">2</sys:Double>
    <sys:Double x:Key="DockDragPreviewStatusIconSize">10</sys:Double>
    <sys:Double x:Key="DockHostTitleBarMouseTrackerHeight">1</sys:Double>
    <Thickness x:Key="DockOverlayReloadButtonMargin">16</Thickness>
    <CornerRadius x:Key="DockOverlayCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="DockOverlayCardPadding">24</Thickness>
    <sys:Double x:Key="DockOverlayCardSpacing">8</sys:Double>
    <sys:Double x:Key="DockOverlayMessageFontSize">14</sys:Double>
    <sys:Double x:Key="DockOverlayProgressWidth">200</sys:Double>
    <sys:Double x:Key="DockOverlayProgressHeight">6</sys:Double>
    <CornerRadius x:Key="DockDialogCornerRadius">10</CornerRadius>
    <Thickness x:Key="DockDialogPadding">20</Thickness>
    <sys:Double x:Key="DockDialogMinWidth">360</sys:Double>
    <sys:Double x:Key="DockDialogMaxWidth">640</sys:Double>
    <sys:Double x:Key="DockDialogSpacing">12</sys:Double>
    <sys:Double x:Key="DockDialogTitleFontSize">16</sys:Double>
    <sys:Double x:Key="DockDialogCloseButtonSize">28</sys:Double>
    <Thickness x:Key="DockConfirmationDialogPadding">24</Thickness>
    <sys:Double x:Key="DockConfirmationDialogMaxWidth">480</sys:Double>
    <sys:Double x:Key="DockConfirmationDialogStackSpacing">12</sys:Double>
    <sys:Double x:Key="DockConfirmationDialogActionsSpacing">8</sys:Double>

    <!-- Brushes used by ToolChromeControl icons and grip -->
    <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="{DynamicResource Md.Sys.Color.OnSurfaceVariant}" />
    <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="{DynamicResource Md.Sys.Color.OnSurfaceVariant}" />

    <!-- Geometry resources for tool icons -->
    <StreamGeometry x:Key="DockIconAddDocumentGeometry">M8.41687 7.57953V2.41851C8.41687 2.18743 8.22932 1.99988 7.99823 1.99988C7.76715 1.99988 7.5796 2.18743 7.5796 2.41851V7.57953H2.41863C2.18755 7.57953 2 7.76708 2 7.99816C2 8.22925 2.18755 8.41679 2.41863 8.41679H7.5796V13.5812C7.5796 13.8123 7.76715 13.9999 7.99823 13.9999C8.22932 13.9999 8.41687 13.8123 8.41687 13.5812V8.41679L13.5799 8.41851C13.811 8.41851 13.9985 8.23096 13.9985 7.99988C13.9985 7.76879 13.811 7.58125 13.5799 7.58125L8.41687 7.57953Z</StreamGeometry>
    <StreamGeometry x:Key="DockIconCloseGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
    <StreamGeometry x:Key="DockIconMinimizeGeometry">M0,9L10,9L10,10L0,10Z</StreamGeometry>
    <StreamGeometry x:Key="DockToolIconCloseGeometry">M1169 1024l879 -879l-145 -145l-879 879l-879 -879l-145 145l879 879l-879 879l145 145l879 -879l879 879l145 -145z</StreamGeometry>
    <StreamGeometry x:Key="DockIconMaximizeGeometry">M0,0L0,9 9,9 9,0 0,0 0,3 8,3 8,8 1,8 1,3 0,3z</StreamGeometry>
    <StreamGeometry x:Key="DockIconRestoreGeometry">M0,10L0,3 3,3 3,0 10,0 10,2 4,2 4,3 7,3 7,6 6,6 6,5 1,5 1,10z M1,10L7,10 7,7 10,7 10,2 9,2 9,6 6,6 6,9 1,9z</StreamGeometry>
    <StreamGeometry x:Key="DockIconPinGeometry">m0 1345.575 218.834 0 0-1121.5042 0-177.2397 0-46.8138 673.827 0 416.57 0 32.417 0 0 1345.5577 230.153 0 0 224.0546-672.133 0 0 894.3935-225.764 0 0-894.3935-673.904 0 0-224.0546zm444.598-1121.4996 0 1121.4996 448.063 0 0-1121.4996-448.063 0z</StreamGeometry>
    <StreamGeometry x:Key="DockIconPinnedGeometry">m1119 0 0 218.834 1121.5042 0 177.2397 0 46.8138 0 0 673.827 0 416.57 0 32.417-1345.5577 0 0 230.153-224.0546 0 0-672.133-894.3935 0 0-225.764 894.3935 0 0-673.904zm1121.4996 444.598-1121.4996 0 0 448.063 1121.4996 0 0-448.063z</StreamGeometry>
    <StreamGeometry x:Key="DockIconMenuGeometry">M 352.041,32.0005L 320,0.000162761L 384,0.000162761L 352.041,32.0005 Z</StreamGeometry>
    <StreamGeometry x:Key="DockIconStatusDockGeometry">M8.41687 7.57953V2.41851C8.41687 2.18743 8.22932 1.99988 7.99823 1.99988C7.76715 1.99988 7.5796 2.18743 7.5796 2.41851V7.57953H2.41863C2.18755 7.57953 2 7.76708 2 7.99816C2 8.22925 2.18755 8.41679 2.41863 8.41679H7.5796V13.5812C7.5796 13.8123 7.76715 13.9999 7.99823 13.9999C8.22932 13.9999 8.41687 13.8123 8.41687 13.5812V8.41679L13.5799 8.41851C13.811 8.41851 13.9985 8.23096 13.9985 7.99988C13.9985 7.76879 13.811 7.58125 13.5799 7.58125L8.41687 7.57953Z</StreamGeometry>
    <StreamGeometry x:Key="DockIconStatusFloatGeometry">M0,0L0,9 9,9 9,0 0,0 0,3 8,3 8,8 1,8 1,3 0,3z</StreamGeometry>
    <sys:Double x:Key="DockDragPreviewFontSize">10</sys:Double>
    <Dock x:Key="DockDocumentTabStripHorizontalCreateButtonDock">Right</Dock>
    <HorizontalAlignment x:Key="DockDocumentTabStripHorizontalCreateButtonAlignment">Right</HorizontalAlignment>
    <core:DockOperation x:Key="DockDocumentControlIndicatorDockOperation">Fill</core:DockOperation>
    <x:Boolean x:Key="DockDocumentTabStripHideWhenEmpty">True</x:Boolean>
    <x:Boolean x:Key="DockDocumentTabStripToggleWindowStateOnDoubleTap">False</x:Boolean>
    <x:Boolean x:Key="DockDocumentControlTabStripVisible">True</x:Boolean>
    <x:Boolean x:Key="DockDocumentControlShowDockIndicatorOnly">False</x:Boolean>
    <x:Boolean x:Key="DockDocumentTabStripSeparatorVisible">True</x:Boolean>
    <sys:Double x:Key="DockDocumentControlVerticalSpacing">0</sys:Double>
    <sys:Double x:Key="DockDocumentTabStripSeparatorSize">2</sys:Double>
    <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="{DynamicResource Md.Sys.Color.OutlineVariant}" />
    <Thickness x:Key="DockDocumentContentBorderThickness">1,1,1,1</Thickness>
    <ItemsPanelTemplate x:Key="DockDocumentTabStripHorizontalItemsPanel">
      <StackPanel Orientation="Horizontal" ClipToBounds="False" />
    </ItemsPanelTemplate>

</ResourceDictionary>
