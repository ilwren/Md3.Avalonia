<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>io.arena.md3avalonia.gallery</ApplicationId>
    <ApplicationVersion>12</ApplicationVersion>
    <ApplicationDisplayVersion>0.5.6-preview.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="../Md3.Avalonia.Gallery/Md3.Avalonia.Gallery.csproj" AdditionalProperties="IncludeAndroidTarget=true" />
  </ItemGroup>
  <!-- A generic net10.0 asset compiles on Android but uses the desktop backend. Fail the build
       if project resolution ever silently selects it instead of the Android-specific asset. -->
  <Target Name="VerifyAndroidNotificationBackend" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_NotificationReference Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Md3.Avalonia.Notifications'" />
    </ItemGroup>
    <Error Condition="'@(_NotificationReference)' == ''" Text="The Android notification assembly was not resolved." />
    <Error Condition="!$([System.String]::Copy('@(_NotificationReference)').Contains('net10.0-android'))" Text="Android Gallery must resolve the Android-specific notification assembly, not the generic desktop backend: @(_NotificationReference)" />
  </Target>
</Project>
