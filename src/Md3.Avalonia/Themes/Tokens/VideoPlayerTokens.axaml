<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MdDecision: Material has no first-party video player. These component tokens compose
       standard media transport, touch-target, surface, and shape guidance without choosing a
       decoder backend. -->
  <CornerRadius x:Key="Md.Comp.VideoPlayer.Container.Shape">24</CornerRadius>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.Media.Shape">20,20,0,0</CornerRadius>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.Controls.Shape">0,0,20,20</CornerRadius>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.PosterIcon.Shape">28</CornerRadius>
  <Thickness x:Key="Md.Comp.VideoPlayer.Controls.Padding">16,12</Thickness>
  <Thickness x:Key="Md.Comp.VideoPlayer.Compact.Controls.Padding">10,8</Thickness>
  <x:Double x:Key="Md.Comp.VideoPlayer.MinHeight">300</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.Media.MinHeight">220</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.PosterIcon.Size">72</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.Transport.Spacing">8</x:Double>
</ResourceDictionary>
