<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdSegmentedButton}" TargetType="md:MdSegmentedButton">
    <Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="72" /><Setter Property="Padding" Value="16,0" />
    <Setter Property="SelectedIcon" Value="{DynamicResource Md.Icon.Check}" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Outline.Brush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdSegmentedButton">
        <Border x:Name="PART_Root" MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ContainerCornerRadius}" ClipToBounds="True">
          <Grid>
            <!-- State and ripple live outside the content margin so single- and multi-selection
                 segments paint the complete rounded hit container, including its former padding. -->
            <Border x:Name="PART_State" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsHitTestVisible="False" Opacity="0" />
            <md:MdRipplePresenter RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
            <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
              <Grid x:Name="PART_IconHost" Width="18" IsVisible="False">
                <md:MdSymbolPresenter x:Name="PART_SelectedIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectedIcon}"
                                      FontSize="18" Foreground="{TemplateBinding Foreground}" IsVisible="False" Opacity="0" />
                <md:MdSymbolPresenter x:Name="PART_Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      FontSize="18" Foreground="{TemplateBinding Foreground}" IsVisible="False" />
              </Grid>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- The icon slot only occupies layout when something is actually drawn in it. SelectedIcon
         defaults to the Material checkmark, so keying the slot on :has-selected-icon kept a
         permanent 18+8 DIP gutter and pushed every unselected label off centre. Material 3 centres
         an unselected label and brings the checkmark in on selection. -->
    <Style Selector="^:has-icon /template/ Grid#PART_IconHost"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ Grid#PART_IconHost"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:has-icon /template/ md|MdSymbolPresenter#PART_Icon"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:has-selected-icon /template/ md|MdSymbolPresenter#PART_SelectedIcon"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ md|MdSymbolPresenter#PART_SelectedIcon"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ md|MdSymbolPresenter#PART_Icon"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_State"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_State"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.38" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type md:MdSegmentedButtonGroup}" TargetType="md:MdSegmentedButtonGroup">
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="-1" /></ItemsPanelTemplate></Setter>
    <Setter Property="Template"><ControlTemplate TargetType="md:MdSegmentedButtonGroup"><ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate></Setter>
  </ControlTheme>
</ResourceDictionary>
