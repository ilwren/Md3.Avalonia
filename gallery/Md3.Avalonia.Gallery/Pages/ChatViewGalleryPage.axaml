<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.ChatViewGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Chat view" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A message list with selection, quoting, retry and attachments surfaced as commands and events. The provider behind it is yours." />
      </StackPanel>

      <StackPanel Spacing="12">
        <eco:MdChatView x:Name="Chat" Height="560" MessageSubmitted="ChatSubmitted"
                        MessageSelectionChanged="ChatSelectionChanged" DeleteRequested="ChatDeleteRequested"
                        QuoteRequested="ChatQuoteRequested" RetryRequested="ChatRetryRequested" />
        <TextBlock x:Name="ChatStatus" Classes="body" TextWrapping="Wrap" Text="Select one or more bubbles to quote, cancel, or delete. Failed bubbles expose Retry; suggestions fill the composer." />
      </StackPanel>

      <StackPanel Spacing="10">
        <gallery:ApiNotes Control="MdChatView"
                        Members="MessagesSource, ComposerText, SuggestionsSource, SendCommand, AttachmentCommand, QuoteMessageCommand, RetryMessageCommand, DeleteMessagesCommand, IsBusy, AllowMultipleSelection, SelectionCount, QuotedMessage">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="The provider behind it is yours: MessagesSource is the list of bubbles, SuggestionsSource fills the composer, and SendCommand, AttachmentCommand, QuoteMessageCommand, RetryMessageCommand and DeleteMessagesCommand are the hooks it calls. Selection and quoting are explicit API too - ToggleMessageSelection, QuoteSelected, ClearSelection, CancelQuote and DeleteSelected - so a failed bubble's Retry is the same path as a fresh send, driven by IsBusy rather than by a local spinner." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdChatView MessagesSource=&quot;{Binding Messages}&quot; SendCommand=&quot;{Binding SendCommand}&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
