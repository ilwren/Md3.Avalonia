<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.BadgeGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="30">
    <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Badges"/><TextBlock Classes="body" Text="Badges show notification counts or status on icons and destinations."/></StackPanel>
    <StackPanel Spacing="16">
      <TextBlock Classes="h2" Text="Small and large badges" />
      <StackPanel Orientation="Horizontal" Spacing="52" Margin="12">
        <md:MdBadgedBox><md:MdIconButton Icon="{x:Static md:MdSymbols.Mail}" Variant="Tonal"/></md:MdBadgedBox>
        <md:MdBadgedBox Badge="3" BadgeVariant="Label"><md:MdIconButton Icon="{x:Static md:MdSymbols.Mail}" Variant="Tonal"/></md:MdBadgedBox>
        <md:MdBadgedBox Badge="24" BadgeVariant="Label"><md:MdIconButton Icon="{x:Static md:MdSymbols.Notifications}" Variant="Filled"/></md:MdBadgedBox>
        <md:MdBadgedBox Badge="999+" BadgeVariant="Label"><md:MdIconButton Icon="{x:Static md:MdSymbols.Notifications}" Variant="Outlined"/></md:MdBadgedBox>
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="16">
      <TextBlock Classes="h2" Text="Standalone anatomy" />
      <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
        <md:MdBadge />
        <md:MdBadge Variant="Label" Content="1" />
        <md:MdBadge Variant="Label" Content="12" />
        <md:MdBadge Variant="Label" Content="999+" />
      </StackPanel>
    </StackPanel>
    <Border Padding="22" CornerRadius="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
      <TextBlock Classes="body" TextWrapping="Wrap" Text="Small badges are 6 DIP. Large badges are 16 DIP high, use the Error/OnError roles, and expand horizontally for multiple characters." />
    </Border>
    <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="&lt;md:MdBadgedBox Badge=&quot;3&quot; BadgeVariant=&quot;Label&quot;&gt;&#10;  &lt;md:MdIconButton Icon=&quot;{x:Static md:MdSymbols.Notifications}&quot; /&gt;&#10;&lt;/md:MdBadgedBox&gt;" CSharpCode="var badge = new MdBadgedBox&#10;{&#10;    Badge = &quot;3&quot;,&#10;    BadgeVariant = MdBadgeVariant.Label,&#10;    Content = new MdIconButton { Icon = MdSymbols.Notifications }&#10;};" /></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
