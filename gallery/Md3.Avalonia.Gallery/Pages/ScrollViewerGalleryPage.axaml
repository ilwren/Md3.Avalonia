<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.ScrollViewerGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Scrolling surface" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="MdScrollViewer is the Material scrolling surface used by every page in this gallery. It themes the scrollbar and overscroll without restyling Avalonia's ScrollViewer globally." />
      </StackPanel>

      <StackPanel Spacing="12">
        <md:MdScrollViewer Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 1" />
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 2" />
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 3" />
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 4" />
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 5" />
            <md:MdSurface Padding="14" Variant="ContainerLow" Content="Scrollable item 6" />
          </StackPanel>
        </md:MdScrollViewer>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Standalone scrollbar" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="This scrollbar controls a sample value, not the scrolling surface above. Change its visibility and interaction policies below." />
        <md:MdScrollBar x:Name="StandaloneBar" Orientation="Horizontal" Height="28" Minimum="0" Maximum="100" Value="35" ViewportSize="20" LargeChange="10" ThumbVisibility="Always" IsTrackVisible="True" />
        <WrapPanel>
          <md:MdButton x:Name="AlwaysButton" Content="Always" Variant="Text" Click="ShowAlways" />
          <md:MdButton x:Name="AutoButton" Content="Auto" Variant="Text" Click="ShowAuto" />
          <md:MdButton x:Name="HiddenButton" Content="Hidden" Variant="Text" Click="ShowHidden" />
          <md:MdButton x:Name="InteractiveButton" Content="Toggle interaction" Variant="Text" Click="ToggleInteraction" />
        </WrapPanel>
        <TextBlock x:Name="ScrollbarStatus" Classes="body" TextWrapping="Wrap" />
        <gallery:ApiNotes Control="MdScrollBar" Members="Value, Minimum, Maximum, ViewportSize, ThumbVisibility, IsTrackVisible, IsInteractive" />
        <gallery:CodeExample XamlCode="&lt;md:MdScrollBar Orientation=&quot;Horizontal&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; ThumbVisibility=&quot;Always&quot; IsTrackVisible=&quot;True&quot; /&gt;" />
      </StackPanel>

      <StackPanel Spacing="10">
        <gallery:ApiNotes Control="MdScrollViewer"
                        Members="IsDragScrollingEnabled, AllowMouseDrag, DragThreshold, Friction">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="It is a plain Avalonia ScrollViewer under the Material bar and overscroll, so nothing about scrolling changes - only how it looks. The four extra properties are the touch ones: IsDragScrollingEnabled turns drag-to-scroll on, AllowMouseDrag extends it to the mouse, DragThreshold decides when a drag becomes a scroll, and Friction is the deceleration after release." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdScrollViewer VerticalScrollBarVisibility=&quot;Auto&quot; HorizontalScrollBarVisibility=&quot;Disabled&quot;&gt;&#10;  &lt;StackPanel&gt;...&lt;/StackPanel&gt;&#10;&lt;/md:MdScrollViewer&gt;"
                            CSharpCode="var scroll = new MdScrollViewer { Content = longContent };" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
