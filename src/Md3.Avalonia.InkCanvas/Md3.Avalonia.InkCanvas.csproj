<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Md3.Avalonia.Themes</RootNamespace>
    <AssemblyName>Md3.Avalonia.InkCanvas</AssemblyName>
    <Description>Material Design 3 theme for the DotNetCampus.AvaloniaInkCanvas handwriting canvas, plus MdSignaturePad, a signature pad built on it. Opt-in package: it carries the ink canvas dependency so the core Material packages do not have to.</Description>
    <PackageId>Md3.Avalonia.InkCanvas</PackageId>
    <Version>0.5.6-preview.1</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;ink;handwriting;signature;stylus;pen;drawing;theme;material-design-3</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- InkCanvas draws itself with Skia and has no style collection to register, so the theme for a
         bare canvas is an entry point that writes its settings, the way the Mapsui and ScottPlot
         themes do. SkiaSharp types are used directly here and arrive transitively from this
         reference, which is how the LiveCharts2 theme already consumes them. -->
    <PackageReference Include="DotNetCampus.AvaloniaInkCanvas" />
    <ProjectReference Include="../Md3.Avalonia/Md3.Avalonia.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
