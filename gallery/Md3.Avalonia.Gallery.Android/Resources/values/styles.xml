<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- AvaloniaMainActivity derives from AppCompatActivity, so its Android theme must inherit
       from Theme.AppCompat. A platform android:style/Theme.Material parent crashes before the
       Avalonia view can be created. -->
  <style name="MyTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:colorAccent">#6750A4</item>
    <item name="android:navigationBarColor">#FFFBFE</item>
    <item name="android:statusBarColor">#FFFBFE</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>
</resources>
