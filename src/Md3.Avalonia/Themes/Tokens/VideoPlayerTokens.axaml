<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MdDecision: Material has no first-party video player. These tokens combine Material shape,
       touch-target and motion guidance with the in-picture transport pattern used by mature
       Flutter players such as media_kit and Chewie, without choosing a decoder backend. -->
  <CornerRadius x:Key="Md.Comp.VideoPlayer.Container.Shape">24</CornerRadius>
  <CornerRadius x:Key="Md.Comp.VideoPlayer.PosterIcon.Shape">28</CornerRadius>
  <Thickness x:Key="Md.Comp.VideoPlayer.Controls.Padding">20,18</Thickness>
  <Thickness x:Key="Md.Comp.VideoPlayer.Compact.Controls.Padding">12,10</Thickness>
  <x:Double x:Key="Md.Comp.VideoPlayer.MinHeight">300</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.Media.MinHeight">260</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.PosterIcon.Size">72</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.CenterAction.Size">64</x:Double>
  <x:Double x:Key="Md.Comp.VideoPlayer.Transport.Spacing">7</x:Double>
  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.Overlay.Foreground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Md.Comp.VideoPlayer.Overlay.SecondaryForeground" Color="#D9FFFFFF" />
  <LinearGradientBrush x:Key="Md.Comp.VideoPlayer.Controls.Scrim"
                       StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="0.42" Color="#12000000" />
    <GradientStop Offset="0.72" Color="#8F000000" />
    <GradientStop Offset="1" Color="#E0000000" />
  </LinearGradientBrush>
</ResourceDictionary>
