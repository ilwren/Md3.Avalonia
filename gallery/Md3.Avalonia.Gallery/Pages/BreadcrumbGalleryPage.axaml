<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:extra="using:Md3.Avalonia.Extra.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.BreadcrumbGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Breadcrumbs" />
        <TextBlock Classes="body" Text="Breadcrumbs display the current location within a hierarchy and enable fast multi-level navigation back to parent destinations." />
      </StackPanel>

      <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="12">
        <TextBlock Classes="h2" Text="Interactive breadcrumb" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Clicking a parent segment navigates to it and drops everything below, which is what a breadcrumb is for. The trailing segment is the current location: it has no hover state and no hand cursor." />
        <Border Padding="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="16">
          <extra:MdBreadcrumb x:Name="DemoBreadcrumb" Separator="›" ItemInvoked="OnBreadcrumbItemInvoked" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <md:MdButton Content="Reset path" Variant="Outlined" Click="OnResetPath" />
          <TextBlock x:Name="BreadcrumbStatus" VerticalAlignment="Center" Classes="body" Text="Click any breadcrumb segment to navigate to it." />
        </StackPanel>
      </StackPanel>

      <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="12">
        <TextBlock Classes="h2" Text="Breadcrumb with icons and slash separator" />
        <Border Padding="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="16">
          <extra:MdBreadcrumb x:Name="IconBreadcrumb" Separator="/" OverflowBehavior="Scroll" ItemInvoked="OnIconBreadcrumbInvoked" />
        </Border>
      </StackPanel>

      <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="12">
        <TextBlock Classes="h2" Text="Collapsed deep path" />
        <Border Padding="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="16">
          <extra:MdBreadcrumb x:Name="DeepBreadcrumb" Separator="›"
                              OverflowBehavior="Collapse" MaxDisplayedItems="4"
                              ItemsBeforeCollapse="1" ItemsAfterCollapse="2"
                              ItemInvoked="OnDeepBreadcrumbInvoked" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;extra:MdBreadcrumb ItemsSource=&quot;{Binding PathSegments}&quot;&#10;                 Separator=&quot;›&quot;&#10;                 ItemInvoked=&quot;OnBreadcrumbInvoked&quot; /&gt;"
                             CSharpCode="var breadcrumb = new MdBreadcrumb&#10;{&#10;    ItemsSource = new[] { &quot;Home&quot;, &quot;Documents&quot;, &quot;Projects&quot;, &quot;Material 3&quot; },&#10;    Separator = &quot;›&quot;&#10;};&#10;breadcrumb.ItemInvoked += (_, item) =&gt; NavigateTo(item);" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
