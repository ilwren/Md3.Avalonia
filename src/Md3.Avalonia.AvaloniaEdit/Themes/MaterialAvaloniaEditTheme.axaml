5.30675 12.9218 5.18319 12.7654C5.06106 12.6071 5 12.3966 5 12.1341C5 11.5791 5.25359 11.2588 5.76078 11.1732L6.35991 11.0698C6.35991 10.757 6.22917 10.6006 5.96767 10.6006C5.70474 10.6006 5.45474 10.702 5.21767 10.905V10.2402C5.3125 10.1769 5.44181 10.121 5.6056 10.0726C5.77083 10.0242 5.92098 10 6.05603 10C6.68534 10 7 10.4069 7 11.2207V12.9302ZM6.35991 11.7682V11.5754L5.95905 11.6425C5.73779 11.6797 5.62716 11.8091 5.62716 12.0307C5.62716 12.1313 5.65374 12.2142 5.7069 12.2793C5.76149 12.3426 5.83477 12.3743 5.92672 12.3743C6.0546 12.3743 6.15876 12.3175 6.23922 12.2039C6.31968 12.0885 6.35991 11.9432 6.35991 11.7682ZM9.26165 13C9.58343 13 9.82955 12.9423 10 12.8268V12.1173C9.81999 12.2551 9.636 12.324 9.44803 12.324C9.23616 12.324 9.06969 12.2523 8.94863 12.1089C8.82756 11.9637 8.76702 11.7644 8.76702 11.5112C8.76702 11.2505 8.82995 11.0466 8.95579 10.8994C9.08323 10.7505 9.25528 10.676 9.47192 10.676C9.66627 10.676 9.84229 10.7449 10 10.8827V10.1341C9.87097 10.0447 9.66229 10 9.37395 10C8.95659 10 8.62286 10.1406 8.37276 10.4218C8.12425 10.7011 8 11.0838 8 11.5698C8 11.9907 8.11629 12.3343 8.34887 12.6006C8.58144 12.8669 8.8857 13 9.26165 13ZM2 9L3 8H12L13 9V14L12 15H3L2 14V9ZM3 9V14H12V9H3ZM6 7L7 6H14L15 7V12L14 13V12V7H7H6Z</StreamGeometry>

      <!-- =====================================================================================
           Inner controls the editor instantiates. Every one is keyed, never registered for the
           native type, so nothing outside the editor is affected.
           ===================================================================================== -->

      <!-- Compact M3 text field: the search and replace inputs. 32 DIP, filled, with the
           InnerLeftContent / InnerRightContent slots the search panel puts its option toggles in. -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.SearchFieldTheme" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Md.Sys.Color.PrimarySelection.Brush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.ExtraSmall}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{DynamicResource Md.Sys.TypeScale.BodyMedium.Size}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="TextBox">
            <Border Name="PART_Border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding InnerLeftContent}" />
                <Panel Grid.Column="1">
                  <ScrollViewer Name="PART_ScrollViewer"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled">
                    <Panel>
                      <TextBlock Name="PART_Placeholder"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Foreground="{TemplateBinding PlaceholderForeground}"
                                 IsHitTestVisible="False"
                                 Text="{TemplateBinding PlaceholderText}"
                                 TextWrapping="NoWrap">
                        <TextBlock.IsVisible>
                          <Binding Converter="{x:Static StringConverters.IsNullOrEmpty}"
                                   Path="Text"
                                   RelativeSource="{RelativeSource TemplatedParent}" />
                        </TextBlock.IsVisible>
                      </TextBlock>
                      <TextPresenter Name="PART_TextPresenter"
                                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                     CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                     CaretBrush="{TemplateBinding CaretBrush}"
                                     CaretIndex="{TemplateBinding CaretIndex}"
                                     SelectionBrush="{TemplateBinding SelectionBrush}"
                                     SelectionEnd="{TemplateBinding SelectionEnd}"
                                     SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                     SelectionStart="{TemplateBinding SelectionStart}"
                                     Text="{TemplateBinding Text, Mode=TwoWay}"
                                     TextAlignment="{TemplateBinding TextAlignment}"
                                     TextWrapping="NoWrap" />
                    </Panel>
                  </ScrollViewer>
                  <Border Name="PART_Indicator"
                          Height="1"
                          VerticalAlignment="Bottom"
                          Background="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                  <Border Name="PART_FocusIndicator"
                          Height="2"
                          VerticalAlignment="Bottom"
                          Background="{DynamicResource Md.Sys.Color.Primary.Brush}"
                          IsVisible="False" />
                </Panel>
                <ContentPresenter Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding InnerRightContent}" />
              </Grid>
            </Border>
            <Style Selector="^:focus-visible /template/ Border#PART_FocusIndicator">
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:disabled">
              <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Disabled.ContentOpacity}" />
            </Style>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- State-layer button for the search actions (find previous/next, close, replace). -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.SearchActionButtonTheme" TargetType="Button">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.Full}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Border Name="PART_Container"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid>
                <Border Name="PART_StateLayer"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <ContentPresenter Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Hover.Opacity}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Pressed.Opacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Focus.Opacity}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Disabled.ContentOpacity}" />
        </Style>
      </ControlTheme>

      <!-- The match-case / whole-word / regex option toggles inside the search field. -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.SearchOptionToggleTheme" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.ExtraSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ToggleButton">
            <Border Name="PART_Container"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid>
                <Border Name="PART_StateLayer"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <ContentPresenter Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="{TemplateBinding Content}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
          <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Hover.Opacity}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Pressed.Opacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Focus.Opacity}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Disabled.ContentOpacity}" />
        </Style>
      </ControlTheme>

      <!-- The chevron that reveals the replace row, rotated when checked. -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.SearchExpanderTheme" TargetType="ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.Full}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ToggleButton">
            <Border Name="PART_Container"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid>
                <Border Name="PART_StateLayer"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <Path Name="PART_Chevron"
                      Margin="4"
                      Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.Chevron}"
                      Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center"
                      Stretch="Uniform"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1"
                      VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#PART_Chevron">
          <Setter Property="RenderTransform">
            <TransformGroup>
              <RotateTransform Angle="90" />
              <TranslateTransform X="-2" />
            </TransformGroup>
          </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Hover.Opacity}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Pressed.Opacity}" />
        </Style>
      </ControlTheme>

      <!-- The small up/down affordances of the overload viewer. Upstream keeps these deliberately
           tiny (12 DIP), so this theme only supplies the ink and the state layer. -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.OverloadStepButtonTheme" TargetType="Button">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.ExtraSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Border Name="PART_Container"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Grid>
                <Border Name="PART_StateLayer"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <ContentPresenter HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="{TemplateBinding Content}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Hover.Opacity}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_StateLayer">
          <Setter Property="Opacity" Value="{DynamicResource Md.Sys.State.Pressed.Opacity}" />
        </Style>
      </ControlTheme>

      <!-- Completion list rows. -->
      <ControlTheme x:Key="Md.Comp.AvaloniaEdit.CompletionListItemTheme" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.ExtraSmall}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ListBoxItem">
            <Border Name="PART_Container"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Container">
          <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Container">
          <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
        </Style>
      </ControlTheme>

      <!-- =====================================================================================
           The editor's own control themes.
           ===================================================================================== -->

      <ControlTheme x:Key="{x:Type ae:TextEditor}" TargetType="ae:TextEditor">
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="SearchResultsBrush" Value="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
          <ControlTemplate TargetType="ae:TextEditor">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <!-- Upstream's code casts this part to ScrollViewer, so MdScrollViewer keeps the
                   contract while supplying the Material scrollbars the core package scopes to
                   Md.* instead of installing globally. -->
              <md:MdScrollViewer Name="PART_ScrollViewer"
                                 Focusable="False"
                                 HorizontalContentAlignment="Left"
                                 HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                 Padding="{TemplateBinding Padding}"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type editing:TextArea}" TargetType="editing:TextArea">
        <Setter Property="SelectionBrush" Value="{DynamicResource Md.Sys.Color.PrimarySelection.Brush}" />
        <Setter Property="SelectionForeground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="editing:TextArea">
            <DockPanel Background="{TemplateBinding Background}" Focusable="False">
              <ItemsControl DockPanel.Dock="Left"
                            Focusable="False"
                            ItemsSource="{TemplateBinding LeftMargins}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Panel>
                <ContentPresenter Name="PART_CP"
                                  Background="{TemplateBinding Background}"
                                  Cursor="IBeam"
                                  Focusable="False" />
                <TextBlock Name="PART_Watermark"
                           Foreground="{TemplateBinding Foreground}"
                           IsHitTestVisible="False"
                           Opacity="0.5"
                           Text="{TemplateBinding Watermark}">
                  <TextBlock.IsVisible>
                    <Binding Converter="{x:Static StringConverters.IsNullOrEmpty}"
                             Path="Document.Text"
                             RelativeSource="{RelativeSource TemplatedParent}" />
                  </TextBlock.IsVisible>
                </TextBlock>
              </Panel>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Search panel: floating M3 surface in the editor's top-right corner. -->
      <ControlTheme x:Key="{x:Type search:SearchPanel}" TargetType="search:SearchPanel">
        <Setter Property="FontFamily" Value="{DynamicResource Md.Sys.Typeface.Plain}" />
        <Setter Property="FontSize" Value="{DynamicResource Md.Sys.TypeScale.BodyMedium.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="search:SearchPanel">
            <Border Name="PART_Border"
                    Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}"
                    BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource Md.Sys.Elevation.Level2}"
                    CornerRadius="{DynamicResource Md.Sys.Shape.Corner.Medium}"
                    HorizontalAlignment="Right"
                    Margin="0,0,18,0"
                    Padding="8"
                    VerticalAlignment="Top">
              <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                <ToggleButton Name="Expander"
                              Grid.Column="0"
                              Grid.Row="0"
                              Width="20"
                              Height="20"
                              HorizontalAlignment="Left"
                              IsVisible="{Binding !TextEditor.IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                              IsChecked="{Binding IsReplaceMode, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Margin="0,0,5,0"
                              Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchExpanderTheme}"
                              VerticalAlignment="Center">
                  <ToolTip.Tip>
                    <TextBlock Text="{x:Static ae:SR.SearchToggleReplace}" />
                  </ToolTip.Tip>
                </ToggleButton>

                <StackPanel Grid.Column="2"
                            Grid.Row="0"
                            Orientation="Horizontal">
                  <TextBox Name="PART_searchTextBox"
                           Grid.Column="1"
                           Grid.Row="0"
                           Width="265"
                           PlaceholderText="{x:Static ae:SR.SearchLabel}"
                           Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}}"
                           Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchFieldTheme}">
                    <TextBox.InnerRightContent>
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton IsChecked="{Binding $parent[search:SearchPanel].MatchCase, Mode=TwoWay}"
                                      Margin="0,0,2,0"
                                      Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchOptionToggleTheme}"
                                      ToolTip.Tip="{x:Static ae:SR.SearchMatchCaseText}"
                                      VerticalAlignment="Center">
                          <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.MatchCase}"
                                Fill="{Binding $parent[ToggleButton].Foreground}"
                                HorizontalAlignment="Center"
                                Stroke="{Binding $parent[ToggleButton].Foreground}"
                                StrokeThickness="1"
                                Stretch="UniformToFill"
                                VerticalAlignment="Center"
                                Width="12" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding $parent[search:SearchPanel].WholeWords, Mode=TwoWay}"
                                      Margin="2,0,2,0"
                                      Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchOptionToggleTheme}"
                                      ToolTip.Tip="{x:Static ae:SR.SearchMatchWholeWordsText}"
                                      VerticalAlignment="Center">
                          <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.WholeWords}"
                                Fill="{Binding $parent[ToggleButton].Foreground}"
                                HorizontalAlignment="Center"
                                Stroke="{Binding $parent[ToggleButton].Foreground}"
                                StrokeThickness="1"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Width="14" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding $parent[search:SearchPanel].UseRegex, Mode=TwoWay}"
                                      Margin="2,0,0,0"
                                      Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchOptionToggleTheme}"
                                      ToolTip.Tip="{x:Static ae:SR.SearchUseRegexText}"
                                      VerticalAlignment="Center">
                          <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.Regex}"
                                Fill="{Binding $parent[ToggleButton].Foreground}"
                                HorizontalAlignment="Center"
                                Stroke="{Binding $parent[ToggleButton].Foreground}"
                                StrokeThickness="1"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Width="12" />
                        </ToggleButton>
                      </StackPanel>
                    </TextBox.InnerRightContent>
                  </TextBox>

                  <Button Command="{x:Static search:SearchCommands.FindPrevious}"
                          Margin="5,0,0,0"
                          Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchActionButtonTheme}"
                          VerticalAlignment="Stretch">
                    <ToolTip.Tip>
                      <TextBlock Text="{x:Static ae:SR.SearchFindPreviousText}" />
                    </ToolTip.Tip>
                    <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.FindPrevious}"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Width="16" />
                  </Button>
                  <Button Command="{x:Static search:SearchCommands.FindNext}"
                          Margin="3,0,0,0"
                          Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchActionButtonTheme}"
                          VerticalAlignment="Stretch">
                    <ToolTip.Tip>
                      <TextBlock Text="{x:Static ae:SR.SearchFindNextText}" />
                    </ToolTip.Tip>
                    <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.FindNext}"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Width="16" />
                  </Button>
                  <Button Command="{x:Static search:SearchCommands.CloseSearchPanel}"
                          Focusable="True"
                          Margin="3,0,0,0"
                          Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchActionButtonTheme}"
                          VerticalAlignment="Stretch">
                    <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.Close}"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Width="12" />
                  </Button>
                </StackPanel>

                <StackPanel Name="ReplaceButtons"
                            Grid.Column="2"
                            Grid.Row="1"
                            Margin="0,5,0,0"
                            Orientation="Horizontal"
                            IsVisible="{Binding #Expander.IsChecked}">
                  <TextBox Name="PART_replaceTextBox"
                           Grid.Column="1"
                           Grid.Row="1"
                           Width="265"
                           PlaceholderText="{x:Static ae:SR.ReplaceLabel}"
                           IsVisible="{Binding IsReplaceMode, RelativeSource={RelativeSource TemplatedParent}}"
                           Text="{Binding ReplacePattern, RelativeSource={RelativeSource TemplatedParent}}"
                           Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchFieldTheme}" />
                  <Button Command="{x:Static search:SearchCommands.ReplaceNext}"
                          Margin="5,0,0,0"
                          Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchActionButtonTheme}"
                          VerticalAlignment="Stretch">
                    <ToolTip.Tip>
                      <TextBlock Text="{x:Static ae:SR.SearchReplaceNext}" />
                    </ToolTip.Tip>
                    <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.ReplaceNext}"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          VerticalAlignment="Center"
                          Width="12" />
                  </Button>
                  <Button Command="{x:Static search:SearchCommands.ReplaceAll}"
                          Margin="3,0,0,0"
                          Theme="{StaticResource Md.Comp.AvaloniaEdit.SearchActionButtonTheme}"
                          VerticalAlignment="Stretch">
                    <ToolTip.Tip>
                      <TextBlock Text="{x:Static ae:SR.SearchReplaceAll}" />
                    </ToolTip.Tip>
                    <Path Data="{StaticResource Md.Comp.AvaloniaEdit.Icon.ReplaceAll}"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Width="18" />
                  </Button>
                </StackPanel>

                <StackPanel Name="PART_MessageView"
                            Grid.Column="2"
                            Grid.Row="2"
                            IsVisible="False"
                            Margin="0,5,0,0"
                            Orientation="Horizontal">
                  <TextBlock Name="PART_MessageContent"
                             FontSize="{DynamicResource Md.Sys.TypeScale.LabelMedium.Size}"
                             Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                </StackPanel>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Completion list: M3 surface with the completion rows. -->
      <ControlTheme x:Key="{x:Type cc:CompletionListBox}" TargetType="cc:CompletionListBox">
        <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource Md.Comp.AvaloniaEdit.CompletionListItemTheme}" />
        <Setter Property="Template">
          <ControlTemplate TargetType="cc:CompletionListBox">
            <Border Background="{TemplateBinding Background}"
                    BoxShadow="{DynamicResource Md.Sys.Elevation.Level2}"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource Md.Sys.Shape.Corner.Small}">
              <md:MdScrollViewer Name="PART_ScrollViewer"
                                 HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                 VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </md:MdScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type cc:CompletionList}" TargetType="cc:CompletionList">
        <Setter Property="Template">
          <ControlTemplate TargetType="cc:CompletionList">
            <cc:CompletionListBox Name="PART_ListBox">
              <cc:CompletionListBox.ItemTemplate>
                <DataTemplate x:DataType="cc:ICompletionData">
                  <StackPanel Margin="0" Orientation="Horizontal">
                    <Image Height="16"
                           Margin="0,0,2,0"
                           Source="{Binding Image}"
                           Width="16" />
                    <ContentControl Content="{Binding Content}" />
                  </StackPanel>
                </DataTemplate>
              </cc:CompletionListBox.ItemTemplate>
            </cc:CompletionListBox>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Completion tooltip surface. -->
      <ControlTheme x:Key="{x:Type cc:CompletionTipContentControl}" TargetType="cc:CompletionTipContentControl">
        <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Md.Sys.Shape.Corner.ExtraSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
          <ControlTemplate TargetType="cc:CompletionTipContentControl">
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Overload viewer: same surface as the completion tooltip. -->
      <ControlTheme x:Key="{x:Type cc:OverloadViewer}" TargetType="cc:OverloadViewer">
        <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
          <ControlTemplate TargetType="cc:OverloadViewer">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            IsVisible="{Binding Provider.Count, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static cc:CollapseIfSingleOverloadConverter.Instance}}"
                            Margin="0,0,4,0"
                            Orientation="Horizontal">
                  <Button Name="PART_UP" Theme="{StaticResource Md.Comp.AvaloniaEdit.OverloadStepButtonTheme}">
                    <Path Data="M 0,0.866 L 1,0.866 L 0.5,0 Z"
                          Fill="{Binding #PART_UP.Foreground}"
                          Stretch="UniformToFill"
                          Stroke="{Binding #PART_UP.Foreground}" />
                  </Button>
                  <TextBlock Margin="2,0,2,0"
                             Text="{Binding Provider.CurrentIndexText, RelativeSource={RelativeSource TemplatedParent}}"
                             VerticalAlignment="Center" />
                  <Button Name="PART_DOWN" Theme="{StaticResource Md.Comp.AvaloniaEdit.OverloadStepButtonTheme}">
                    <Path Data="M 0,0 L 1,0 L 0.5,0.866 Z"
                          Fill="{Binding #PART_DOWN.Foreground}"
                          Stretch="UniformToFill"
                          Stroke="{Binding #PART_DOWN.Foreground}" />
                  </Button>
                </StackPanel>
                <ContentPresenter Grid.Row="0"
                                  Grid.Column="1"
                                  Content="{Binding Provider.CurrentHeader, RelativeSource={RelativeSource TemplatedParent}}"
                                  VerticalAlignment="Center" />
                <ContentPresenter Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="{Binding Provider.CurrentContent, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>
</Styles>
