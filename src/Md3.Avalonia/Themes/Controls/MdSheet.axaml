<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdSheetHost}" TargetType="md:MdSheetHost">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdSheetHost">
        <Grid ClipToBounds="True">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Grid x:Name="PART_Layer" IsVisible="False">
            <Border x:Name="PART_Scrim" Background="{DynamicResource Md.Sys.Color.Scrim.Brush}" Opacity="0" />
            <Border x:Name="PART_Surface" Height="{TemplateBinding SheetExtent}" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" BoxShadow="{DynamicResource Md.Sys.Elevation.Level2}" CornerRadius="28,28,0,0"
                    Opacity="0">
              <Grid RowDefinitions="Auto,*">
                <Border x:Name="PART_DragHandle" Grid.Row="0" Width="64" Height="32" Margin="0,0,0,4"
                        AutomationProperties.Name="Drag down to dismiss" Cursor="SizeNorthSouth"
                        HorizontalAlignment="Center" Background="Transparent">
                  <Border Width="32" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Background="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" CornerRadius="2" />
                </Border>
                <ContentPresenter Grid.Row="1" Content="{TemplateBinding SheetContent}" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:present /template/ Grid#PART_Layer"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:open /template/ Border#PART_Surface"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:modal:open /template/ Border#PART_Scrim"><Setter Property="Opacity" Value="0.32" /></Style>
    <Style Selector="^:left /template/ Border#PART_Surface"><Setter Property="Width" Value="{Binding SheetExtent, RelativeSource={RelativeSource TemplatedParent}}" /><Setter Property="Height" Value="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="0,28,28,0" /></Style>
    <Style Selector="^:right /template/ Border#PART_Surface"><Setter Property="Width" Value="{Binding SheetExtent, RelativeSource={RelativeSource TemplatedParent}}" /><Setter Property="Height" Value="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="28,0,0,28" /></Style>
    <Style Selector="^:left /template/ Border#PART_DragHandle"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:right /template/ Border#PART_DragHandle"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>
</ResourceDictionary>
