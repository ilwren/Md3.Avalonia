<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MdDecision: Material has no first-party file browser component. These component tokens
       compose its app-bar, breadcrumb, list, selection, and touch-target guidance into a
       responsive browser. -->
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Container.Shape">28</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Path.Shape">18</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.List.Shape">20</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Item.Shape">16</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Icon.Shape">14</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Mode.Shape">12</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Selection.Shape">16</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.State.Shape">18</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Footer.Shape">20</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Compact.List.Shape">16</CornerRadius>
  <Thickness x:Key="Md.Comp.FileSystemPicker.Content.Padding">20</Thickness>
  <Thickness x:Key="Md.Comp.FileSystemPicker.Compact.Content.Padding">12</Thickness>
  <Thickness x:Key="Md.Comp.FileSystemPicker.Item.Padding">10</Thickness>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Path.MinHeight">56</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Item.MinHeight">76</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Item.ContentMinHeight">56</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Icon.ContainerSize">48</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.QuickAccess.Width">184</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Section.Spacing">12</x:Double>
</ResourceDictionary>
