<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.FabGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="26" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Floating action buttons"/>
        <TextBlock Classes="body" Text="FABs represent the most important action on a screen; FAB menus expose two to six related actions with left or right alignment."/>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="FAB sizes"/>
        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Add}" Size="Small"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Add}"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Add}" Size="Medium"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Add}" Size="Large"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Color styles"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Edit}"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Edit}" ColorStyle="SecondaryContainer"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Edit}" ColorStyle="TertiaryContainer"/>
          <md:MdFloatingActionButton Icon="{x:Static md:MdSymbols.Edit}" ColorStyle="Primary"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Extended FAB"/>
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <md:MdExtendedFloatingActionButton Content="Create" Icon="{x:Static md:MdSymbols.Add}"/>
          <md:MdExtendedFloatingActionButton Content="Compose" Icon="{x:Static md:MdSymbols.Edit}" Size="Medium" ColorStyle="SecondaryContainer"/>
          <md:MdExtendedFloatingActionButton Content="Navigate" Icon="{x:Static md:MdSymbols.ArrowBack}" Size="Large" ColorStyle="TertiaryContainer"/>
        </StackPanel>
      </StackPanel>

      <Border Classes="gallery-section" Padding="24" MinHeight="260">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
          <!-- Left Aligned FAB Menu -->
          <md:MdFabMenu Grid.Column="0" Alignment="Left" VerticalAlignment="Bottom" ColorStyle="SecondaryContainer">
            <md:MdFabMenuItem Content="Scanner" Icon="{x:Static md:MdSymbols.QrCodeScanner}"/>
            <md:MdFabMenuItem Content="Attachment" Icon="{x:Static md:MdSymbols.AttachFile}"/>
            <md:MdFabMenuItem Content="Voice" Icon="{x:Static md:MdSymbols.Mic}"/>
          </md:MdFabMenu>

          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,0">
            <TextBlock Classes="h2" Text="FAB menu alignment" HorizontalAlignment="Center"/>
            <TextBlock Classes="body" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" Text="Click either round trigger to play the reversible expand/collapse motion. Set Alignment=&quot;Left&quot; or &quot;Right&quot; to orient the trigger and actions accordingly."/>
          </StackPanel>

          <!-- Right Aligned FAB Menu -->
          <md:MdFabMenu Grid.Column="2" Alignment="Right" VerticalAlignment="Bottom">
            <md:MdFabMenuItem Content="Photo" Icon="{x:Static md:MdSymbols.Photo}"/>
            <md:MdFabMenuItem Content="Document" Icon="{x:Static md:MdSymbols.Description}"/>
            <md:MdFabMenuItem Content="Link" Icon="{x:Static md:MdSymbols.Link}"/>
          </md:MdFabMenu>
        </Grid>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage"/>
        <gallery:CodeExample XamlCode="&lt;!-- Right aligned FAB menu --&gt;&#10;&lt;md:MdFabMenu Alignment=&quot;Right&quot;&gt;&#10;    &lt;md:MdFabMenuItem Content=&quot;Photo&quot; Icon=&quot;{x:Static md:MdSymbols.Photo}&quot; /&gt;&#10;    &lt;md:MdFabMenuItem Content=&quot;Document&quot; Icon=&quot;{x:Static md:MdSymbols.Description}&quot; /&gt;&#10;&lt;/md:MdFabMenu&gt;&#10;&#10;&lt;!-- Left aligned FAB menu --&gt;&#10;&lt;md:MdFabMenu Alignment=&quot;Left&quot;&gt;&#10;    &lt;md:MdFabMenuItem Content=&quot;Voice&quot; Icon=&quot;{x:Static md:MdSymbols.Mic}&quot; /&gt;&#10;&lt;/md:MdFabMenu&gt;" CSharpCode="var rightMenu = new MdFabMenu { Alignment = MdFabAlignment.Right };&#10;var leftMenu = new MdFabMenu { Alignment = MdFabAlignment.Left };" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
