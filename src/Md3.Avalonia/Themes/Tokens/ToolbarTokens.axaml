<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Material toolbar component tokens. Standard density preserves 48-DIP action targets. -->
  <x:Double x:Key="Md.Comp.Toolbar.Floating.Height">64</x:Double>
  <x:Double x:Key="Md.Comp.Toolbar.Docked.Height">64</x:Double>
  <x:Double x:Key="Md.Comp.Toolbar.Compact.Height">56</x:Double>
  <Thickness x:Key="Md.Comp.Toolbar.Floating.Padding">12,8</Thickness>
  <Thickness x:Key="Md.Comp.Toolbar.Docked.Padding">16,8</Thickness>
  <Thickness x:Key="Md.Comp.Toolbar.Compact.Padding">8,4</Thickness>
  <x:Double x:Key="Md.Comp.Toolbar.ActionSpacing">8</x:Double>
  <x:Double x:Key="Md.Comp.Toolbar.Compact.ActionSpacing">4</x:Double>
  <CornerRadius x:Key="Md.Comp.Toolbar.Floating.Shape">32</CornerRadius>
</ResourceDictionary>
