<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.FocusShortcutHeroGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Focus, shortcut and Hero" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A focus traversal group cycles with Tab, a shortcut scope binds Ctrl+Shift+S while the group holds focus, and MdHero flies an element between two positions." />
      </StackPanel>

      <StackPanel Width="820" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Classes="body" Text="Use the focus controls, press Ctrl+Shift+S while this group is focused, or run the same command directly." />
        <md:MdFocusTraversalGroup x:Name="DemoFocusGroup" Cycle="True">
          <md:MdShortcutScope x:Name="ShortcutScope">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md:MdButton x:Name="FocusAlpha" Content="Alpha" Variant="Outlined" GotFocus="DemoControlFocused" />
                <md:MdButton x:Name="FocusBeta" Content="Beta" Variant="Outlined" GotFocus="DemoControlFocused" />
                <md:MdButton x:Name="FocusGamma" Content="Gamma" Variant="Outlined" GotFocus="DemoControlFocused" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <md:MdButton Content="Focus first" Variant="Text" Click="FocusFirstControl" />
                <md:MdButton Content="Run Ctrl+Shift+S action" Variant="Text" Click="RunShortcutAction" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <md:MdHero x:Name="HeroSource" Tag="avatar"><Border Width="56" Height="56" Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" CornerRadius="28"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="A" /></Border></md:MdHero>
                <md:MdButton Content="Move avatar" Variant="Outlined" Click="RequestHero" />
                <md:MdHero x:Name="HeroDestination" Tag="avatar" IsVisible="False"><Border Width="120" Height="120" Background="{DynamicResource Md.Sys.Color.TertiaryContainer.Brush}" CornerRadius="28"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" Text="A" /></Border></md:MdHero>
              </StackPanel>
            </StackPanel>
          </md:MdShortcutScope>
        </md:MdFocusTraversalGroup>
        <TextBlock x:Name="AdvancedStatus" Classes="body" Text="Focus and shortcut workflow is ready." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdFocusTraversalGroup Cycle=&quot;True&quot;&gt;&#10;  &lt;md:MdShortcutScope x:Name=&quot;ShortcutScope&quot;&gt;&#10;    &lt;md:MdHero x:Name=&quot;HeroSource&quot; Tag=&quot;avatar&quot;&gt;...&lt;/md:MdHero&gt;&#10;  &lt;/md:MdShortcutScope&gt;&#10;&lt;/md:MdFocusTraversalGroup&gt;"
                            CSharpCode="ShortcutScope.Register(new KeyGesture(Key.S, KeyModifiers.Control | KeyModifiers.Shift),&#10;                       new RelayCommand(RunAction));&#10;await HeroSource.TransitionToAsync(HeroDestination);" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
