<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <StreamGeometry x:Key="Md.FileSystemPicker.FolderGeometry">M3 6.5C3 5.67 3.67 5 4.5 5H9L11 7H19.5C20.33 7 21 7.67 21 8.5V18.5C21 19.33 20.33 20 19.5 20H4.5C3.67 20 3 19.33 3 18.5Z</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.FileGeometry">M6 3H14L19 8V21H6ZM13 4.5V9H17.5</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.UpGeometry">M5 14L12 7L19 14M12 7V20</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.RefreshGeometry">M20 11A8 8 0 1 1 17.66 5.34L20 7.68M20 3V8H15</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.HomeGeometry">M3.5 10.5L12 3.5L20.5 10.5V20H14.5V14H9.5V20H3.5Z</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.StorageGeometry">M4 5H20V19H4ZM4 9H20M16.5 14.5H17.5</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.EditGeometry">M4 20L5 15.5L15.8 4.7C16.45 4.05 17.5 4.05 18.15 4.7L19.3 5.85C19.95 6.5 19.95 7.55 19.3 8.2L8.5 19ZM14.5 6L18 9.5</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.CheckGeometry">M5 12.5L10 17.5L19 7.5</StreamGeometry>
  <StreamGeometry x:Key="Md.FileSystemPicker.ChevronGeometry">M8.5 5L15.5 12L8.5 19</StreamGeometry>

  <!-- A breadcrumb is a contiguous navigation trail, not a row of 48-DIP MdButton containers.
       This scoped button keeps the full 40-DIP path bar hit area without injecting horizontal
       minimum widths between Powerline segments. -->
  <ControlTheme x:Key="MdFileSystemBreadcrumbButtonTheme" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Grid MinHeight="{TemplateBinding MinHeight}" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" />
          <Border x:Name="PART_StateLayer" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                  IsHitTestVisible="False" Opacity="0" />
          <Border x:Name="PART_FocusIndicator" Margin="2"
                  BorderBrush="{DynamicResource Md.Sys.Color.Primary.Brush}" BorderThickness="2"
                  CornerRadius="6" IsHitTestVisible="False" Opacity="0" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusIndicator"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^.current"><Setter Property="Cursor" Value="Arrow" /></Style>
    <Style Selector="^.current /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="MdFileSystemPickerItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource Md.Comp.FileSystemPicker.Item.MinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Md.Comp.FileSystemPicker.Item.Padding}" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Md.Comp.FileSystemPicker.Item.Shape}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="PART_Container"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_StateLayer"
                    Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                    IsHitTestVisible="False" Opacity="0" />
            <md:MdRipplePresenter RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
            <Border x:Name="PART_FocusIndicator" Margin="2"
                    BorderBrush="{DynamicResource Md.Sys.Color.Primary.Brush}"
                    BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" Opacity="0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnPrimaryContainer.Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusIndicator"><Setter Property="Opacity" Value="1" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdFileSystemPicker}" TargetType="md:MdFileSystemPicker">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdFileSystemPicker">
        <Border x:Name="PART_Container"
                Padding="{DynamicResource Md.Comp.FileSystemPicker.Content.Padding}"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerHigh.Brush}"
                CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Container.Shape}">
          <Grid RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="{DynamicResource Md.Comp.FileSystemPicker.Section.Spacing}">
            <!-- NFile-inspired hierarchy: app-bar title/path first, compact actions at the edge. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
              <md:MdIconButton x:Name="PART_UpButton" Grid.Column="0"
                               IsEnabled="{TemplateBinding CanGoUp}"
                               AutomationProperties.Name="{TemplateBinding ParentFolderText}" ToolTip.Tip="{TemplateBinding ParentFolderText}">
                <md:MdIconButton.Icon>
                  <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource Md.FileSystemPicker.UpGeometry}"
                            Stroke="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                            StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </md:MdIconButton.Icon>
              </md:MdIconButton>

              <StackPanel Grid.Column="1" Margin="8,2,8,2" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="PART_Title"
                           FontSize="{DynamicResource Md.Sys.TypeScale.TitleLarge.Size}"
                           LineHeight="{DynamicResource Md.Sys.TypeScale.TitleLarge.LineHeight}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Md.Sys.Color.OnSurface.Brush}"
                           Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="{DynamicResource Md.Sys.TypeScale.BodySmall.Size}"
                           Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                           Text="{TemplateBinding CurrentDirectory}" TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <md:MdIconButton x:Name="PART_CompactHomeButton" Grid.Column="2" IsVisible="False"
                               AutomationProperties.Name="{TemplateBinding HomeText}" ToolTip.Tip="{TemplateBinding HomeText}">
                <md:MdIconButton.Icon>
                  <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource Md.FileSystemPicker.HomeGeometry}"
                            Fill="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                    </Canvas>
                  </Viewbox>
                </md:MdIconButton.Icon>
              </md:MdIconButton>
              <md:MdIconButton x:Name="PART_RefreshButton" Grid.Column="3"
                               AutomationProperties.Name="{TemplateBinding RefreshText}" ToolTip.Tip="{TemplateBinding RefreshText}">
                <md:MdIconButton.Icon>
                  <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource Md.FileSystemPicker.RefreshGeometry}"
                            Stroke="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                            StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </md:MdIconButton.Icon>
              </md:MdIconButton>
              <md:MdIconButton x:Name="PART_PathToggleButton" Grid.Column="4"
                               AutomationProperties.Name="{TemplateBinding EditPathText}" ToolTip.Tip="{TemplateBinding EditPathText}">
                <md:MdIconButton.Icon>
                  <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource Md.FileSystemPicker.EditGeometry}"
                            Stroke="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                            StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </md:MdIconButton.Icon>
              </md:MdIconButton>
            </Grid>

            <!-- Breadcrumbs are the calm default. The full path editor appears only on demand. -->
            <Border Grid.Row="1" MinHeight="{DynamicResource Md.Comp.FileSystemPicker.Path.MinHeight}" Padding="6,4"
                    Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                    CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Path.Shape}">
              <Grid>
                <ScrollViewer x:Name="PART_BreadcrumbScroller"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="PART_BreadcrumbHost" ItemsSource="{TemplateBinding PathSegments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="md:MdFileSystemPathSegment">
                        <Button x:Name="PART_PathSegmentButton"
                                Theme="{StaticResource MdFileSystemBreadcrumbButtonTheme}"
                                Classes="breadcrumb-segment"
                                Classes.first="{Binding IsFirst}"
                                Classes.current="{Binding IsCurrent}"
                                Tag="{Binding}">
                          <Grid>
                            <StackPanel Classes="standard-segment" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Label}"
                                         Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                              <TextBlock Margin="0,0,2,0" VerticalAlignment="Center" Text="›"
                                         IsVisible="{Binding IsCurrent, Converter={x:Static BoolConverters.Not}}"
                                         Foreground="{DynamicResource Md.Sys.Color.Outline.Brush}" />
                            </StackPanel>

                            <!-- Complementary 14-DIP notch/body/point pieces match MdBreadcrumb's
                                 Powerline geometry. The button containers overlap by the notch
                                 depth, so no default button minimum width can open a seam. -->
                            <Grid Classes="powerline-segment" Height="32" IsVisible="False"
                                  ColumnDefinitions="14,Auto,14">
                              <Path Grid.Column="0" Stretch="Fill" Stroke="{x:Null}"
                                    Data="M 0,0 L 1,0 L 1,1 L 0,1 L 1,0.5 Z"
                                    Fill="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"
                                    IsVisible="{Binding IsFirst, Converter={x:Static BoolConverters.Not}}" />
                              <Path Grid.Column="0" Stretch="Fill" Stroke="{x:Null}"
                                    Data="M 0,0 L 1,0 L 1,1 L 0,1 Z"
                                    Fill="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"
                                    IsVisible="{Binding IsFirst}" />
                              <Border Grid.Column="1" Padding="4,5,8,5"
                                      Background="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"
                                      IsVisible="{Binding IsCurrent, Converter={x:Static BoolConverters.Not}}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}"
                                           Foreground="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                              </Border>
                              <Border Grid.Column="1" Padding="4,5,8,5"
                                      Background="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}"
                                      IsVisible="{Binding IsCurrent}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}"
                                           Foreground="{DynamicResource Md.Sys.Color.OnPrimaryContainer.Brush}" FontWeight="SemiBold" />
                              </Border>
                              <Path Grid.Column="2" Stretch="Fill" Stroke="{x:Null}"
                                    Data="M 0,0 L 1,0.5 L 0,1 Z"
                                    Fill="{DynamicResource Md.Sys.Color.SurfaceContainerHighest.Brush}"
                                    IsVisible="{Binding IsCurrent, Converter={x:Static BoolConverters.Not}}" />
                              <Path Grid.Column="2" Stretch="Fill" Stroke="{x:Null}"
                                    Data="M 0,0 L 1,0.5 L 0,1 Z"
                                    Fill="{DynamicResource Md.Sys.Color.PrimaryContainer.Brush}"
                                    IsVisible="{Binding IsCurrent}" />
                            </Grid>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <md:MdTextBox x:Name="PART_PathBox" Margin="2" MinWidth="0" IsVisible="False"
                              Label="{TemplateBinding PathLabel}" Text="{TemplateBinding CurrentDirectory}"
                              Variant="Outlined" ShowClearButton="False"
                              AutomationProperties.Name="{TemplateBinding PathLabel}" />
              </Grid>
            </Border>

            <Grid Grid.Row="2" MinHeight="0" ColumnDefinitions="Auto,*"
                  ColumnSpacing="{DynamicResource Md.Comp.FileSystemPicker.Section.Spacing}">
              <Border x:Name="PART_QuickAccess" Grid.Column="0"
                      Width="{DynamicResource Md.Comp.FileSystemPicker.QuickAccess.Width}" Padding="12"
                      Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                      CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.List.Shape}">
                <StackPanel Spacing="6">
                  <TextBlock Margin="10,4,10,8" FontSize="{DynamicResource Md.Sys.TypeScale.LabelMedium.Size}"
                             Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" Text="{TemplateBinding QuickAccessText}" />
                  <md:MdButton x:Name="PART_HomeButton" Content="{TemplateBinding HomeText}" Variant="Text" Size="ExtraSmall"
                               HorizontalContentAlignment="Left" AutomationProperties.Name="{TemplateBinding HomeText}">
                    <md:MdButton.LeadingIcon>
                      <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource Md.FileSystemPicker.HomeGeometry}"
                                Fill="{DynamicResource Md.Sys.Color.Primary.Brush}" />
                        </Canvas>
                      </Viewbox>
                    </md:MdButton.LeadingIcon>
                  </md:MdButton>
                  <md:MdButton x:Name="PART_RootButton" Content="{TemplateBinding RootText}" Variant="Text" Size="ExtraSmall"
                               HorizontalContentAlignment="Left" AutomationProperties.Name="{TemplateBinding RootText}">
                    <md:MdButton.LeadingIcon>
                      <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource Md.FileSystemPicker.StorageGeometry}"
                                Stroke="{DynamicResource Md.Sys.Color.Primary.Brush}"
                                StrokeThickness="1.8" StrokeJoin="Round" />
                        </Canvas>
                      </Viewbox>
                    </md:MdButton.LeadingIcon>
                  </md:MdButton>
                  <Border Margin="0,6,0,2" Height="1"
                          Background="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
                  <Border Padding="12,8" Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}"
                          CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Mode.Shape}">
                    <StackPanel>
                      <TextBlock x:Name="PART_FileModeLabel" FontWeight="Medium" Text="{TemplateBinding FilesText}" />
                      <TextBlock x:Name="PART_FolderModeLabel" FontWeight="Medium" Text="{TemplateBinding FoldersText}" IsVisible="False" />
                      <TextBlock FontSize="{DynamicResource Md.Sys.TypeScale.BodySmall.Size}"
                                 Foreground="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}"
                                 Text="{TemplateBinding SelectionModeText}" />
                    </StackPanel>
                  </Border>
                  <md:MdCheckBox Margin="2,4,0,0" Content="{TemplateBinding ShowHiddenText}"
                                 IsChecked="{TemplateBinding ShowHiddenItems, Mode=TwoWay}" />
                </StackPanel>
              </Border>

              <Border x:Name="PART_FileListSurface" Grid.Column="1" MinHeight="0" Padding="8"
                      Background="{DynamicResource Md.Sys.Color.SurfaceContainerLowest.Brush}"
                      CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.List.Shape}"
                      ClipToBounds="True">
                <Grid MinHeight="0">
                  <md:MdList x:Name="PART_ItemsHost" MinHeight="0" ItemSpacing="6"
                             ItemsSource="{TemplateBinding Entries}"
                             ItemContainerTheme="{StaticResource MdFileSystemPickerItemTheme}"
                             AutomationProperties.Name="{TemplateBinding EntriesText}">
                    <md:MdList.ItemTemplate>
                      <DataTemplate x:DataType="md:MdFileSystemEntry">
                        <Grid MinHeight="{DynamicResource Md.Comp.FileSystemPicker.Item.ContentMinHeight}"
                              ColumnDefinitions="Auto,*,48" ColumnSpacing="14" Background="Transparent">
                          <Border Width="{DynamicResource Md.Comp.FileSystemPicker.Icon.ContainerSize}"
                                  Height="{DynamicResource Md.Comp.FileSystemPicker.Icon.ContainerSize}"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}"
                                  CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Icon.Shape}">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Stretch="Uniform">
                              <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Md.FileSystemPicker.FolderGeometry}"
                                      Fill="{DynamicResource Md.Sys.Color.Primary.Brush}"
                                      IsVisible="{Binding IsDirectory}" />
                                <Path Data="{StaticResource Md.FileSystemPicker.FileGeometry}"
                                      Stroke="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}"
                                      StrokeThickness="1.7" StrokeJoin="Round"
                                      IsVisible="{Binding IsDirectory, Converter={x:Static BoolConverters.Not}}" />
                              </Canvas>
                            </Viewbox>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Md.Sys.TypeScale.BodyLarge.Size}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
                            <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Md.Sys.TypeScale.BodySmall.Size}"
                                       Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                          </StackPanel>
                          <Grid Grid.Column="2" Width="48" Height="48" VerticalAlignment="Center">
                            <md:MdIconButton x:Name="PART_OpenEntryButton"
                                             Tag="{Binding}" IsVisible="{Binding IsDirectory}"
                                             Size="ExtraSmall"
                                             AutomationProperties.Name="{Binding OpenFolderText, RelativeSource={RelativeSource AncestorType=md:MdFileSystemPicker}}">
                              <md:MdIconButton.Icon>
                                <Viewbox Width="20" Height="20" Stretch="Uniform">
                                  <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Md.FileSystemPicker.ChevronGeometry}"
                                          Stroke="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                  </Canvas>
                                </Viewbox>
                              </md:MdIconButton.Icon>
                            </md:MdIconButton>
                            <Border Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Md.Sys.Color.Primary.Brush}"
                                    CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Selection.Shape}"
                                    IsHitTestVisible="False"
                                    IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                              <Viewbox Width="18" Height="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                  <Path Data="{StaticResource Md.FileSystemPicker.CheckGeometry}"
                                        Stroke="{DynamicResource Md.Sys.Color.OnPrimary.Brush}"
                                        StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                              </Viewbox>
                            </Border>
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </md:MdList.ItemTemplate>
                  </md:MdList>

                  <StackPanel x:Name="PART_EmptyState" Margin="24" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Spacing="8" IsVisible="False">
                    <Border Width="56" Height="56" HorizontalAlignment="Center"
                            Background="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}"
                            CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.State.Shape}">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource Md.FileSystemPicker.FolderGeometry}"
                                Fill="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <TextBlock MaxWidth="320" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{TemplateBinding EmptyText}"
                               Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                  </StackPanel>

                  <StackPanel x:Name="PART_LoadingState" Margin="24" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Spacing="12" IsVisible="False">
                    <md:MdCircularProgressIndicator Width="40" Height="40" IsIndeterminate="True" />
                    <TextBlock HorizontalAlignment="Center" Text="{TemplateBinding LoadingText}"
                               Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                  </StackPanel>

                  <StackPanel x:Name="PART_ErrorState" Margin="24" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Spacing="8" IsVisible="False">
                    <Border Width="52" Height="52" HorizontalAlignment="Center"
                            Background="{DynamicResource Md.Sys.Color.ErrorContainer.Brush}"
                            CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.State.Shape}">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontSize="{DynamicResource Md.Sys.TypeScale.HeadlineSmall.Size}" Text="!"
                                 Foreground="{DynamicResource Md.Sys.Color.OnErrorContainer.Brush}" />
                    </Border>
                    <TextBlock MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{TemplateBinding ErrorMessage}"
                               Foreground="{DynamicResource Md.Sys.Color.OnErrorContainer.Brush}" />
                    <TextBlock MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Text="{TemplateBinding ErrorHintText}"
                               Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="3" Padding="12,8"
                    Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                    CornerRadius="{DynamicResource Md.Comp.FileSystemPicker.Footer.Shape}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock VerticalAlignment="Center" Text="{TemplateBinding SelectionSummary}"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
                  <md:MdCheckBox x:Name="PART_CompactOptions" Content="{TemplateBinding ShowHiddenText}" IsVisible="False"
                                 IsChecked="{TemplateBinding ShowHiddenItems, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                  <md:MdButton x:Name="PART_CancelButton" Content="{TemplateBinding CancelText}"
                               Variant="Text" Size="ExtraSmall" />
                  <md:MdButton x:Name="PART_ConfirmButton" Content="{TemplateBinding ConfirmText}"
                               Variant="Filled" Size="ExtraSmall" IsEnabled="{TemplateBinding CanConfirm}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:powerline-breadcrumb /template/ Button.breadcrumb-segment"><Setter Property="Margin" Value="-14,0,0,0" /></Style>
    <Style Selector="^:powerline-breadcrumb /template/ Button.breadcrumb-segment.first"><Setter Property="Margin" Value="0" /></Style>
    <Style Selector="^:editing-path /template/ ScrollViewer#PART_BreadcrumbScroller"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:editing-path /template/ md|MdTextBox#PART_PathBox"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:folder-mode /template/ TextBlock#PART_FileModeLabel"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:folder-mode /template/ TextBlock#PART_FolderModeLabel"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:loading /template/ md|MdList#PART_ItemsHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:loading /template/ StackPanel#PART_LoadingState"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:empty /template/ md|MdList#PART_ItemsHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:empty /template/ StackPanel#PART_EmptyState"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:error /template/ md|MdList#PART_ItemsHost"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:error /template/ StackPanel#PART_ErrorState"><Setter Property="IsVisible" Value="True" /></Style>

    <Style Selector="^:compact /template/ Border#PART_Container">
      <Setter Property="Padding" Value="{DynamicResource Md.Comp.FileSystemPicker.Compact.Content.Padding}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^:compact /template/ Border#PART_QuickAccess"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:compact /template/ Border#PART_FileListSurface">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource Md.Comp.FileSystemPicker.Compact.List.Shape}" />
    </Style>
    <Style Selector="^:compact /template/ md|MdIconButton#PART_CompactHomeButton"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:compact /template/ md|MdCheckBox#PART_CompactOptions"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:compact /template/ TextBlock#PART_Title">
      <Setter Property="FontSize" Value="{DynamicResource Md.Sys.TypeScale.TitleMedium.Size}" />
      <Setter Property="LineHeight" Value="{DynamicResource Md.Sys.TypeScale.TitleMedium.LineHeight}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
