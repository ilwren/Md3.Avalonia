<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="MdTabsGeneratedItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="PART_Root" Background="Transparent" ClipToBounds="True">
          <Grid RowDefinitions="*,3">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" />
            <Border x:Name="PART_Indicator" Grid.Row="1" Width="24" Height="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="3,3,0,0" />
            <Border x:Name="PART_StateLayer" Grid.RowSpan="2" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsHitTestVisible="False" Opacity="0" />
            <md:MdRipplePresenter Grid.RowSpan="2" RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdTabItem}" TargetType="md:MdTabItem">
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdTabItem">
        <Border x:Name="PART_Root" Background="Transparent" ClipToBounds="True">
          <Grid RowDefinitions="*,3">
            <StackPanel x:Name="PART_ContentLayout" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Spacing="4">
              <Grid HorizontalAlignment="Center">
                <md:MdSymbolPresenter x:Name="PART_Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Icon}" FontSize="24" Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter x:Name="PART_Badge" Margin="24,-7,-14,0" HorizontalAlignment="Center" VerticalAlignment="Top" Content="{TemplateBinding Badge}" IsVisible="False" />
              </Grid>
              <ContentPresenter x:Name="PART_Label" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontSize="14" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
            <Border x:Name="PART_PrimaryIndicator" Grid.Row="1" Width="24" Height="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="3,3,0,0" />
            <Border x:Name="PART_SecondaryIndicator" Grid.Row="1" Height="2" Margin="16,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="Transparent" IsVisible="False" />
            <Border x:Name="PART_StateLayer" Grid.RowSpan="2" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsHitTestVisible="False" Opacity="0" />
            <md:MdRipplePresenter Grid.RowSpan="2" RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:not(:has-icon)"><Setter Property="MinHeight" Value="48" /></Style>
    <Style Selector="^:inline"><Setter Property="MinHeight" Value="48" /></Style>
    <Style Selector="^:inline /template/ StackPanel#PART_ContentLayout"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="8" /></Style>
    <Style Selector="^:not(:has-icon) /template/ md|MdSymbolPresenter#PART_Icon"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:has-badge /template/ ContentPresenter#PART_Badge"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:secondary /template/ Border#PART_PrimaryIndicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:secondary /template/ Border#PART_SecondaryIndicator"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:shared-indicator /template/ Border#PART_PrimaryIndicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:shared-indicator /template/ Border#PART_SecondaryIndicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:selected:secondary"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurface.Brush}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_PrimaryIndicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_SecondaryIndicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Primary.Brush}" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.38" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdTabs}" TargetType="md:MdTabs">
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdTabs">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
          <Grid>
            <ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
            <Border x:Name="PART_SelectionIndicator" Width="24" Height="3"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="{DynamicResource Md.Sys.Color.Primary.Brush}"
                    CornerRadius="3,3,0,0" IsHitTestVisible="False" IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:scrollable"><Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter></Style>
    <Style Selector="^:scrollable /template/ ScrollViewer#PART_ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Auto" /></Style>
  </ControlTheme>
</ResourceDictionary>
