<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MdDecision: Material has no first-party file browser component. These component tokens
       compose its dialog, text-field, list, and touch-target guidance into a responsive browser. -->
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.Container.Shape">28</CornerRadius>
  <CornerRadius x:Key="Md.Comp.FileSystemPicker.List.Shape">16</CornerRadius>
  <Thickness x:Key="Md.Comp.FileSystemPicker.Content.Padding">24</Thickness>
  <Thickness x:Key="Md.Comp.FileSystemPicker.Compact.Content.Padding">16</Thickness>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Item.MinHeight">56</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Icon.Size">24</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Toolbar.Spacing">8</x:Double>
  <x:Double x:Key="Md.Comp.FileSystemPicker.Section.Spacing">12</x:Double>
</ResourceDictionary>
