      <StreamGeometry x:Key="Md.Comp.AvaloniaEdit.Icon.FindNext">M480 824 232 576l15-14 223 223V328h20v457l223-223 15 14-248 248Z</StreamGeometry>
      <StreamGeometry x:Key="Md.Comp.AvaloniaEdit.Icon.Close">m291 780-15-15 189-189-189-189 15-15 189 189 189-189 15 15-189 189 189 189-15 15-189-189-189 189Z</StreamGeometry>
