<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:Md3.Avalonia.Controls">

    <x:Double x:Key="Md.Comp.ContributionGrid.Cell.Size">12</x:Double>
    <x:Double x:Key="Md.Comp.ContributionGrid.Cell.Spacing">3</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.0"
                             Color="{DynamicResource Md.Sys.Color.SurfaceContainerHighest}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.1"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.35" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.2"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.55" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.3"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.75" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.4"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
            <!-- Two-tone selection remains visible over both the empty surface cell and every
                 primary-toned activity level. -->
            <SolidColorBrush x:Key="Md.ContributionGrid.Selection.Outer.Brush"
                             Color="{DynamicResource Md.Sys.Color.Surface}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Selection.Inner.Brush"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.0"
                             Color="{DynamicResource Md.Sys.Color.SurfaceContainerHighest}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.1"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.4" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.2"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.6" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.3"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.8" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.4"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Selection.Outer.Brush"
                             Color="{DynamicResource Md.Sys.Color.Surface}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Selection.Inner.Brush"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTheme x:Key="{x:Type md:MdContributionGrid}" TargetType="md:MdContributionGrid">
        <Setter Property="CellSize" Value="{DynamicResource Md.Comp.ContributionGrid.Cell.Size}" />
        <Setter Property="CellSpacing" Value="{DynamicResource Md.Comp.ContributionGrid.Cell.Spacing}" />
        <!-- Month and weekday labels inherit this; the theme token keeps them in step with
             runtime theme switches. -->
        <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="md:MdContributionGrid">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="20,*,Auto">
                    <!-- Weekday labels (Mon / Wed / Fri) aligned to rows 1 / 3 / 5. -->
                    <Canvas x:Name="PART_DayLabels"
                            Grid.Row="1" Grid.Column="0"
                            IsHitTestVisible="False" />

                    <!-- Month labels, one per month the data crosses. -->
                    <Canvas x:Name="PART_MonthLabels"
                            Grid.Row="0" Grid.Column="1"
                            IsHitTestVisible="False" />

                    <!-- The day cells themselves. -->
                    <md:ContributionCellsHost x:Name="PART_Cells"
                                              Grid.Row="1" Grid.Column="1" />

                    <!-- Level legend: Less - 0 - 1 - 2 - 3 - 4 - More. XAML (not code) so the
                         swatch backgrounds are DynamicResource bindings that follow the theme. -->
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="0,6,0,0"
                                IsHitTestVisible="False">
                        <TextBlock Text="{TemplateBinding LessLabel}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Md.ContributionGrid.Level.Brush.0}" />
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Md.ContributionGrid.Level.Brush.1}" />
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Md.ContributionGrid.Level.Brush.2}" />
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Md.ContributionGrid.Level.Brush.3}" />
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Md.ContributionGrid.Level.Brush.4}" />
                        <TextBlock Text="{TemplateBinding MoreLabel}"
                                   FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
