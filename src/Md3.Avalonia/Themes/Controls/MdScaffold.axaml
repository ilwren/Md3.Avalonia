<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="{x:Type md:MdScaffold}" TargetType="md:MdScaffold">
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.Surface.Brush}" /><Setter Property="Template"><ControlTemplate TargetType="md:MdScaffold"><Border Background="{TemplateBinding Background}"><Grid RowDefinitions="Auto,*,Auto"><ContentPresenter Grid.Row="0" Content="{TemplateBinding TopBar}" /><Grid Grid.Row="1" ColumnDefinitions="Auto,*"><ContentPresenter Content="{TemplateBinding Navigation}" /><ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></Grid><ContentPresenter Grid.Row="2" Content="{TemplateBinding BottomBar}" /><ContentPresenter Grid.Row="1" Margin="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{TemplateBinding FloatingActionButton}" /><ContentPresenter Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="{TemplateBinding Snackbar}" /><ContentPresenter Grid.RowSpan="3" Content="{TemplateBinding Overlay}" /></Grid></Border></ControlTemplate></Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdNavigationSuite}" TargetType="md:MdNavigationSuite">
    <Setter Property="Template"><ControlTemplate TargetType="md:MdNavigationSuite"><Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*"><ContentPresenter x:Name="PART_Drawer" Content="{TemplateBinding NavigationDrawer}" IsVisible="False" /><ContentPresenter x:Name="PART_Rail" Content="{TemplateBinding NavigationRail}" IsVisible="False" /><ContentPresenter x:Name="PART_Content" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /><ContentPresenter x:Name="PART_Bar" Grid.Row="1" Grid.ColumnSpan="2" Content="{TemplateBinding NavigationBar}" IsVisible="False" /></Grid></ControlTemplate></Setter>
    <Style Selector="^:bar /template/ ContentPresenter#PART_Bar"><Setter Property="IsVisible" Value="True" /></Style><Style Selector="^:bar /template/ ContentPresenter#PART_Content"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
    <Style Selector="^:rail /template/ ContentPresenter#PART_Rail"><Setter Property="IsVisible" Value="True" /></Style><Style Selector="^:drawer /template/ ContentPresenter#PART_Drawer"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>
</ResourceDictionary>
