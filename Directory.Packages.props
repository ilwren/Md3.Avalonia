<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 11.3.13 is the lowest common baseline: DataGrid 11.3.13 requires
         Avalonia >= 11.3.13, while every other retained integration declares a lower floor. -->
    <PackageVersion Include="Avalonia" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Android" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.13" />

    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageVersion Include="AvaloniaHex" Version="0.1.12" />
    <PackageVersion Include="Dock.Avalonia" Version="11.3.12.1" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="11.3.12.1" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="11.3.12.1" />
    <PackageVersion Include="Tabalonia" Version="0.10.7" />
    <PackageVersion Include="Markdown.Avalonia.Tight" Version="11.0.3" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.5" />
    <PackageVersion Include="ScottPlot.Avalonia" Version="5.0.56" />
    <PackageVersion Include="bodong.Avalonia.PropertyGrid" Version="11.3.11.1" />
    <PackageVersion Include="NodifyM.Avalonia" Version="1.1.9" />
    <PackageVersion Include="Mapsui.Avalonia" Version="5.0.2" />
    <PackageVersion Include="DotNetCampus.AvaloniaInkCanvas" Version="1.0.1" />

    <!-- ScottPlot 5.0.56 depends on the fontconfig-less Linux native asset. The runnable
         heads exclude that asset so Avalonia.Skia's fontconfig-enabled build remains the
         only libSkiaSharp in their output. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />

    <PackageVersion Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Avalonia.Headless.XUnit 11.x references xunit.core (xUnit v2). Keeping the whole
         test harness on v2 avoids compiling both v2 and v3 FactAttribute definitions. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
