<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.SwitchGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28">
      <StackPanel Spacing="8"><TextBlock Classes="h1" Text="Switch"/><TextBlock Classes="body" Text="Switches immediately toggle a single setting on or off."/></StackPanel>
      <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" Spacing="8">
        <md:MdSwitch Content="Wi-Fi" IsChecked="True"/><md:MdDivider/>
        <md:MdSwitch Content="Bluetooth"/><md:MdDivider/>
        <md:MdSwitch Content="Show status icons" ShowIcons="True" IsChecked="True"/><md:MdDivider/>
        <md:MdSwitch Content="Disabled setting" IsEnabled="False"/>
      </StackPanel>
      <Border MaxWidth="520" HorizontalAlignment="Stretch" Padding="20" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}" CornerRadius="20"></Border>
        <gallery:ApiNotes Control="MdSwitch"
                        Members="ShowIcons, IsChecked, Command">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="MdSwitch is a ToggleButton, so IsChecked, Command, keyboard input, focus and automation all come from Avalonia; the control adds only ShowIcons, which decides whether the On and Off glyphs sit inside the track. Everything visual comes from the switch theme, which is why six states need no sixth property." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
      <StackPanel Spacing="10"><TextBlock Classes="h2" Text="Usage"/><gallery:CodeExample XamlCode="&lt;md:MdSwitch Content=&quot;Wi-Fi&quot;&#10;             IsChecked=&quot;{Binding IsWifiEnabled}&quot;&#10;             Command=&quot;{Binding ToggleWifiCommand}&quot; /&gt;" CSharpCode="var toggle = new MdSwitch { Content = &quot;Wi-Fi&quot;, IsChecked = true };&#10;toggle.IsCheckedChanged += (_, _) =&gt; Save(toggle.IsChecked);"/></StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
