<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.PickerRestorationGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Restorable picker state" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A provider-agnostic store keeps picker values across a teardown, so a process death or a navigation away can be recovered from." />
      </StackPanel>

      <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12"><md:MdDatePicker x:Name="RestorableDate" Width="280" SelectedDate="2026-09-24" /><md:MdTimePicker x:Name="RestorableTime" Width="280" SelectedTime="10:15" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8"><md:MdButton Content="Save state" Variant="Outlined" Click="SavePickerState" /><md:MdButton Content="Clear values" Variant="Text" Click="ClearPickerValues" /><md:MdButton Content="Restore state" Variant="Text" Click="RestorePickerState" /></StackPanel>
        <TextBlock x:Name="RestorationStatus" Classes="body" Text="State is held by a provider-agnostic store." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample CSharpCode="var store = new MdPickerRestorationStore();&#10;store.SaveDate(&quot;checkout.date&quot;, DatePicker.SelectedDate);&#10;DatePicker.SelectedDate = store.RestoreDate(&quot;checkout.date&quot;);" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
