<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:Md3.Avalonia.Controls">

    <x:Double x:Key="Md.Comp.ContributionGrid.Cell.Size">12</x:Double>
    <x:Double x:Key="Md.Comp.ContributionGrid.Cell.Spacing">3</x:Double>

    <ResourceDictionary.Resources>
        <Style Selector="md|MdContributionGrid TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
    </ResourceDictionary.Resources>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.0"
                             Color="{DynamicResource Md.Sys.Color.SurfaceContainerHighest}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.1"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.35" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.2"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.55" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.3"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.75" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.4"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.0"
                             Color="{DynamicResource Md.Sys.Color.SurfaceContainerHighest}" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.1"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.4" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.2"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.6" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.3"
                             Color="{DynamicResource Md.Sys.Color.Primary}" Opacity="0.8" />
            <SolidColorBrush x:Key="Md.ContributionGrid.Level.Brush.4"
                             Color="{DynamicResource Md.Sys.Color.Primary}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTheme x:Key="{x:Type md:MdContributionGrid}" TargetType="md:MdContributionGrid">
        <Setter Property="CellSize" Value="{DynamicResource Md.Comp.ContributionGrid.Cell.Size}" />
        <Setter Property="CellSpacing" Value="{DynamicResource Md.Comp.ContributionGrid.Cell.Spacing}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="md:MdContributionGrid">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="20,*,Auto">
                    <!-- Weekday labels (Mon / Wed / Fri) aligned to rows 1 / 3 / 5. -->
                    <Canvas x:Name="PART_DayLabels"
                            Grid.Row="1" Grid.Column="0"
                            IsHitTestVisible="False" />

                    <!-- Month labels, one per month the data crosses. -->
                    <Canvas x:Name="PART_MonthLabels"
                            Grid.Row="0" Grid.Column="1"
                            IsHitTestVisible="False" />

                    <!-- The day cells themselves. -->
                    <md:ContributionCellsHost x:Name="PART_Cells"
                                              Grid.Row="1" Grid.Column="1" />

                    <!-- Level legend: Less - 0 - 1 - 2 - 3 - 4 - More. -->
                    <StackPanel x:Name="PART_Legend"
                                Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,6,0,0"
                                IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
