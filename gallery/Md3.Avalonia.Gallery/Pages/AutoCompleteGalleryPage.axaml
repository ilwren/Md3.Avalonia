<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.AutoCompleteGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Autocomplete" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A text field that filters a list as you type. Filtering and keyboard selection are the native Avalonia behaviours; only the Material presentation is added." />
      </StackPanel>

      <StackPanel Spacing="12">
        <md:MdAutoCompleteBox x:Name="TechnologyAutoComplete" Width="320" HorizontalAlignment="Left"
                              Label="Technology" PlaceholderText="Start typing"
                              SupportingText="Native filtering and keyboard selection"
                              FilterMode="ContainsOrdinal" IsTextCompletionEnabled="True" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdAutoCompleteBox Label=&quot;City&quot; ItemsSource=&quot;{Binding Cities}&quot;&#10;                      FilterMode=&quot;ContainsOrdinal&quot; IsTextCompletionEnabled=&quot;True&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
