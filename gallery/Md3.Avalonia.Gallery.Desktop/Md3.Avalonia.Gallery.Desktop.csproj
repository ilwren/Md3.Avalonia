<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Select the Windows-specific notifications asset for Windows builds; retain the portable
         target on macOS/Linux so their native backends remain available. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Md3.Avalonia.Gallery.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Directly select the patched backport instead of Avalonia.FreeDesktop 11.3.13's
         vulnerable 0.21.2 lower bound (GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <!-- The published Linux gallery hits the same trap as the headless suite: ScottPlot 5.0.56
         brings SkiaSharp.NativeAssets.Linux.NoDependencies, a libSkiaSharp without fontconfig,
         and it overwrites the fontconfig build Avalonia.Skia needs at
         runtimes/linux-x64/native/libSkiaSharp.so. Without fontconfig the gallery cannot
         enumerate system fonts, so the markdown and hex editor pages fail on their Consolas
         fallback. Excluding its assets leaves Avalonia's build in place. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" ExcludeAssets="all" />
    <ProjectReference Include="../Md3.Avalonia.Gallery/Md3.Avalonia.Gallery.csproj" />
  </ItemGroup>
</Project>
