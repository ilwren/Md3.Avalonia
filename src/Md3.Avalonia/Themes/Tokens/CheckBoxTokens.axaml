<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- M3 CheckboxTokens 14_1_0, frozen through spec-snapshot/manifest.json. -->
  <x:Double x:Key="Md.Comp.CheckBox.Target.Size">48</x:Double>
  <x:Double x:Key="Md.Comp.CheckBox.StateLayer.Size">40</x:Double>
  <CornerRadius x:Key="Md.Comp.CheckBox.StateLayer.Shape">20</CornerRadius>

  <x:Double x:Key="Md.Comp.CheckBox.Container.Size">18</x:Double>
  <CornerRadius x:Key="Md.Comp.CheckBox.Container.Shape">2</CornerRadius>
  <Thickness x:Key="Md.Comp.CheckBox.Container.OutlineWidth">2</Thickness>
  <x:Double x:Key="Md.Comp.CheckBox.Icon.Size">18</x:Double>

  <Thickness x:Key="Md.Comp.CheckBox.Label.Margin">8,0,0,0</Thickness>
  <x:Double x:Key="Md.Comp.CheckBox.Label.FontSize">14</x:Double>

  <x:Double x:Key="Md.Comp.CheckBox.StateLayer.HoverOpacity">0.08</x:Double>
  <x:Double x:Key="Md.Comp.CheckBox.StateLayer.FocusOpacity">0.10</x:Double>
  <x:Double x:Key="Md.Comp.CheckBox.StateLayer.PressedOpacity">0.10</x:Double>
</ResourceDictionary>
