<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.HoverCardGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Hover card" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A hover card opens after a deliberate delay on hover or focus. Move from the anchor into the card: it should stay open while either side is attended." />
      </StackPanel>

      <StackPanel Spacing="12">
        <eco:MdHoverCard Anchor="Hover or focus" HorizontalAlignment="Left"
                         Opened="HoverCardOpened" Closed="OverlayClosed">
          <eco:MdHoverCard.PopoverContent>
            <StackPanel Width="240" Spacing="8">
              <TextBlock FontWeight="Medium" Text="Profile preview" />
              <TextBlock TextWrapping="Wrap" Text="Move the pointer between the anchor and this card. The card remains available until you leave both." />
              <md:MdButton Content="Open profile" Variant="Text" HorizontalAlignment="Left" />
            </StackPanel>
          </eco:MdHoverCard.PopoverContent>
        </eco:MdHoverCard>
        <TextBlock x:Name="OverlayStatus" Classes="body" TextWrapping="Wrap" Text="Hover or focus the anchor, then move into the card before leaving the whole surface." />
      </StackPanel>

      <StackPanel Spacing="10">
        <gallery:ApiNotes Control="MdHoverCard"
                        Members="Anchor, PopoverContent, IsOpen, Placement, OpenDelay, CloseDelay, DismissOnOutsideClick, DismissOnScroll, RestoreFocusOnClose">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="Anchor is the element it attaches to and PopoverContent is what it shows. OpenDelay is what makes it deliberate rather than a tooltip, and CloseDelay is the grace period that lets the pointer travel from the anchor into the card. DismissOnOutsideClick, DismissOnScroll and RestoreFocusOnClose are the dismissal rules." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdHoverCard Anchor=&quot;Profile&quot; PopoverContent=&quot;{Binding Summary}&quot; Opened=&quot;OnOpened&quot; Closed=&quot;OnClosed&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
