<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             x:Class="Md3.Avalonia.Gallery.AndroidGalleryView"
             Background="{DynamicResource Md.Sys.Color.Surface.Brush}">
  <!-- Android uses a single-view lifetime, so it needs its own compact shell. Keep the complete
       Gallery index in a modal, scrollable drawer instead of limiting mobile to four sample pages. -->
  <md:MdNavigationDrawer x:Name="MobileDrawer"
                         IsModal="True"
                         IsOpen="False"
                         DrawerWidth="320">
    <md:MdNavigationDrawer.DrawerContent>
      <Border Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}">
        <Grid RowDefinitions="72,*">
          <Grid Margin="12,8" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="Material 3 Gallery" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                         Text="All samples and components" />
            </StackPanel>
            <md:MdIconButton Grid.Column="1"
                             Icon="{x:Static md:MdSymbols.Close}"
                             AutomationProperties.Name="Close navigation"
                             Click="CloseNavigation" />
          </Grid>
          <md:MdScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MobileNavigationItems" Margin="12,4,12,28" Spacing="4" />
          </md:MdScrollViewer>
        </Grid>
      </Border>
    </md:MdNavigationDrawer.DrawerContent>

    <Grid RowDefinitions="64,*,72">
      <md:MdTopAppBar x:Name="MobileAppBar" Grid.Row="0" Title="Material 3 · Avalonia" Variant="Small">
        <md:MdTopAppBar.LeadingContent>
          <md:MdIconButton Icon="{x:Static md:MdSymbols.Menu}"
                           AutomationProperties.Name="Open complete Gallery navigation"
                           Click="OpenNavigation" />
        </md:MdTopAppBar.LeadingContent>
      </md:MdTopAppBar>

      <ContentControl x:Name="MobilePageHost"
                      Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,14,16,24" Spacing="20">
            <StackPanel Spacing="4">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Material 3 Components"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                         Text="Use the menu to open every Gallery page on Android."/>
            </StackPanel>
            <WrapPanel>
              <md:MdButton Content="Filled" Margin="0,0,8,8"/>
              <md:MdButton Content="Tonal" Variant="Tonal" Margin="0,0,8,8"/>
              <md:MdButton Content="Outlined" Variant="Outlined" Margin="0,0,8,8"/>
              <md:MdIconButton Icon="{x:Static md:MdSymbols.Favorite}" Margin="0,0,8,8"
                               AutomationProperties.Name="Favorite" />
            </WrapPanel>
            <md:MdTextBox Label="Outlined text field" Text="Avalonia on Android" ShowClearButton="True"/>
            <md:MdSearchBar PlaceholderText="Search components"/>
            <StackPanel Spacing="4">
              <md:MdSwitch Content="Dynamic color" IsChecked="True"/>
              <md:MdCheckBox Content="Touch target and state layer" IsChecked="True"/>
            </StackPanel>
            <md:MdCard Padding="16">
              <StackPanel Spacing="8">
                <TextBlock FontSize="18" FontWeight="Medium" Text="M3 Elevation &amp; Progress"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}"
                           Text="High performance cross-platform rendering."/>
                <md:MdLinearProgressIndicator Value="72"/>
              </StackPanel>
            </md:MdCard>
            <WrapPanel>
              <md:MdAssistChip Content="Assist" Margin="0,0,8,8"/>
              <md:MdFilterChip Content="Filter" IsChecked="True" Margin="0,0,8,8"/>
              <md:MdInputChip Content="Input" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>
        </md:MdScrollViewer>
      </ContentControl>

      <md:MdNavigationBar x:Name="MobileNavigation"
                          Grid.Row="2"
                          SelectedIndex="0"
                          SelectionChanged="MobileNavigationChanged">
        <md:MdNavigationBarItem Label="Home" Icon="{x:Static md:MdSymbols.Home}"/>
        <md:MdNavigationBarItem Label="Color" Icon="{x:Static md:MdSymbols.Palette}"/>
        <md:MdNavigationBarItem Label="Motion" Icon="{x:Static md:MdSymbols.Settings}"/>
        <md:MdNavigationBarItem Label="Theme" Icon="{x:Static md:MdSymbols.Info}"/>
      </md:MdNavigationBar>
    </Grid>
  </md:MdNavigationDrawer>
</UserControl>
