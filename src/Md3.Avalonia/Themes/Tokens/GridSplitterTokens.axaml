<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MdDecision: Material has no dedicated grid splitter. These tokens separate a forgiving
       pointer/touch interaction track from the much quieter visible divider and rounded grip. -->
  <x:Double x:Key="Md.Comp.GridSplitter.Track.Thickness">12</x:Double>
  <x:Double x:Key="Md.Comp.GridSplitter.Divider.Thickness">2</x:Double>
  <x:Double x:Key="Md.Comp.GridSplitter.Handle.Thickness">4</x:Double>
  <x:Double x:Key="Md.Comp.GridSplitter.Handle.Length">32</x:Double>
  <CornerRadius x:Key="Md.Comp.GridSplitter.Divider.Shape">1</CornerRadius>
  <CornerRadius x:Key="Md.Comp.GridSplitter.Handle.Shape">2</CornerRadius>
  <CornerRadius x:Key="Md.Comp.GridSplitter.Focus.Shape">6</CornerRadius>
  <Thickness x:Key="Md.Comp.GridSplitter.Focus.Thickness">2</Thickness>
  <x:Double x:Key="Md.Comp.GridSplitter.Disabled.Opacity">0.38</x:Double>
  <x:Double x:Key="Md.Comp.GridSplitter.Preview.Opacity">0.32</x:Double>
</ResourceDictionary>
