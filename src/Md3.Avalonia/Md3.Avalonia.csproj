<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Md3.Avalonia</RootNamespace>
    <AssemblyName>Md3.Avalonia</AssemblyName>
    <Description>Material Design 3 and Material 3 Expressive controls, dynamic HCT theming, motion, localization and desktop adapters for Avalonia 12.</Description>
    <PackageId>Md3.Avalonia</PackageId>
    <Version>0.5.0-preview.2</Version>
    <Authors>Md3.Avalonia contributors</Authors>
    <PackageTags>avalonia;material-design;material-3;controls;android;desktop;hct;mvvm</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageReleaseNotes>0.5.0-preview.2: Documentation improvements: clarified NuGet publication status and installation guidance; corrected package counts, release dates, target-framework guidance, and release notes; refreshed compatibility and release-validation documentation; added shared GitHub repository metadata to all packages. Full notes: https://github.com/ilwren/Md3.Avalonia/blob/main/docs/RELEASE_NOTES_0.5.0-preview.2.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <!-- Declares the assembly safe to trim and turns the IL2xxx analyzer on, so a new
         reflective call fails the build instead of silently breaking a trimmed app. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="MaterialColorUtilities" />
    <!-- Icon-font catalogs and font registration live in the optional Md3.Avalonia.Icons package.
         Core controls expose object icon slots and empty resource keys that any provider can fill. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../assets/logo-128.png" Pack="true" PackagePath="/" Link="logo-128.png" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
