<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             xmlns:rte="using:AvaloniaRichEditor.Controls"
             x:Class="Md3.Avalonia.Gallery.Pages.RichEditorGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Rich editor" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="Two routes to rich text. Md3.Avalonia.RichEditor is an opt-in package that skins the AvaloniaRichEditor control library with Material tokens; MdRichEditor is the engine-free command surface in the core library, which leaves the document to an adapter." />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="AvaloniaRichEditor, themed" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="A real editing engine: inline formatting, tables, images, page view, HTML/JSON/RTF round-trip. The Material theme sets its surface, outline, shape, type scale, selection and caret from the same tokens as the rest of the library and leaves the control's own template alone, so it keeps working across upstream releases." />
        <Border CornerRadius="12" ClipToBounds="True" Padding="16"
                Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1">
          <rte:RichEditor x:Name="ThemedRichEditor" Height="260" />
        </Border>
        <TextBlock Classes="body" Opacity="0.78" TextWrapping="Wrap" Text="Usage: install Md3.Avalonia.RichEditor, then add &lt;themes:MaterialRichEditorTheme /&gt; to Application.Styles after MaterialTheme. The package carries the AvaloniaRichEditor dependency so the core packages do not." />
        <gallery:CodeExample CSharpCode="// Application.axaml&#10;// &lt;themes:MaterialTheme /&gt;&#10;// &lt;themes:MaterialRichEditorTheme /&gt;&#10;&#10;editor.LoadHtml(&quot;&lt;p&gt;Hello &lt;b&gt;world&lt;/b&gt;&lt;/p&gt;&quot;);&#10;string html = editor.ToHtml();" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="MdRichEditor command surface" />
        <TextBlock Classes="body" TextWrapping="Wrap" Text="For hosts that already own an editing engine. This instance uses the bundled TextBox adapter." />
      </StackPanel>

      <StackPanel Spacing="12">
        <eco:MdRichEditor x:Name="RichEditor" MinHeight="220" EditorStateChanged="EditorStateChanged">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <md:MdTextBox x:Name="EditorText" MinHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                          Label="Rich-text source" Variant="Outlined"
                          Text="## Release notes&#10;Select words, then try **Bold**, _Italic_, quote, lists, links, undo, and redo." />
            <Border Grid.Column="1" Padding="16" Background="{DynamicResource Md.Sys.Color.SurfaceContainerLow.Brush}"
                    BorderBrush="{DynamicResource Md.Sys.Color.OutlineVariant.Brush}" BorderThickness="1" CornerRadius="12">
              <StackPanel Spacing="6"><TextBlock FontSize="12" FontWeight="Medium" Opacity=".7" Text="LIVE RICH PREVIEW" /><StackPanel x:Name="RichPreview" /></StackPanel>
            </Border>
          </Grid>
        </eco:MdRichEditor>
        <TextBlock x:Name="EditorStatus" Classes="body" TextWrapping="Wrap" Text="Select source text and choose a command; the rendered preview updates immediately." />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample CSharpCode="var editor = new MdRichEditor { Adapter = myEditorAdapter };   // IMdRichEditorAdapter" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
