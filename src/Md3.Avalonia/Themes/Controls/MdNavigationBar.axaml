<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Md3.Avalonia.Controls">
  <ControlTheme x:Key="MdNavigationBarGeneratedItemTheme" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template"><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="28"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" /></Border></ControlTemplate></Setter>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdNavigationBarItem}" TargetType="md:MdNavigationBarItem">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSurfaceVariant.Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdNavigationBarItem">
        <Border x:Name="PART_Root" Background="Transparent" CornerRadius="16" ClipToBounds="True">
          <Grid>
            <StackPanel x:Name="PART_ItemLayout" Margin="4,6" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
              <Grid Width="56" Height="32" ClipToBounds="True">
                <Border x:Name="PART_Indicator" Background="Transparent" CornerRadius="16"
                        Opacity="0" RenderTransform="scale(0.6)" RenderTransformOrigin="50%,50%" />
                <Border x:Name="PART_StateLayer" Background="{DynamicResource Md.Sys.Color.OnSurface.Brush}" CornerRadius="16" IsHitTestVisible="False" Opacity="0" />
                <md:MdRipplePresenter RippleBrush="{DynamicResource Md.Sys.Color.OnSurface.Brush}" IsCentered="True" />
                <md:MdSymbolPresenter x:Name="PART_Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" FontSize="24" />
                <md:MdSymbolPresenter x:Name="PART_SelectedIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding SelectedIcon}" Foreground="{TemplateBinding Foreground}" FontSize="24" IsVisible="False" Opacity="0" />
                <ContentPresenter x:Name="PART_Badge" Margin="30,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Content="{TemplateBinding Badge}" IsVisible="False" />
              </Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="{TemplateBinding Label}" FontSize="12" Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:has-badge /template/ ContentPresenter#PART_Badge"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource Md.Sys.Color.OnSecondaryContainer.Brush}" /></Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator"><Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SecondaryContainer.Brush}" /><Setter Property="Opacity" Value="1" /><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:has-selected-icon /template/ ContentPresenter#PART_SelectedIcon"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ ContentPresenter#PART_Icon"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:selected:has-selected-icon /template/ ContentPresenter#PART_SelectedIcon"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="^:reduced-motion /template/ Border#PART_Indicator"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.08" /></Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer"><Setter Property="Opacity" Value="0.10" /></Style>
    <Style Selector="^:horizontal"><Setter Property="MinWidth" Value="112" /></Style>
    <Style Selector="^:horizontal /template/ StackPanel#PART_ItemLayout"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="8" /><Setter Property="Margin" Value="8,4" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type md:MdNavigationBar}" TargetType="md:MdNavigationBar">
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource Md.Sys.Color.SurfaceContainer.Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="md:MdNavigationBar">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:baseline"><Setter Property="Height" Value="80" /></Style>
  </ControlTheme>
</ResourceDictionary>
