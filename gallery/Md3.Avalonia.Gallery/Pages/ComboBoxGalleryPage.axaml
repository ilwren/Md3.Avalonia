<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.ComboBoxGalleryPage"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="760">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="26" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Combo box" />
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="Material's exposed dropdown menu on top of Avalonia's own ComboBox selection and keyboard handling." />
      </StackPanel>

      <gallery:ApiNotes Control="MdComboBox" Members="Variant, Label, PlaceholderText, SupportingText, IsError, ErrorText, IsEditable, ItemsSource, SelectedItem">
        <gallery:ApiNotes.Notes>
          <TextBlock Classes="body" TextWrapping="Wrap" Text="Items are ordinary ComboBoxItems, so ItemsSource, SelectedItem and SelectedIndex bind exactly as they do on Avalonia's ComboBox. Alt+Down opens the menu, arrows move the active option, Enter commits and Escape dismisses it." />
        </gallery:ApiNotes.Notes>
      </gallery:ApiNotes>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Filled and outlined" />
        <WrapPanel Orientation="Horizontal">
          <md:MdComboBox Width="300" MaxWidth="320" Label="Framework" PlaceholderText="Choose a framework"
                         SupportingText="Select one option" Margin="0,0,16,16">
            <ComboBoxItem Content="Avalonia" />
            <ComboBoxItem Content="MAUI" />
            <ComboBoxItem Content="WPF" />
            <ComboBoxItem Content="WinUI" />
          </md:MdComboBox>

          <md:MdComboBox Width="300" MaxWidth="320" Label="Platform" Variant="Outlined" SelectedIndex="0" Margin="0,0,16,16">
            <ComboBoxItem Content="Android" />
            <ComboBoxItem Content="Windows" />
            <ComboBoxItem Content="macOS" />
            <ComboBoxItem Content="Linux" />
          </md:MdComboBox>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Leading icon and editable" />
        <WrapPanel Orientation="Horizontal">
          <md:MdComboBox Width="300" MaxWidth="320" Label="Region" SelectedIndex="1" Margin="0,0,16,16">
            <md:MdComboBox.LeadingIcon><TextBlock Text="◎" /></md:MdComboBox.LeadingIcon>
            <ComboBoxItem Content="Americas" />
            <ComboBoxItem Content="Asia Pacific" />
            <ComboBoxItem Content="Europe" />
          </md:MdComboBox>

          <md:MdComboBox Width="300" MaxWidth="320" Label="Search or select" Variant="Outlined"
                         IsEditable="True" PlaceholderText="Start typing" Margin="0,0,16,16">
            <ComboBoxItem Content="Alpha" />
            <ComboBoxItem Content="Beta" />
            <ComboBoxItem Content="Gamma" />
          </md:MdComboBox>
        </WrapPanel>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Error and disabled" />
        <WrapPanel Orientation="Horizontal">
          <md:MdComboBox Width="300" MaxWidth="320" Label="Required option" Variant="Outlined"
                         IsError="True" ErrorText="Choose an option" Margin="0,0,16,16">
            <ComboBoxItem Content="First option" />
            <ComboBoxItem Content="Second option" />
          </md:MdComboBox>

          <md:MdComboBox Width="280" MaxWidth="320" Label="Disabled" SelectedIndex="0" IsEnabled="False" Margin="0,0,16,16">
            <ComboBoxItem Content="Unavailable" />
          </md:MdComboBox>
        </WrapPanel>
      </StackPanel>


      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;md:MdComboBox Label=&quot;Country&quot; ItemsSource=&quot;{Binding Countries}&quot;&#10;                SelectedItem=&quot;{Binding Country}&quot; Variant=&quot;Outlined&quot; /&gt;" CSharpCode="var country = new MdComboBox&#10;{&#10;    Label = &quot;Country&quot;,&#10;    Variant = MdTextBoxVariant.Outlined,&#10;    ItemsSource = viewModel.Countries&#10;};" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
