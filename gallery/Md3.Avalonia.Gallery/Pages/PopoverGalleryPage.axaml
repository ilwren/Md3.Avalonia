<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:Md3.Avalonia.Controls"
             xmlns:eco="using:Md3.Avalonia.Extra.Controls"
             xmlns:infra="using:Md3.Avalonia.Extra.Infrastructure"
             xmlns:gallery="using:Md3.Avalonia.Gallery.Components"
             x:Class="Md3.Avalonia.Gallery.Pages.PopoverGalleryPage">
  <md:MdScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="0,0,12,24">
      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="Popover" />
      </StackPanel>

      <StackPanel Spacing="12">
        <eco:MdPopover Anchor="Toggle popover" HorizontalAlignment="Left"
                       PopoverContent="This transient action closes on page scroll, outside click, Escape, or another popup."
                       Opened="OverlayOpened" Closed="OverlayClosed" />
        <TextBlock x:Name="OverlayStatus" Classes="body" TextWrapping="Wrap" Text="Open the popover, then scroll to verify it dismisses." />
      </StackPanel>

      <StackPanel Spacing="10">
        <gallery:ApiNotes Control="MdPopover"
                        Members="Anchor, PopoverContent, Placement, IsOpen, DismissOnOutsideClick, DismissOnScroll, RestoreFocusOnClose">
          <gallery:ApiNotes.Notes>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="Anchor and PopoverContent set what it hangs off and what it shows; Placement picks the side and flips when there is no room. The dismiss rules are on by default - an outside click, Escape, a scroll with DismissOnScroll, or another popup opening - and RestoreFocusOnClose returns focus to the anchor so a keyboard user is not dropped at the top of the page." />
          </gallery:ApiNotes.Notes>
        </gallery:ApiNotes>
        <TextBlock Classes="h2" Text="Usage" />
        <gallery:CodeExample XamlCode="&lt;eco:MdPopover Anchor=&quot;Options&quot; PopoverContent=&quot;{Binding Details}&quot; Opened=&quot;OnOpened&quot; Closed=&quot;OnClosed&quot; /&gt;" />
      </StackPanel>
    </StackPanel>
  </md:MdScrollViewer>
</UserControl>
